@using AegisErp.Web.Components.Dialogs
@inject PurchaseInvoiceService InvoiceSvc
@inject CompanyService CompanySvc
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar

@if (_loaded && _invoice is null)
{
    <MudAlert Severity="Severity.Error">Invoice not found.</MudAlert>
}
else if (_invoice is not null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3 invoice-print-hide" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h5">@_invoice.InvoiceNo</MudText>
        <MudChip T="string" Size="Size.Small" Color="StatusColor(_status)" Variant="Variant.Text">@_status</MudChip>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" OnClick="Print">PDF/Print</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Payments" OnClick="RecordPayment">Record Payment</MudButton>
        <MudMenu Icon="@Icons.Material.Filled.MoreVert">
            <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy" OnClick="Clone">Clone</MudMenuItem>
            @if (_invoice.JournalVoucher is not null)
            {
                <MudMenuItem Icon="@Icons.Material.Filled.MenuBook" OnClick="ViewJournal">View Journal</MudMenuItem>
            }
            <MudMenuItem Icon="@Icons.Material.Filled.Undo" OnClick="CreateDebitNote">Create Debit Note</MudMenuItem>
        </MudMenu>
    </MudStack>

    @if (_status is ArStatus.Overdue or ArStatus.Pending)
    {
        <MudAlert Severity="@(_status == ArStatus.Overdue ? Severity.Warning : Severity.Info)" Class="mb-3 invoice-print-hide">
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudText>@(_status == ArStatus.Overdue ? "Payment is overdue." : "Payment is not yet due.") Balance due: AED @_balance.ToString("N2").</MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="RecordPayment">Record Payment</MudButton>
            </MudStack>
        </MudAlert>
    }

    <MudPaper Class="pa-6 mb-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2">Bill From</MudText>
                <MudText Typo="Typo.h6">@_invoice.Vendor.Name</MudText>
                @if (!string.IsNullOrWhiteSpace(_invoice.VendorRef))
                {
                    <MudText Typo="Typo.body2">Vendor Ref: @_invoice.VendorRef</MudText>
                }
                @if (!string.IsNullOrWhiteSpace(_invoice.LpoNo))
                {
                    <MudText Typo="Typo.body2">LPO No.: @_invoice.LpoNo</MudText>
                }
                @if (_invoice.CostCenter is not null)
                {
                    <MudText Typo="Typo.body2">Cost Center: @_invoice.CostCenter.Name</MudText>
                }
            </MudItem>
            <MudItem xs="12" sm="6" Class="text-right">
                <MudText Typo="Typo.h4">PURCHASE INVOICE</MudText>
                <MudText Typo="Typo.body1"># @_invoice.InvoiceNo</MudText>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2">Billed To</MudText>
                <MudText Typo="Typo.body1">@_company?.LegalName</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" Class="text-right">
                <MudText Typo="Typo.body2">Invoice Date: @_invoice.Date.ToString("dd MMM yyyy")</MudText>
                <MudText Typo="Typo.body2">Due Date: @_invoice.DueDate.ToString("dd MMM yyyy")</MudText>
                <MudText Typo="Typo.h6" Class="mt-2">Balance Due: AED @_balance.ToString("N2")</MudText>
            </MudItem>
        </MudGrid>

        <MudTable Items="_invoice.Lines.OrderBy(l => l.LineNo)" Dense="true" Bordered="true" Elevation="0" Class="mt-4">
            <HeaderContent>
                <MudTh>#</MudTh>
                <MudTh>Description</MudTh>
                <MudTh Style="text-align:right">Qty</MudTh>
                <MudTh Style="text-align:right">Rate</MudTh>
                <MudTh Style="text-align:right">Amount</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.LineNo</MudTd>
                <MudTd>@context.Description</MudTd>
                <MudTd Style="text-align:right">@context.Quantity.ToString("N2")</MudTd>
                <MudTd Style="text-align:right">@context.UnitPrice.ToString("N2")</MudTd>
                <MudTd Style="text-align:right">@context.Gross.ToString("N2")</MudTd>
            </RowTemplate>
        </MudTable>

        @if (_invoice.Lines.Any(l => l.NonTaxableAmount > 0))
        {
            <MudStack Class="mt-3" AlignItems="AlignItems.End">
                <MudText>Non-Taxable: @_invoice.Lines.Sum(l => l.NonTaxableAmount).ToString("N2")</MudText>
                <MudText>Taxable: @_invoice.Lines.Sum(l => l.Quantity * l.UnitPrice).ToString("N2")</MudText>
                <MudText>VAT: @_invoice.TotalVat.ToString("N2")</MudText>
                <MudText Typo="Typo.h6">Grand Total: AED @_invoice.TotalGross.ToString("N2")</MudText>
            </MudStack>
        }
        else
        {
            <MudStack Class="mt-3" AlignItems="AlignItems.End">
                <MudText>Net: @_invoice.TotalNet.ToString("N2")</MudText>
                <MudText>VAT: @_invoice.TotalVat.ToString("N2")</MudText>
                <MudText Typo="Typo.h6">Total: AED @_invoice.TotalGross.ToString("N2")</MudText>
            </MudStack>
        }

        @if (!string.IsNullOrWhiteSpace(_invoice.Notes))
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2">Notes</MudText>
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap">@_invoice.Notes</MudText>
        }

        @if (!string.IsNullOrWhiteSpace(_invoice.AttachmentFileName))
        {
            <MudDivider Class="my-4" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="invoice-print-hide">
                <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                <MudText Typo="Typo.body2">@_invoice.AttachmentFileName</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="DownloadAttachment">Download</MudButton>
            </MudStack>
        }
    </MudPaper>

    @if (_lineBalances is not null && _lineBalances.Count > 1)
    {
        <FastTab Title="Per-Charge Payment Status" Class="invoice-print-hide">
            <MudTable Items="_lineBalances" Dense="true" Bordered="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Description</MudTh>
                    <MudTh Style="text-align:right">Amount</MudTh>
                    <MudTh Style="text-align:right">Paid</MudTh>
                    <MudTh Style="text-align:right">Balance</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Description</MudTd>
                    <MudTd Style="text-align:right">@context.Gross.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right">@context.Allocated.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right;font-weight:600">@context.Balance.ToString("N2")</MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small" Color="LineStatusColor(context)" Variant="Variant.Text">@LineStatusLabel(context)</MudChip></MudTd>
                </RowTemplate>
            </MudTable>
        </FastTab>
    }
}

<style>
    @@media print {
        .mud-appbar, .mud-drawer, .invoice-print-hide { display: none !important; }
    }
</style>

@code {
    [Parameter, EditorRequired] public int InvoiceId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private int _loadedForId = -1;
    private PurchaseInvoice? _invoice;
    private bool _loaded;
    private CompanySetup? _company;
    private decimal _balance;
    private ArStatus _status;
    private List<PurchaseInvoiceLineBalance>? _lineBalances;

    protected override async Task OnParametersSetAsync()
    {
        if (InvoiceId != _loadedForId)
        {
            _loadedForId = InvoiceId;
            await Load();
        }
    }

    private async Task Load()
    {
        _invoice = await InvoiceSvc.GetByIdAsync(InvoiceId);
        _loaded = true;
        if (_invoice is null) return;

        _balance = await InvoiceSvc.GetOutstandingAsync(InvoiceId);
        _lineBalances = await InvoiceSvc.GetLineBalancesAsync(InvoiceId);
        try { _company = await CompanySvc.GetAsync(); }
        catch (PostingException) { _company = null; }

        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        _status = _balance <= 0 ? ArStatus.Paid : _invoice.DueDate < today ? ArStatus.Overdue : ArStatus.Pending;
    }

    private async Task NotifyChangedAsync()
    {
        await Load();
        if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
    }

    private async Task Clone()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var parameters = new DialogParameters<NewPurchaseInvoiceDialog> { { x => x.CloneFrom, _invoice } };
        var dialog = await DialogService.ShowAsync<NewPurchaseInvoiceDialog>("New Purchase Invoice", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is int newId)
        {
            Nav.NavigateTo($"/purchase-invoice/{newId}");
            await NotifyChangedAsync();
        }
    }

    private void RecordPayment() => Nav.NavigateTo($"/payment-voucher?vendorId={_invoice!.VendorId}&invoiceId={InvoiceId}");
    private void ViewJournal() => Nav.NavigateTo($"/general-ledger?voucherNo={Uri.EscapeDataString(_invoice!.JournalVoucher!.VoucherNo)}");
    private void CreateDebitNote() => Nav.NavigateTo($"/debit-note?invoiceId={InvoiceId}");

    private async Task Print() => await JS.InvokeVoidAsync("print");

    private async Task DownloadAttachment()
    {
        var full = await InvoiceSvc.GetAttachmentAsync(InvoiceId);
        if (full is null) return;
        var base64 = Convert.ToBase64String(full.Value.Data);
        await JS.InvokeVoidAsync("downloadFileFromBytes", full.Value.FileName, full.Value.ContentType, base64);
    }

    private static Color StatusColor(ArStatus status) => status switch
    {
        ArStatus.Pending => Color.Info,
        ArStatus.Overdue => Color.Error,
        ArStatus.Paid => Color.Success,
        _ => Color.Default,
    };

    private static string LineStatusLabel(PurchaseInvoiceLineBalance l) =>
        l.Balance <= 0 ? "Paid" : l.Allocated > 0 ? "Partially Paid" : "Unpaid";

    private static Color LineStatusColor(PurchaseInvoiceLineBalance l) =>
        l.Balance <= 0 ? Color.Success : l.Allocated > 0 ? Color.Info : Color.Default;
}
