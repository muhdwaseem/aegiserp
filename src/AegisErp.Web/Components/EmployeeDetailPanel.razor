@using AegisErp.Web.Components.Dialogs
@inject EmployeeService EmployeeSvc
@inject GratuityService GratuitySvc
@inject LeaveService LeaveSvc
@inject CompanySession Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@if (_loaded && _employee is null)
{
    <MudAlert Severity="Severity.Error">Employee not found.</MudAlert>
}
else if (_employee is not null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
        <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
            <MudIcon Icon="@Icons.Material.Filled.Badge" />
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h6">@_employee.FullName</MudText>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@_employee.EmployeeCode</MudText>
                @if (!string.IsNullOrWhiteSpace(_employee.Designation))
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">·</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@_employee.Designation</MudText>
                }
            </MudStack>
        </div>
        <MudChip T="string" Size="Size.Small" Color="@(_employee.Status == EmployeeStatus.Active ? Color.Success : Color.Default)" Variant="Variant.Text">
            @_employee.Status
        </MudChip>
        <MudSpacer />
        @if (Session.CanAccessPayroll)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditEmployee">Edit</MudButton>
            @if (_employee.Status == EmployeeStatus.Active)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Terminate">Terminate</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="Reactivate">Reactivate</MudButton>
            }
        }
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Load" />
    </MudStack>

    <MudGrid Class="mb-3">
        <MudItem xs="12" sm="3">
            <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default)">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">BASIC SALARY</MudText>
                <MudText Typo="Typo.h6">@_employee.BasicSalary.ToString("N2")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default)">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">ALLOWANCES</MudText>
                <MudText Typo="Typo.h6">@((_employee.HousingAllowance + _employee.TransportAllowance + _employee.OtherAllowance).ToString("N2"))</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default)">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">GROSS SALARY</MudText>
                <MudText Typo="Typo.h6">@_employee.GrossSalary.ToString("N2")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudPaper Class="pa-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default)">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">JOINING DATE</MudText>
                <MudText Typo="Typo.h6">@_employee.JoiningDate.ToString("dd MMM yyyy")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Department</MudText>
            <MudText>@(_employee.CostCenter is null ? "—" : $"{_employee.CostCenter.Code} — {_employee.CostCenter.Name}")</MudText>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Salary Expense Account</MudText>
            <MudText>@_employee.EmployeeExpenseAccount.Code — @_employee.EmployeeExpenseAccount.Name</MudText>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Contact</MudText>
            <MudText>@(_employee.Mobile ?? "—") · @(_employee.Email ?? "—")</MudText>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Bank</MudText>
            <MudText>@(_employee.BankName ?? "—") @(_employee.Iban ?? "")</MudText>
        </MudItem>
        @if (_employee.Status == EmployeeStatus.Terminated)
        {
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Termination Date</MudText>
                <MudText>@_employee.TerminationDate?.ToString("dd MMM yyyy")</MudText>
            </MudItem>
        }
        @if (!string.IsNullOrWhiteSpace(_employee.Notes))
        {
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Notes</MudText>
                <MudText>@_employee.Notes</MudText>
            </MudItem>
        }
    </MudGrid>

    <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Compliance Documents</MudText>
    <MudGrid>
        <MudItem xs="12" sm="3">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Visa</MudText>
            @if (_employee.VisaExpiryDate is DateOnly visa)
            {
                <MudChip T="string" Size="Size.Small" Color="DocColor(visa)" Variant="Variant.Text">@visa.ToString("dd MMM yyyy")</MudChip>
            }
            else
            {
                <MudText>—</MudText>
            }
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Emirates ID @(_employee.EmiratesIdNumber is null ? "" : $"({_employee.EmiratesIdNumber})")</MudText>
            @if (_employee.EmiratesIdExpiryDate is DateOnly eid)
            {
                <MudChip T="string" Size="Size.Small" Color="DocColor(eid)" Variant="Variant.Text">@eid.ToString("dd MMM yyyy")</MudChip>
            }
            else
            {
                <MudText>—</MudText>
            }
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Labour Card @(_employee.LabourCardNumber is null ? "" : $"({_employee.LabourCardNumber})")</MudText>
            @if (_employee.LabourCardExpiryDate is DateOnly lc)
            {
                <MudChip T="string" Size="Size.Small" Color="DocColor(lc)" Variant="Variant.Text">@lc.ToString("dd MMM yyyy")</MudChip>
            }
            else
            {
                <MudText>—</MudText>
            }
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Passport @(_employee.PassportNumber is null ? "" : $"({_employee.PassportNumber})")</MudText>
            @if (_employee.PassportExpiryDate is DateOnly pp)
            {
                <MudChip T="string" Size="Size.Small" Color="DocColor(pp)" Variant="Variant.Text">@pp.ToString("dd MMM yyyy")</MudChip>
            }
            else
            {
                <MudText>—</MudText>
            }
        </MudItem>
    </MudGrid>

    @if (_gratuity is not null)
    {
        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Gratuity (EOSB)</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
            <MudChip T="string" Size="Size.Small" Color="@(_gratuity.Status == VoucherStatus.Posted ? Color.Success : Color.Default)" Variant="Variant.Text">@_gratuity.Status</MudChip>
            @if (_gratuity.IsPaid)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">Paid</MudChip>
            }
            <MudText>@_gratuity.YearsOfService.ToString("0.00") yrs · basic AED @_gratuity.BasicSalaryUsed.ToString("N2") · <b>AED @_gratuity.CalculatedAmount.ToString("N2")</b></MudText>
            <MudSpacer />
            @if (Session.CanAccessPayroll && _gratuity.CalculatedAmount > 0 && !_gratuity.IsPaid)
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" OnClick="OpenMarkGratuityPaid">Mark as Paid</MudButton>
            }
        </MudStack>
    }

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4 mb-2">
        <MudText Typo="Typo.subtitle1">Leave</MudText>
        <MudSpacer />
        @if (Session.CanPost)
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="OpenRequestLeave">Request Leave</MudButton>
        }
    </MudStack>
    @if (_leaveBalance is not null)
    {
        <MudText Class="mb-2">Annual balance: <b>@_leaveBalance.RemainingDays</b> of @_leaveBalance.AccruedDays days remaining (@_leaveBalance.UsedDays used)</MudText>
    }
    @if (_leaveRequests is { Count: > 0 })
    {
        <MudTable Items="_leaveRequests" Dense="true" Bordered="true" Elevation="0">
            <HeaderContent>
                <MudTh>Type</MudTh>
                <MudTh>Dates</MudTh>
                <MudTh Style="text-align:right">Days</MudTh>
                <MudTh>Status</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Type</MudTd>
                <MudTd>@context.StartDate.ToString("dd MMM yyyy") — @context.EndDate.ToString("dd MMM yyyy")</MudTd>
                <MudTd Style="text-align:right">@context.Days</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(context.Status switch { LeaveRequestStatus.Approved => Color.Success, LeaveRequestStatus.Rejected => Color.Error, _ => Color.Default })">@context.Status</MudChip>
                </MudTd>
                <MudTd>
                    @if (context.Status == LeaveRequestStatus.Pending && Session.CanAccessPayroll)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" OnClick="@(() => Decide(context, true))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" OnClick="@(() => Decide(context, false))" />
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else
    {
        <MudText Class="mud-text-secondary">No leave requests yet.</MudText>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [Parameter, EditorRequired] public int EmployeeId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _loaded;
    private Employee? _employee;
    private GratuityPayment? _gratuity;
    private LeaveBalance? _leaveBalance;
    private List<LeaveRequest>? _leaveRequests;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _employee = await EmployeeSvc.GetByIdAsync(EmployeeId);
        _loaded = true;
        if (_employee is null) return;

        _gratuity = await GratuitySvc.GetLatestForEmployeeAsync(EmployeeId);
        _leaveBalance = await LeaveSvc.GetBalanceAsync(EmployeeId, DateOnly.FromDateTime(DateTime.Today));
        _leaveRequests = await LeaveSvc.GetAllAsync(EmployeeId);
    }

    private async Task OpenMarkGratuityPaid()
    {
        var parameters = new DialogParameters<MarkGratuityPaidDialog> { { x => x.Payment, _gratuity! } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<MarkGratuityPaidDialog>("Mark Gratuity as Paid", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await Load();
            await OnChanged.InvokeAsync();
        }
    }

    private async Task OpenRequestLeave()
    {
        var parameters = new DialogParameters<RequestLeaveDialog> { { x => x.Employee, _employee! } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<RequestLeaveDialog>("Request Leave", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await Load();
        }
    }

    private async Task Decide(LeaveRequest request, bool approved)
    {
        try
        {
            var userName = AuthState is not null ? (await AuthState).User.Identity?.Name ?? "System Admin" : "System Admin";
            await LeaveSvc.DecideAsync(request.Id, approved, userName, DateTime.UtcNow);
            Snackbar.Add(approved ? "Leave approved." : "Leave rejected.", Severity.Info);
            await Load();
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Red &lt; 30 days, amber &lt; 90 days, green otherwise — matches
    /// EmployeeService.GetExpiringDocumentsAsync's default 90-day window.</summary>
    private static Color DocColor(DateOnly expiry)
    {
        var daysLeft = expiry.DayNumber - DateOnly.FromDateTime(DateTime.UtcNow).DayNumber;
        return daysLeft < 30 ? Color.Error : daysLeft < 90 ? Color.Warning : Color.Success;
    }

    private async Task EditEmployee()
    {
        var parameters = new DialogParameters<NewEmployeeDialog> { { x => x.Existing, _employee } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<NewEmployeeDialog>("Edit Employee", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await Load();
            await OnChanged.InvokeAsync();
        }
    }

    private async Task Terminate()
    {
        var parameters = new DialogParameters<TerminateEmployeeDialog> { { x => x.Employee, _employee! } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<TerminateEmployeeDialog>("Process Termination", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await Load();
            await OnChanged.InvokeAsync();
        }
    }

    private async Task Reactivate()
    {
        await EmployeeSvc.SetStatusAsync(_employee!.Id, EmployeeStatus.Active, null);
        Snackbar.Add("Employee reactivated.", Severity.Success);
        await Load();
        await OnChanged.InvokeAsync();
    }
}
