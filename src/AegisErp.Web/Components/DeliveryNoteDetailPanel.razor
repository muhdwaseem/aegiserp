@inject DeliveryNoteService DeliveryNoteSvc
@inject NavigationManager Nav
@inject ISnackbar Snackbar

@if (_loaded && _note is null)
{
    <MudAlert Severity="Severity.Error">Delivery note not found.</MudAlert>
}
else if (_note is not null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h5">@_note.DeliveryNoteNo</MudText>
        <MudChip T="string" Size="Size.Small" Color="@(_note.Status == DocumentStatus.Delivered ? Color.Success : Color.Default)" Variant="Variant.Text">@_note.Status</MudChip>
        <MudSpacer />
        <AuthorizeView Roles="@AppRoles.Posters" Context="auth">
            @if (_note.Status != DocumentStatus.Delivered)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => SetStatus(DocumentStatus.Delivered))">Mark Delivered</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" OnClick="@(() => SetStatus(DocumentStatus.Draft))">Reopen</MudButton>
            }
        </AuthorizeView>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Load" />
    </MudStack>

    <MudPaper Elevation="1">
        <MudTabs Elevation="0" ApplyEffectsToContainer="true" PanelClass="pa-4" Border="true">
            <MudTabPanel Text="General">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Customer</MudText>
                        <MudText Class="mb-2">@_note.Customer.Name</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Date</MudText>
                        <MudText Class="mb-2">@_note.Date.ToString("dd MMM yyyy")</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Related Invoice</MudText>
                        <MudText Class="mb-2">
                            @if (_note.SalesInvoice is not null)
                            {
                                <MudLink Href="@($"/sales-invoice/{_note.SalesInvoice.Id}")">@_note.SalesInvoice.InvoiceNo</MudLink>
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        @if (!string.IsNullOrWhiteSpace(_note.DeliveryAddress))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Delivery Address</MudText>
                            <MudText Class="mb-2">@_note.DeliveryAddress</MudText>
                        }
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Total Quantity</MudText>
                        <MudText Typo="Typo.h6" Class="mb-2">@_note.TotalQuantity.ToString("N0")</MudText>
                    </MudItem>
                </MudGrid>
                @if (!string.IsNullOrWhiteSpace(_note.Narration))
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">Narration</MudText>
                    <MudText>@_note.Narration</MudText>
                }

                <MudDivider Class="my-4" />
                <MudTable Items="_note.Lines.OrderBy(l => l.LineNo)" Dense="true" Bordered="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Description</MudTh>
                        <MudTh>Unit</MudTh>
                        <MudTh Style="text-align:right">Quantity</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Description</MudTd>
                        <MudTd>@context.Unit</MudTd>
                        <MudTd Style="text-align:right">@context.Quantity.ToString("N2")</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public int DeliveryNoteId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private int _loadedForId = -1;
    private bool _loaded;
    private DeliveryNote? _note;

    protected override async Task OnParametersSetAsync()
    {
        if (DeliveryNoteId != _loadedForId)
        {
            _loadedForId = DeliveryNoteId;
            await Load();
        }
    }

    private async Task Load()
    {
        _note = await DeliveryNoteSvc.GetByIdAsync(DeliveryNoteId);
        _loaded = true;
    }

    private async Task NotifyChangedAsync()
    {
        await Load();
        if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
    }

    private async Task SetStatus(DocumentStatus status)
    {
        try
        {
            await DeliveryNoteSvc.SetStatusAsync(DeliveryNoteId, status);
            await NotifyChangedAsync();
        }
        catch (PostingException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
