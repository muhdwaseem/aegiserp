@inject DirectExpensePaymentService PaymentSvc
@inject DirectExpenseService ExpenseSvc
@inject ChartOfAccountsService Coa
@inject LedgerService Ledger
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Record Payment</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@_expense?.ExpenseNo — settle in full or split across its lines</MudText>
    </TitleContent>
    <DialogContent>
        @if (_lines is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudSelect T="int" @bind-Value="_bankAccountId" Label="Pay From" Dense="true">
                        <MudSelectItem Value="0">— select bank —</MudSelectItem>
                        @if (_bankAccounts is not null)
                        {
                            @foreach (var a in _bankAccounts)
                            {
                                <MudSelectItem Value="a.Id">@a.Code — @a.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="PaymentMode" @bind-Value="_paymentMode" Label="Payment Mode" Dense="true">
                        <MudSelectItem Value="PaymentMode.Cash">Cash</MudSelectItem>
                        <MudSelectItem Value="PaymentMode.BankTransfer">Bank Transfer</MudSelectItem>
                        <MudSelectItem Value="PaymentMode.Cheque">Cheque</MudSelectItem>
                        <MudSelectItem Value="PaymentMode.PostDatedCheque">PDC (Post-Dated Cheque)</MudSelectItem>
                        <MudSelectItem Value="PaymentMode.Card">Card</MudSelectItem>
                        <MudSelectItem Value="PaymentMode.Other">Other</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker Date="_date" DateChanged="OnDateChanged" Label="Date" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_referenceNo" Label="Cheque / Ref. No." Placeholder="Optional" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker Date="_chequeDate" DateChanged="@(d => _chequeDate = d)" Label="Cheque Date" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_narration" Label="Narration" Placeholder="@($"Defaults to 'Expense payment — {_expense?.ExpenseNo}'")" />
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-3" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.subtitle2">Lines</MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="PayAllInFull" Disabled="@(TotalOutstanding <= 0)">Pay All in Full</MudButton>
            </MudStack>
            <div class="line-table-scroll">
            <MudTable Items="_lines" Dense="true" Bordered="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Description</MudTh>
                    <MudTh Style="text-align:right">Amount</MudTh>
                    <MudTh Style="text-align:right">Already Paid</MudTh>
                    <MudTh Style="text-align:right">Remaining</MudTh>
                    <MudTh Style="min-width:140px;text-align:right">Allocate</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@(context.Description ?? "—")</MudTd>
                    <MudTd Style="text-align:right">@context.Gross.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right">@context.Allocated.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right">@context.Balance.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right">
                        <MudNumericField T="decimal" Value="@_allocationInputs.GetValueOrDefault(context.LineId)"
                                         ValueChanged="@(v => OnLineAllocationChanged(context.LineId, v))"
                                         Min="0" Max="@context.Balance" HideSpinButtons="true" Margin="Margin.Dense"
                                         Disabled="@(context.Balance <= 0)" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
            </div>
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
                <MudSpacer />
                <MudText>Total: <b>AED @TotalAmount.ToString("N2")</b></MudText>
            </MudStack>

            <MudExpansionPanels Elevation="0" Class="mt-3">
                <MudExpansionPanel Text="GL Distribution Lines">
                    @if (_bankAccountId == 0 || TotalAmount <= 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Pick a bank account and allocate an amount to preview the GL impact.</MudText>
                    }
                    else
                    {
                        <MudTable Items="@GlPreviewLines()" Dense="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Account</MudTh>
                                <MudTh Style="text-align:right">Debit</MudTh>
                                <MudTh Style="text-align:right">Credit</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Account</MudTd>
                                <MudTd Style="text-align:right">@(context.Debit > 0 ? context.Debit.ToString("N2") : "")</MudTd>
                                <MudTd Style="text-align:right">@(context.Credit > 0 ? context.Credit.ToString("N2") : "")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PostAdd"
                   Disabled="@(!CanPost || _posting)" OnClick="Post">Post Payment</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter, EditorRequired] public int ExpenseId { get; set; }

    private DirectExpense? _expense;
    private List<DirectExpenseLineBalance>? _lines;
    private List<Account>? _bankAccounts;
    private List<FiscalPeriod>? _periods;

    private readonly Dictionary<int, decimal> _allocationInputs = new();

    private int _bankAccountId;
    private DateTime? _date = DateTime.Today;
    private int _periodId;
    private string? _narration;
    private string? _referenceNo;
    private DateTime? _chequeDate;
    private PaymentMode _paymentMode = PaymentMode.Cash;
    private bool _posting;

    private decimal TotalOutstanding => _lines?.Sum(l => l.Balance) ?? 0;
    private decimal TotalAmount => _allocationInputs.Values.Sum();
    private bool CanPost => _bankAccountId > 0 && _periodId > 0 && TotalAmount > 0;

    private record GlPreviewLine(string Account, decimal Debit, decimal Credit);

    private List<GlPreviewLine> GlPreviewLines()
    {
        var bankName = _bankAccounts?.FirstOrDefault(a => a.Id == _bankAccountId)?.Name ?? "Bank";
        return new List<GlPreviewLine>
        {
            new("Expenses Payable", TotalAmount, 0),
            new(bankName, 0, TotalAmount),
        };
    }

    protected override async Task OnInitializedAsync()
    {
        _expense = await ExpenseSvc.GetByIdAsync(ExpenseId);
        _lines = await PaymentSvc.GetLineBalancesAsync(ExpenseId);
        var accounts = await Coa.GetAllAsync(postableOnly: true);
        _bankAccounts = accounts.Where(a => a.Type == AccountType.Asset && a.Code.StartsWith("110")).ToList();
        _periods = await Ledger.GetPeriodsAsync();
        SyncPeriodToDate();
    }

    private void OnLineAllocationChanged(int lineId, decimal value) => _allocationInputs[lineId] = value;

    private void PayAllInFull()
    {
        if (_lines is null) return;
        foreach (var l in _lines.Where(l => l.Balance > 0))
            _allocationInputs[l.LineId] = l.Balance;
    }

    private void OnDateChanged(DateTime? d) { _date = d; SyncPeriodToDate(); }

    private void SyncPeriodToDate()
    {
        if (_periods is null || _date is null) return;
        var dd = DateOnly.FromDateTime(_date.Value);
        var match = _periods.FirstOrDefault(p => dd >= p.StartDate && dd <= p.EndDate);
        if (match is not null) _periodId = match.Id;
        else if (_periodId == 0) _periodId = _periods.LastOrDefault()?.Id ?? 0;
    }

    private async Task Post()
    {
        _posting = true;
        try
        {
            var userName = AuthState is not null ? (await AuthState).User.Identity?.Name ?? "System Admin" : "System Admin";
            var allocations = _allocationInputs.Where(kv => kv.Value > 0)
                .Select(kv => new ExpenseLineAllocationInput(kv.Key, kv.Value)).ToList();

            var p = await PaymentSvc.CreateAndPostAsync(
                ExpenseId, DateOnly.FromDateTime(_date ?? DateTime.Today), _periodId, _bankAccountId, TotalAmount,
                _narration, userName, DateTime.UtcNow, allocations, _paymentMode,
                _referenceNo, _chequeDate is DateTime cd ? DateOnly.FromDateTime(cd) : null);

            Snackbar.Add($"Posted {p.PaymentNo} — GL voucher generated.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(p.Id));
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _posting = false; }
    }

    private void Cancel() => MudDialog.Cancel();
}
