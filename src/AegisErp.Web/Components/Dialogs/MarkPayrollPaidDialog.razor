@inject PayrollService PayrollSvc
@inject ChartOfAccountsService Coa
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Mark Payroll as Paid</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-3">Net pay to transfer: AED @Run.TotalNet.ToString("N2")</MudText>
        <MudSelect T="int" @bind-Value="_bankAccountId" Label="Paid From">
            @if (_bankAccounts is not null)
            {
                @foreach (var a in _bankAccounts)
                {
                    <MudSelectItem Value="a.Id">@a.Code — @a.Name</MudSelectItem>
                }
            }
        </MudSelect>
        <MudDatePicker Date="_paidDate" DateChanged="@(d => _paidDate = d)" Label="Paid Date" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_bankAccountId == 0">Mark as Paid</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [Parameter, EditorRequired] public PayrollRun Run { get; set; } = null!;

    private List<Account>? _bankAccounts;
    private int _bankAccountId;
    private DateTime? _paidDate = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        var accounts = await Coa.GetAllAsync(postableOnly: true);
        _bankAccounts = accounts.Where(a => a.Type == AccountType.Asset).ToList();
    }

    private async Task Save()
    {
        try
        {
            var userName = AuthState is not null ? (await AuthState).User.Identity?.Name ?? "System Admin" : "System Admin";
            await PayrollSvc.MarkPaidAsync(Run.Id, _bankAccountId, DateOnly.FromDateTime(_paidDate ?? DateTime.Today), userName, DateTime.UtcNow);
            Snackbar.Add("Payroll marked as paid.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
