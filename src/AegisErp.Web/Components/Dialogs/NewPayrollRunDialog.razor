@inject PayrollService PayrollSvc
@inject LedgerService Ledger
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">New Payroll Run</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Creates a Draft run with one line per active employee, using their current salary — you
            can adjust deductions before posting.
        </MudText>
        <MudSelect T="int" @bind-Value="_fiscalPeriodId" Label="Fiscal Period">
            @if (_periods is not null)
            {
                @foreach (var p in _periods)
                {
                    <MudSelectItem Value="p.Id">@p.Name</MudSelectItem>
                }
            }
        </MudSelect>
        <MudDatePicker Date="_runDate" DateChanged="@(d => _runDate = d)" Label="Run Date" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_fiscalPeriodId == 0">Create Draft</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<FiscalPeriod>? _periods;
    private int _fiscalPeriodId;
    private DateTime? _runDate = DateTime.Today;

    protected override async Task OnInitializedAsync() => _periods = await Ledger.GetPeriodsAsync();

    private async Task Save()
    {
        try
        {
            var userName = AuthState is not null ? (await AuthState).User.Identity?.Name ?? "System Admin" : "System Admin";
            var run = await PayrollSvc.CreateDraftRunAsync(_fiscalPeriodId, DateOnly.FromDateTime(_runDate ?? DateTime.Today), userName, DateTime.UtcNow);
            Snackbar.Add("Draft payroll run created.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(run.Id));
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
