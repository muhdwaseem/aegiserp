@inject LeaveService LeaveSvc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Request Leave — @Employee.FullName</MudText>
    </TitleContent>
    <DialogContent>
        <MudSelect T="LeaveType" @bind-Value="_type" Label="Type">
            <MudSelectItem Value="LeaveType.Annual">Annual</MudSelectItem>
            <MudSelectItem Value="LeaveType.Sick">Sick</MudSelectItem>
            <MudSelectItem Value="LeaveType.Unpaid">Unpaid</MudSelectItem>
            <MudSelectItem Value="LeaveType.Other">Other</MudSelectItem>
        </MudSelect>
        <MudDatePicker Date="_startDate" DateChanged="@(d => _startDate = d)" Label="Start Date" Class="mt-3" />
        <MudDatePicker Date="_endDate" DateChanged="@(d => _endDate = d)" Label="End Date" Class="mt-3" />
        <MudTextField @bind-Value="_reason" Label="Reason (optional)" Lines="2" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Submit</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [Parameter, EditorRequired] public Employee Employee { get; set; } = null!;

    private LeaveType _type = LeaveType.Annual;
    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate = DateTime.Today;
    private string? _reason;

    private async Task Save()
    {
        try
        {
            var userName = AuthState is not null ? (await AuthState).User.Identity?.Name ?? "System Admin" : "System Admin";
            var start = DateOnly.FromDateTime(_startDate ?? DateTime.Today);
            var end = DateOnly.FromDateTime(_endDate ?? DateTime.Today);
            await LeaveSvc.CreateRequestAsync(Employee.Id, _type, start, end, _reason, userName, DateTime.UtcNow);
            Snackbar.Add("Leave request submitted.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
