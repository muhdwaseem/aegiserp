@inject SalesInvoiceService InvoiceSvc
@inject CustomerService CustomerSvc
@inject ChartOfAccountsService Coa
@inject LedgerService Ledger
@inject ItemService ItemSvc
@inject ServiceKitService KitSvc
@inject CompanyService CompanySvc
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">@TitleText</MudText>
            @if (!IsEdit && _revenueRecognitionEnabled && _recognition == RevenueRecognition.Deferred)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">DEFERRED</MudChip>
            }
        </MudStack>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Accounts Receivable</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.End">
                    <MudSelect T="int" Value="_customerId" ValueChanged="OnCustomerChanged" Label="Customer" Dense="true">
                        <MudSelectItem Value="0">— select —</MudSelectItem>
                        @if (_customers is not null)
                        {
                            @foreach (var c in _customers)
                            {
                                <MudSelectItem Value="c.Id">@c.Code — @c.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                    <MudTooltip Text="New customer">
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary"
                                       OnClick="OpenNewCustomer" />
                    </MudTooltip>
                </MudStack>
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField Value="@_invoiceNo" Label="Invoice No." ReadOnly="true" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudDatePicker Date="_date" DateChanged="OnDateChanged" Label="Invoice date" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudNumericField T="int" Value="_paymentTermsDays" ValueChanged="OnPaymentTermsChanged" Min="0" HideSpinButtons="true" Label="Payment Terms (Days)" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField Value="@_dueLabel" Label="Due date" ReadOnly="true" />
            </MudItem>
            @if (_proServiceFormat)
            {
                <MudItem xs="12" sm="3">
                    <MudSelect T="int?" Value="_organizationId" ValueChanged="OnOrganizationChanged" Label="Organization" Dense="true" Clearable="true">
                        @if (_organizations is not null)
                        {
                            @foreach (var o in _organizations)
                            {
                                <MudSelectItem T="int?" Value="o.Id">@o.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="_jobRequest" Label="Job Request" Placeholder="Optional" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="string" @bind-Value="_addressChoice" Label="Billing Address" Dense="true">
                        <MudSelectItem Value="@("default")">— Use customer default —</MudSelectItem>
                        <MudSelectItem Value="@("billing")">Billing Address</MudSelectItem>
                        <MudSelectItem Value="@("shipping")">Shipping Address</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="_contactMobile" Label="Mobile" Placeholder="Optional" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_contactEmail" Label="Email" Placeholder="Optional" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_contactTrn" Label="Customer TRN" Placeholder="Optional" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_contactPerson" Label="Contact Person" Placeholder="Optional" />
                </MudItem>
            }
            else
            {
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_customerPoNo" Label="Customer PO No." Placeholder="Optional" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_deliveryNoteRef" Label="Delivery Note Ref." Placeholder="Optional" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_salesOrderRef" Label="Sales Order Ref." Placeholder="Optional" />
                </MudItem>
            }
            <MudItem xs="12" sm="@SubjectWidth">
                <MudTextField @bind-Value="_subject" Label="Subject" Placeholder="Let your customer know what this invoice is for" />
            </MudItem>
            @if (_salespersonEnabled)
            {
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_salesperson" Label="Salesperson" Clearable="true">
                        @foreach (var sp in _salespersons)
                        {
                            <MudSelectItem Value="@sp">@sp</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            @if (_revenueRecognitionEnabled)
            {
                <MudItem xs="12" sm="4">
                    <MudSelect T="RevenueRecognition" @bind-Value="_recognition" Label="Revenue Recognition"
                               HelperText="Applies to every line on this invoice">
                        <MudSelectItem Value="RevenueRecognition.Direct">Direct</MudSelectItem>
                        <MudSelectItem Value="RevenueRecognition.Deferred">Deferred</MudSelectItem>
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudFileUpload T="IBrowserFile" FilesChanged="OnInvoiceFileSelected" Accept=".pdf,.jpg,.jpeg,.png">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile" Size="Size.Small">
                                Attach Document
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    @if (_invoiceAttachmentFileName is not null)
                    {
                        <MudChip T="string" Size="Size.Small" OnClose="RemoveInvoiceAttachment" CloseIcon="@Icons.Material.Filled.Close">@_invoiceAttachmentFileName</MudChip>
                    }
                </MudStack>
            </MudItem>
        </MudGrid>

        @if (_proServiceFormat)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1">Line Items</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@_lines.Count</MudChip>
                <MudSpacer />
                <MudMenu Icon="@Icons.Material.Filled.Widgets" Variant="Variant.Outlined" Label="Kit" EndIcon="@Icons.Material.Filled.ArrowDropDown">
                    @if (_kits is null || _kits.Count == 0)
                    {
                        <MudMenuItem Disabled="true">No kits defined yet</MudMenuItem>
                    }
                    else
                    {
                        @foreach (var k in _kits)
                        {
                            <MudMenuItem OnClick="@(() => InsertKit(k))">@k.Name (@k.Lines.Count)</MudMenuItem>
                        }
                    }
                </MudMenu>
            </MudStack>
        }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4">
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" OnClick="AddLine">Add line</MudButton>
            </MudStack>
        }

        <div class="line-table-scroll">
        @if (_proServiceFormat)
        {
            <MudTable Items="_lines" Dense="true" Bordered="true" Elevation="0" Class="mt-2 mb-2">
                <HeaderContent>
                    <MudTh Style="width:40px">#</MudTh>
                    <MudTh Style="min-width:160px">Service Type</MudTh>
                    <MudTh Style="min-width:160px">Description</MudTh>
                    <MudTh Style="min-width:200px">Revenue Account</MudTh>
                    <MudTh Style="min-width:80px;text-align:right">Qty</MudTh>
                    <MudTh Style="min-width:110px;text-align:right">Govt Fee</MudTh>
                    <MudTh Style="min-width:110px;text-align:right">Center Fee</MudTh>
                    <MudTh Style="min-width:110px;text-align:right">Bank Charge</MudTh>
                    <MudTh Style="min-width:90px">VAT</MudTh>
                    <MudTh Style="min-width:100px;text-align:right">VAT Amt</MudTh>
                    <MudTh Style="min-width:130px;text-align:right">Total</MudTh>
                    <MudTh Style="min-width:160px">Assigned To</MudTh>
                    <MudTh Style="width:48px"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@(_lines.IndexOf(context) + 1)</MudTd>
                    <MudTd>
                        <MudSelect T="int" Value="context.ItemId ?? 0" ValueChanged="v => OnItemChanged(context, v)" Dense="true" Margin="Margin.Dense" Clearable="true">
                            <MudSelectItem Value="0">— none —</MudSelectItem>
                            @if (_items is not null)
                            {
                                @foreach (var it in _items)
                                {
                                    <MudSelectItem Value="it.Id">@it.Code — @it.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd><MudTextField @bind-Value="context.Description" Margin="Margin.Dense" Placeholder="Service line" /></MudTd>
                    <MudTd>
                        <MudSelect T="int" @bind-Value="context.RevenueAccountId" Dense="true" Margin="Margin.Dense">
                            <MudSelectItem Value="0">— select —</MudSelectItem>
                            @if (_revenueAccounts is not null)
                            {
                                @foreach (var a in _revenueAccounts)
                                {
                                    <MudSelectItem Value="a.Id">@a.Code — @a.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd><MudNumericField T="decimal" @bind-Value="context.Quantity" Min="0" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                    <MudTd><MudNumericField T="decimal" @bind-Value="context.GovtFee" Min="0" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                    <MudTd><MudNumericField T="decimal" @bind-Value="context.UnitPrice" Min="0" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                    <MudTd><MudNumericField T="decimal" @bind-Value="context.BankCharge" Min="0" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                    <MudTd>
                        <MudSelect T="decimal" @bind-Value="context.VatRate" Dense="true" Margin="Margin.Dense">
                            <MudSelectItem Value="0.05m">5%</MudSelectItem>
                            <MudSelectItem Value="0m">0%</MudSelectItem>
                        </MudSelect>
                    </MudTd>
                    <MudTd Style="text-align:right">@context.Vat.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right;font-weight:600">@context.Gross.ToString("N2")</MudTd>
                    <MudTd>
                        <MudSelect T="string" @bind-Value="context.AssignedTo" Dense="true" Margin="Margin.Dense" Clearable="true">
                            @foreach (var sp in _salespersons)
                            {
                                <MudSelectItem Value="@sp">@sp</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" OnClick="AddLine" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => RemoveLine(context))" Disabled="_lines.Count <= 1" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudTable Items="_lines" Dense="true" Bordered="true" Elevation="0" Class="mt-2 mb-2">
                <HeaderContent>
                    <MudTh Style="width:40px">#</MudTh>
                    <MudTh Style="min-width:180px">Item</MudTh>
                    <MudTh Style="min-width:160px">Description</MudTh>
                    <MudTh Style="min-width:200px">Revenue Account</MudTh>
                    <MudTh Style="min-width:90px;text-align:right">Qty</MudTh>
                    <MudTh Style="min-width:90px">UOM</MudTh>
                    <MudTh Style="min-width:130px;text-align:right">Unit Price</MudTh>
                    <MudTh Style="min-width:160px;text-align:right">Discount</MudTh>
                    <MudTh Style="min-width:90px">VAT</MudTh>
                    <MudTh Style="min-width:130px;text-align:right">Line Total</MudTh>
                    <MudTh Style="width:48px">Doc</MudTh>
                    <MudTh Style="width:48px"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@(_lines.IndexOf(context) + 1)</MudTd>
                    <MudTd>
                        <MudSelect T="int" Value="context.ItemId ?? 0" ValueChanged="v => OnItemChanged(context, v)" Dense="true" Margin="Margin.Dense" Clearable="true">
                            <MudSelectItem Value="0">— none —</MudSelectItem>
                            @if (_items is not null)
                            {
                                @foreach (var it in _items)
                                {
                                    <MudSelectItem Value="it.Id">@it.Code — @it.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd><MudTextField @bind-Value="context.Description" Margin="Margin.Dense" Placeholder="Service / item" /></MudTd>
                    <MudTd>
                        <MudSelect T="int" @bind-Value="context.RevenueAccountId" Dense="true" Margin="Margin.Dense">
                            <MudSelectItem Value="0">— select —</MudSelectItem>
                            @if (_revenueAccounts is not null)
                            {
                                @foreach (var a in _revenueAccounts)
                                {
                                    <MudSelectItem Value="a.Id">@a.Code — @a.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd><MudNumericField T="decimal" @bind-Value="context.Quantity" Min="0" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                    <MudTd><MudTextField @bind-Value="context.Uom" Margin="Margin.Dense" Placeholder="unit" /></MudTd>
                    <MudTd><MudNumericField T="decimal" @bind-Value="context.UnitPrice" Min="0" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                    <MudTd>
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudNumericField T="decimal" @bind-Value="context.DiscountValue" Min="0"
                                             Max="@(context.DiscountType == DiscountType.Percent ? 100m : decimal.MaxValue)"
                                             HideSpinButtons="true" Margin="Margin.Dense" Style="min-width:80px" />
                            <MudSelect T="DiscountType" @bind-Value="context.DiscountType" Dense="true" Margin="Margin.Dense" Style="min-width:80px">
                                <MudSelectItem Value="DiscountType.Percent">%</MudSelectItem>
                                <MudSelectItem Value="DiscountType.Amount">AED</MudSelectItem>
                            </MudSelect>
                        </MudStack>
                    </MudTd>
                    <MudTd>
                        <MudSelect T="decimal" @bind-Value="context.VatRate" Dense="true" Margin="Margin.Dense">
                            <MudSelectItem Value="0.05m">5%</MudSelectItem>
                            <MudSelectItem Value="0m">0%</MudSelectItem>
                        </MudSelect>
                    </MudTd>
                    <MudTd Style="text-align:right;font-weight:600">@context.Gross.ToString("N2")</MudTd>
                    <MudTd>
                        <MudTooltip Text="@(context.AttachmentFileName ?? "Attach supporting document for this line")">
                            <MudFileUpload T="IBrowserFile" FilesChanged="@(f => OnLineFileSelected(context, f))" Accept=".pdf,.jpg,.jpeg,.png">
                                <ActivatorContent>
                                    <MudIconButton Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small"
                                                   Color="@(context.AttachmentFileName is null ? Color.Default : Color.Primary)" />
                                </ActivatorContent>
                            </MudFileUpload>
                        </MudTooltip>
                        @if (context.AttachmentFileName is not null)
                        {
                            <MudTooltip Text="Remove attachment">
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => RemoveLineAttachment(context))" />
                            </MudTooltip>
                        }
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => RemoveLine(context))" Disabled="_lines.Count <= 1" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        </div>

        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudSpacer />
            @if (_proServiceFormat)
            {
                <MudText Class="mr-4">Subtotal: <b>@TotalNet.ToString("N2")</b></MudText>
                <MudText Class="mr-4">VAT: <b>@TotalVat.ToString("N2")</b></MudText>
                <MudText Class="mr-4">Grand Total: <b>AED @TotalGross.ToString("N2")</b></MudText>
            }
            else
            {
                <MudText Class="mr-4">Net: <b>@TotalNet.ToString("N2")</b></MudText>
                <MudText Class="mr-4">VAT: <b>@TotalVat.ToString("N2")</b></MudText>
                <MudText Class="mr-4">Total: <b>AED @TotalGross.ToString("N2")</b></MudText>
            }
        </MudStack>

        @* Notes / Terms & Conditions sit below the line items — same place they print, matching
           Zoho's own layout — rather than up top before the customer has even seen the totals. *@
        <MudGrid Class="mt-2">
            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Notes" Lines="2" Placeholder="Payment terms, delivery notes… (shown on the printed invoice)" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_termsAndConditions" Label="Terms &amp; Conditions" Lines="2"
                              Placeholder="Enter the terms and conditions of your business to be displayed on this invoice" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Drafts"
                   Disabled="@(!CanSaveDraft || _posting)" OnClick="SaveDraft">Save as Draft</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PostAdd"
                   Disabled="@(!CanPost || _posting)" OnClick="Post">Post Invoice</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Edit mode: update this draft in place instead of creating a new invoice. Only ever
    /// passed for a Draft invoice — posted invoices are immutable and reversed via Credit Note.</summary>
    [Parameter] public SalesInvoice? Existing { get; set; }
    /// <summary>Clone mode: seed a brand-new invoice's initial Customer/Narration/Lines from this one.</summary>
    [Parameter] public SalesInvoice? CloneFrom { get; set; }

    private bool IsEdit => Existing is not null;

    private List<Customer>? _customers;
    private List<Account>? _revenueAccounts;
    private List<FiscalPeriod>? _periods;
    private List<Item>? _items;
    private List<ServiceKit>? _kits;
    private List<CustomerOrganization>? _organizations;

    private bool _proServiceFormat;
    private int? _organizationId;
    private string? _contactMobile;
    private string? _contactEmail;
    private string? _contactTrn;
    private string? _contactPerson;
    private string? _jobRequest;

    /// <summary>Backs the Billing Address dropdown — "default"/"billing" both resolve to the
    /// customer's Billing Address, "shipping" to their Shipping Address. The resolved text (not
    /// this choice) is what's actually stored as <see cref="SalesInvoice.BillingAddressSnapshot"/>.</summary>
    private string _addressChoice = "default";
    private string? _customerBillingAddress;
    private string? _customerShippingAddress;
    private string? ResolvedBillingAddress => _addressChoice == "shipping" ? _customerShippingAddress : _customerBillingAddress;

    private int _customerId;
    private DateTime? _date = DateTime.Today;
    private int _periodId;
    private string? _narration;
    private string? _customerPoNo;
    private string? _deliveryNoteRef;
    private string? _salesOrderRef;
    private string? _notes;
    private string? _subject;
    private string? _termsAndConditions;
    private string? _salesperson;
    private bool _salespersonEnabled;
    private List<string> _salespersons = new();
    private RevenueRecognition _recognition = RevenueRecognition.Direct;
    private bool _revenueRecognitionEnabled;
    private bool _posting;
    private string _dueLabel = "—";
    private string _invoiceNo = "—";
    private int _paymentTermsDays = 30;

    private string? _invoiceAttachmentFileName;
    private string? _invoiceAttachmentContentType;
    private byte[]? _invoiceAttachmentBytes;
    private bool _removeInvoiceAttachment;

    private readonly List<LineVm> _lines = new() { new() };

    private decimal TotalNet => _lines.Sum(l => l.Net);
    private decimal TotalVat => _lines.Sum(l => l.Vat);
    private decimal TotalGross => _lines.Sum(l => l.Gross);
    private bool CanPost => _customerId > 0 && _periodId > 0 && TotalGross > 0
                            && _lines.All(l => l.RevenueAccountId > 0 && !string.IsNullOrWhiteSpace(l.Description));
    // Looser than CanPost: a draft can be saved before every account/price detail is finalized.
    private bool CanSaveDraft => _customerId > 0 && _periodId > 0
                            && _lines.Any(l => !string.IsNullOrWhiteSpace(l.Description));

    /// <summary>Subject fills whatever room Salesperson/Revenue Recognition don't need — both off
    /// (the common case) gives it the full row, same as before either setting existed.</summary>
    private int SubjectWidth => 12 - (_salespersonEnabled ? 4 : 0) - (_revenueRecognitionEnabled ? 4 : 0);

    private string TitleText => IsEdit ? $"Edit {Existing!.InvoiceNo}"
        : _revenueRecognitionEnabled && _recognition == RevenueRecognition.Deferred ? "New Deferred Invoice" : "New Sales Invoice";

    protected override async Task OnInitializedAsync()
    {
        _customers = await CustomerSvc.GetAllAsync(activeOnly: true);
        var accounts = await Coa.GetAllAsync(postableOnly: true);
        _revenueAccounts = accounts.Where(a => a.Type == AccountType.Income).ToList();
        _periods = await Ledger.GetPeriodsAsync();
        _items = await ItemSvc.GetAllAsync(activeOnly: true);

        CompanySetup? company = null;
        try { company = await CompanySvc.GetAsync(); }
        catch (PostingException) { /* no company selected yet — keep the built-in defaults */ }
        _salespersonEnabled = company?.SalespersonEnabled ?? false;
        _salespersons = company?.Salespersons.Select(s => s.Name).OrderBy(n => n).ToList() ?? new();
        _revenueRecognitionEnabled = company?.RevenueRecognitionEnabled ?? false;
        _proServiceFormat = company?.ProServiceModeEnabled ?? false;
        if (_proServiceFormat) _kits = await KitSvc.GetAllAsync(activeOnly: true);

        var seed = Existing ?? CloneFrom;
        if (seed is not null)
        {
            _customerId = seed.CustomerId;
            _organizationId = seed.OrganizationId;
            _contactMobile = seed.ContactMobile;
            _contactEmail = seed.ContactEmail;
            _contactTrn = seed.ContactTrn;
            _contactPerson = seed.ContactPerson;
            _jobRequest = seed.JobRequest;
            // A stored snapshot is frozen free text, but the dropdown can only pick "default" or
            // "shipping" — reset to default and let it resolve against the current customer record.
            _addressChoice = "default";
            _date = Existing is not null ? seed.Date.ToDateTime(TimeOnly.MinValue) : DateTime.Today;
            _narration = seed.Narration;
            _customerPoNo = seed.CustomerPoNo;
            _deliveryNoteRef = seed.DeliveryNoteRef;
            _salesOrderRef = seed.SalesOrderRef;
            _notes = seed.Notes;
            _subject = seed.Subject;
            _termsAndConditions = seed.TermsAndConditions;
            _salesperson = seed.Salesperson;
            _paymentTermsDays = Math.Max(0, seed.DueDate.DayNumber - seed.Date.DayNumber);
            _invoiceNo = Existing?.InvoiceNo ?? await InvoiceSvc.PeekNextInvoiceNoAsync(DateTime.Today.Year);
            if (Existing is not null)
            {
                _invoiceAttachmentFileName = Existing.AttachmentFileName;
                _invoiceAttachmentContentType = Existing.AttachmentContentType;
            }
            if (_proServiceFormat && _customerId > 0)
            {
                var customer = await CustomerSvc.GetByIdAsync(_customerId);
                _organizations = customer?.Organizations.Where(o => o.IsActive).ToList();
                _customerBillingAddress = customer?.BillingAddressLine1;
                _customerShippingAddress = customer?.ShippingAddressLine1;
            }
            _lines.Clear();
            foreach (var l in seed.Lines.OrderBy(l => l.LineNo))
                _lines.Add(new LineVm
                {
                    Id = Existing is not null ? l.Id : null,
                    ItemId = l.ItemId,
                    Description = l.Description,
                    RevenueAccountId = l.RevenueAccountId,
                    CostCenterId = l.CostCenterId,
                    Quantity = l.Quantity,
                    UnitPrice = l.UnitPrice,
                    VatRate = l.VatRate,
                    DiscountValue = l.DiscountValue,
                    DiscountType = l.DiscountType,
                    Uom = l.Uom,
                    GovtFee = l.GovtFee,
                    BankCharge = l.BankCharge,
                    AssignedTo = l.AssignedTo,
                    AttachmentFileName = l.AttachmentFileName,
                    AttachmentContentType = l.AttachmentContentType,
                    AttachmentBytes = l.AttachmentData,
                });
            // Recognition is now one choice for the whole invoice — an older invoice posted before
            // that could in principle have mixed per-line values, so fall back to Direct rather than
            // guess if they disagree, instead of silently picking one line's value for all of them.
            var recognitions = seed.Lines.Select(l => l.Recognition).Distinct().ToList();
            _recognition = recognitions.Count == 1 ? recognitions[0] : RevenueRecognition.Direct;
            UpdateDueLabel();
        }
        else
        {
            _invoiceNo = await InvoiceSvc.PeekNextInvoiceNoAsync((_date ?? DateTime.Today).Year);
            if (company is not null)
            {
                _paymentTermsDays = company.InvoiceDefaultPaymentTermsDays;
                _notes = company.InvoiceDefaultNotes;
                _termsAndConditions = company.InvoiceDefaultTermsAndConditions;
            }
        }

        SyncPeriodToDate();
    }

    private async Task OnInvoiceFileSelected(IBrowserFile file)
    {
        if (file.Size > SalesInvoiceService.MaxAttachmentBytes)
        {
            Snackbar.Add($"That file is too large — the limit is {SalesInvoiceService.MaxAttachmentBytes / (1024 * 1024)} MB.", Severity.Error);
            return;
        }

        using var stream = file.OpenReadStream(SalesInvoiceService.MaxAttachmentBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _invoiceAttachmentBytes = ms.ToArray();
        _invoiceAttachmentFileName = file.Name;
        _invoiceAttachmentContentType = file.ContentType;
        _removeInvoiceAttachment = false;
    }

    private void RemoveInvoiceAttachment()
    {
        _invoiceAttachmentFileName = null;
        _invoiceAttachmentContentType = null;
        _invoiceAttachmentBytes = null;
        _removeInvoiceAttachment = Existing?.AttachmentFileName is not null;
    }

    /// <summary>Applies a newly-staged invoice-level attachment, or an explicit removal, after save.
    /// Mirrors <see cref="SaveLineAttachmentsAsync"/> but for the single document-level attachment.</summary>
    private async Task SaveInvoiceAttachmentAsync(SalesInvoice inv)
    {
        if (_invoiceAttachmentBytes is not null)
            await InvoiceSvc.SetAttachmentAsync(inv.Id, _invoiceAttachmentFileName!,
                _invoiceAttachmentContentType ?? "application/octet-stream", _invoiceAttachmentBytes);
        else if (_removeInvoiceAttachment)
            await InvoiceSvc.RemoveAttachmentAsync(inv.Id);
    }

    /// <summary>
    /// Picking an item pre-fills its description, price and VAT. The revenue account is set to
    /// whichever account this item was last billed to (falling back to the item's own default),
    /// so the user doesn't have to re-pick it every time the same item recurs on an invoice.
    /// </summary>
    private async Task OnItemChanged(LineVm line, int itemId)
    {
        line.ItemId = itemId == 0 ? null : itemId;
        var item = _items?.FirstOrDefault(i => i.Id == itemId);
        if (item is null) return;

        line.Description = item.SalesDescription ?? item.Name;
        line.UnitPrice = item.SellingPrice;
        line.Uom = item.Unit;
        line.VatRate = item.TaxCode?.Rate ?? line.VatRate;
        if (CustomerIsZeroRated) line.VatRate = 0m; // export / designated-zone customer overrides the item's own tax code

        var lastAccountId = await InvoiceSvc.GetLastRevenueAccountForItemAsync(itemId);
        line.RevenueAccountId = lastAccountId ?? item.SalesAccountId ?? 0;
    }

    /// <summary>
    /// True only for the Tax Treatments that actually justify 0% VAT under UAE VAT law — an export
    /// outside the GCC, or a designated-zone customer. "Non VAT Registered" alone does NOT belong
    /// here: a domestic UAE supply still carries standard VAT regardless of the customer's own
    /// registration status, so it must not default to zero-rated.
    /// </summary>
    private bool CustomerIsZeroRated =>
        _customers?.FirstOrDefault(c => c.Id == _customerId)?.TaxTreatment is
            TaxTreatment.NonGcc or TaxTreatment.VatRegisteredDesignatedZone or TaxTreatment.NonVatRegisteredDesignatedZone;

    /// <summary>Resets the VAT rate on any still-blank line (no description, no item picked yet) to
    /// match the newly selected customer's zero-rating status — lines the user has already started
    /// filling in are left untouched.</summary>
    private void ApplyZeroRateDefaultToBlankLines()
    {
        var rate = CustomerIsZeroRated ? 0m : 0.05m;
        foreach (var l in _lines.Where(l => l.ItemId is null && string.IsNullOrWhiteSpace(l.Description)))
            l.VatRate = rate;
    }

    private async Task OnLineFileSelected(LineVm line, IBrowserFile file)
    {
        if (file.Size > SalesInvoiceService.MaxAttachmentBytes)
        {
            Snackbar.Add($"That file is too large — the limit is {SalesInvoiceService.MaxAttachmentBytes / (1024 * 1024)} MB.", Severity.Error);
            return;
        }

        using var stream = file.OpenReadStream(SalesInvoiceService.MaxAttachmentBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        line.AttachmentBytes = ms.ToArray();
        line.AttachmentFileName = file.Name;
        line.AttachmentContentType = file.ContentType;
    }

    private void RemoveLineAttachment(LineVm line)
    {
        line.AttachmentBytes = null;
        line.AttachmentFileName = null;
        line.AttachmentContentType = null;
    }

    /// <summary>Auto-fills the contact snapshot fields from the newly selected customer (PRO Service
    /// Mode only) — mirrors Estimate's own <c>OnCustomerChanged</c>. Fields stay editable afterwards.</summary>
    private async Task OnCustomerChanged(int id)
    {
        _customerId = id;
        var c = _customers?.FirstOrDefault(x => x.Id == id);
        if (c is not null) _paymentTermsDays = c.PaymentTermsDays;
        if (_salespersonEnabled && string.IsNullOrWhiteSpace(_salesperson)) _salesperson = c?.Salesperson;
        ApplyZeroRateDefaultToBlankLines();
        UpdateDueLabel();

        _organizationId = null;
        _organizations = null;
        _addressChoice = "default";
        if (!_proServiceFormat || id == 0) return;

        var customer = await CustomerSvc.GetByIdAsync(id);
        if (customer is null) return;
        _organizations = customer.Organizations.Where(o => o.IsActive).ToList();
        _contactMobile = customer.Mobile;
        _contactEmail = customer.Email;
        _contactTrn = customer.Trn;
        _contactPerson = customer.ContactPersons.FirstOrDefault()?.FirstName;
        _customerBillingAddress = customer.BillingAddressLine1;
        _customerShippingAddress = customer.ShippingAddressLine1;
    }

    /// <summary>Opens the New Customer dialog without leaving this one — on save, reloads the
    /// customer list and selects the newly created customer, same as picking it from the dropdown.</summary>
    private async Task OpenNewCustomer()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<NewCustomerDialog>("New Customer", options);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is int newId)
        {
            _customers = await CustomerSvc.GetAllAsync(activeOnly: true);
            await OnCustomerChanged(newId);
        }
    }

    /// <summary>Picking an Organization overwrites the Contact TRN with the organization's own —
    /// a PRO services company processes government paperwork per specific trade license.</summary>
    private void OnOrganizationChanged(int? id)
    {
        _organizationId = id;
        var org = _organizations?.FirstOrDefault(o => o.Id == id);
        if (org is not null) _contactTrn = org.Trn;
    }

    /// <summary>Appends a kit's predefined lines to the invoice — pure client-side line population,
    /// no relationship persisted between the kit and this invoice.</summary>
    private void InsertKit(ServiceKit kit)
    {
        foreach (var l in kit.Lines.OrderBy(l => l.SortOrder))
            _lines.Add(new LineVm
            {
                Description = l.Description,
                RevenueAccountId = l.RevenueAccountId ?? 0,
                GovtFee = l.GovtFee,
                UnitPrice = l.CenterFee,
                BankCharge = l.BankCharge,
                VatRate = l.VatRate,
            });
        if (_lines.Count > 1 && _lines[0].Description == "" && _lines[0].GovtFee == 0 && _lines[0].UnitPrice == 0 && _lines[0].BankCharge == 0)
            _lines.RemoveAt(0); // drop the still-blank starter row once real lines exist
    }

    private async Task OnDateChanged(DateTime? d)
    {
        _date = d;
        SyncPeriodToDate();
        UpdateDueLabel();
        if (!IsEdit) _invoiceNo = await InvoiceSvc.PeekNextInvoiceNoAsync((_date ?? DateTime.Today).Year);
    }

    private void OnPaymentTermsChanged(int v) { _paymentTermsDays = v; UpdateDueLabel(); }

    private void SyncPeriodToDate()
    {
        if (_periods is null || _date is null) return;
        var d = DateOnly.FromDateTime(_date.Value);
        var match = _periods.FirstOrDefault(p => d >= p.StartDate && d <= p.EndDate);
        if (match is not null) _periodId = match.Id;
        else if (_periodId == 0) _periodId = _periods.LastOrDefault()?.Id ?? 0;
    }

    private void UpdateDueLabel()
    {
        _dueLabel = _customerId == 0 || _date is null
            ? "—"
            : DateOnly.FromDateTime(_date.Value).AddDays(_paymentTermsDays).ToString("yyyy-MM-dd");
    }

    private void AddLine() => _lines.Add(new() { VatRate = CustomerIsZeroRated ? 0m : 0.05m });
    private void RemoveLine(LineVm l) { if (_lines.Count > 1) _lines.Remove(l); }

    private async Task Post()
    {
        _posting = true;
        try
        {
            var userName = AuthState is not null ? (await AuthState).User.Identity?.Name ?? "System Admin" : "System Admin";
            var inputs = _lines.Select(l => new InvoiceLineInput(
                l.Description, l.RevenueAccountId, l.CostCenterId, l.Quantity, l.UnitPrice, l.VatRate, l.ItemId,
                l.DiscountValue, l.Uom, _recognition, l.DiscountType, l.GovtFee, l.BankCharge, l.AssignedTo));

            SalesInvoice inv;
            if (IsEdit)
            {
                await InvoiceSvc.UpdateDraftAsync(Existing!.Id, _customerId,
                    DateOnly.FromDateTime(_date ?? DateTime.Today), _periodId, _narration, inputs,
                    _customerPoNo, _deliveryNoteRef, _salesOrderRef, _notes, _paymentTermsDays,
                    _subject, _termsAndConditions, _salesperson,
                    _proServiceFormat ? _organizationId : null,
                    _proServiceFormat ? _contactMobile : null, _proServiceFormat ? _contactEmail : null,
                    _proServiceFormat ? _contactTrn : null, _proServiceFormat ? _contactPerson : null,
                    _proServiceFormat ? ResolvedBillingAddress : null,
                    _proServiceFormat ? _jobRequest : null);
                inv = await InvoiceSvc.PostDraftAsync(Existing!.Id, userName, DateTime.UtcNow);
            }
            else
            {
                inv = await InvoiceSvc.CreateAndPostAsync(
                    _customerId, DateOnly.FromDateTime(_date ?? DateTime.Today), _periodId,
                    _narration, userName, inputs, DateTime.UtcNow,
                    _customerPoNo, _deliveryNoteRef, _salesOrderRef, _notes, _paymentTermsDays,
                    _subject, _termsAndConditions, _salesperson,
                    _proServiceFormat ? _organizationId : null,
                    _proServiceFormat ? _contactMobile : null, _proServiceFormat ? _contactEmail : null,
                    _proServiceFormat ? _contactTrn : null, _proServiceFormat ? _contactPerson : null,
                    _proServiceFormat ? ResolvedBillingAddress : null,
                    _proServiceFormat ? _jobRequest : null);
            }
            await SaveLineAttachmentsAsync(inv);
            await SaveInvoiceAttachmentAsync(inv);

            Snackbar.Add($"Posted {inv.InvoiceNo} — GL voucher {inv.JournalVoucher?.VoucherNo} generated.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(inv.Id));
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _posting = false; }
    }

    private async Task SaveDraft()
    {
        _posting = true;
        try
        {
            var userName = AuthState is not null ? (await AuthState).User.Identity?.Name ?? "System Admin" : "System Admin";
            var inputs = _lines.Select(l => new InvoiceLineInput(
                l.Description, l.RevenueAccountId, l.CostCenterId, l.Quantity, l.UnitPrice, l.VatRate, l.ItemId,
                l.DiscountValue, l.Uom, _recognition, l.DiscountType, l.GovtFee, l.BankCharge, l.AssignedTo));

            SalesInvoice inv;
            if (IsEdit)
            {
                inv = await InvoiceSvc.UpdateDraftAsync(Existing!.Id, _customerId,
                    DateOnly.FromDateTime(_date ?? DateTime.Today), _periodId, _narration, inputs,
                    _customerPoNo, _deliveryNoteRef, _salesOrderRef, _notes, _paymentTermsDays,
                    _subject, _termsAndConditions, _salesperson,
                    _proServiceFormat ? _organizationId : null,
                    _proServiceFormat ? _contactMobile : null, _proServiceFormat ? _contactEmail : null,
                    _proServiceFormat ? _contactTrn : null, _proServiceFormat ? _contactPerson : null,
                    _proServiceFormat ? ResolvedBillingAddress : null,
                    _proServiceFormat ? _jobRequest : null);
                Snackbar.Add($"Updated {inv.InvoiceNo}.", Severity.Success);
            }
            else
            {
                inv = await InvoiceSvc.CreateDraftAsync(
                    _customerId, DateOnly.FromDateTime(_date ?? DateTime.Today), _periodId,
                    _narration, userName, inputs, DateTime.UtcNow,
                    _customerPoNo, _deliveryNoteRef, _salesOrderRef, _notes, _paymentTermsDays,
                    _subject, _termsAndConditions, _salesperson,
                    _proServiceFormat ? _organizationId : null,
                    _proServiceFormat ? _contactMobile : null, _proServiceFormat ? _contactEmail : null,
                    _proServiceFormat ? _contactTrn : null, _proServiceFormat ? _contactPerson : null,
                    _proServiceFormat ? ResolvedBillingAddress : null,
                    _proServiceFormat ? _jobRequest : null);
                Snackbar.Add($"Saved {inv.InvoiceNo} as a draft.", Severity.Success);
            }
            await SaveLineAttachmentsAsync(inv);
            await SaveInvoiceAttachmentAsync(inv);

            MudDialog.Close(DialogResult.Ok(inv.Id));
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _posting = false; }
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>
    /// Applies each line's staged attachment (a new upload, or one carried over from the invoice
    /// being edited) to its freshly-saved <see cref="SalesInvoiceLine"/> row. Matched by position —
    /// both lists are in the same LineNo order the lines were submitted in.
    /// </summary>
    private async Task SaveLineAttachmentsAsync(SalesInvoice inv)
    {
        var savedLines = inv.Lines.OrderBy(l => l.LineNo).ToList();
        for (var i = 0; i < _lines.Count && i < savedLines.Count; i++)
        {
            var vm = _lines[i];
            if (vm.AttachmentBytes is not null)
                await InvoiceSvc.SetLineAttachmentAsync(savedLines[i].Id, vm.AttachmentFileName!,
                    vm.AttachmentContentType ?? "application/octet-stream", vm.AttachmentBytes);
        }
    }

    private class LineVm
    {
        public int? Id { get; set; }
        public int? ItemId { get; set; }
        public string Description { get; set; } = "";
        public int RevenueAccountId { get; set; }
        public int? CostCenterId { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal VatRate { get; set; } = 0.05m;
        public decimal DiscountValue { get; set; }
        public DiscountType DiscountType { get; set; } = DiscountType.Percent;
        public string? Uom { get; set; }
        public decimal GovtFee { get; set; }
        public decimal BankCharge { get; set; }
        public string? AssignedTo { get; set; }

        public string? AttachmentFileName { get; set; }
        public string? AttachmentContentType { get; set; }
        public byte[]? AttachmentBytes { get; set; }

        public decimal TaxableNet => DiscountType == DiscountType.Percent
            ? Math.Round(Quantity * UnitPrice * (1 - DiscountValue / 100m), 2, MidpointRounding.AwayFromZero)
            : Math.Round(Math.Max(0, Quantity * UnitPrice - DiscountValue), 2, MidpointRounding.AwayFromZero);
        public decimal Net => TaxableNet + Math.Round(Quantity * (GovtFee + BankCharge), 2, MidpointRounding.AwayFromZero);
        public decimal Vat => Math.Round(TaxableNet * VatRate, 2, MidpointRounding.AwayFromZero);
        public decimal Gross => Net + Vat;
    }
}
