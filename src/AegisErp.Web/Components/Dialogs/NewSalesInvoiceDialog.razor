@inject SalesInvoiceService InvoiceSvc
@inject CustomerService CustomerSvc
@inject ChartOfAccountsService Coa
@inject LedgerService Ledger
@inject ItemService ItemSvc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? $"Edit {Existing!.InvoiceNo}" : "New Sales Invoice")</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Accounts Receivable</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudSelect T="int" Value="_customerId" ValueChanged="OnCustomerChanged" Label="Customer" Dense="true">
                    <MudSelectItem Value="0">— select —</MudSelectItem>
                    @if (_customers is not null)
                    {
                        @foreach (var c in _customers)
                        {
                            <MudSelectItem Value="c.Id">@c.Code — @c.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker Date="_date" DateChanged="OnDateChanged" Label="Invoice date" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField Value="@_dueLabel" Label="Due date" ReadOnly="true" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="int" @bind-Value="_periodId" Label="Period" Dense="true">
                    @if (_periods is not null)
                    {
                        @foreach (var p in _periods)
                        {
                            <MudSelectItem Value="p.Id">@p.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_narration" Label="Narration" Placeholder="Defaults to 'Sales invoice — customer'" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="_customerPoNo" Label="Customer PO No." Placeholder="Optional" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="_deliveryNoteRef" Label="Delivery Note Ref." Placeholder="Optional" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="_salesOrderRef" Label="Sales Order Ref." Placeholder="Optional" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Notes" Lines="2" Placeholder="Payment terms, delivery notes… (shown on the printed invoice)" />
            </MudItem>
        </MudGrid>

        <MudTable Items="_lines" Dense="true" Bordered="true" Elevation="0" Class="mt-4 mb-2">
            <HeaderContent>
                <MudTh Style="width:40px">#</MudTh>
                <MudTh Style="width:160px">Item</MudTh>
                <MudTh>Description</MudTh>
                <MudTh>Revenue Account</MudTh>
                <MudTh>Cost Center</MudTh>
                <MudTh Style="width:90px;text-align:right">Qty</MudTh>
                <MudTh Style="width:80px">UOM</MudTh>
                <MudTh Style="width:120px;text-align:right">Unit Price</MudTh>
                <MudTh Style="width:90px;text-align:right">Disc %</MudTh>
                <MudTh Style="width:100px">VAT</MudTh>
                <MudTh Style="width:120px;text-align:right">Line Total</MudTh>
                <MudTh Style="width:48px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@(_lines.IndexOf(context) + 1)</MudTd>
                <MudTd>
                    <MudSelect T="int" Value="context.ItemId ?? 0" ValueChanged="v => OnItemChanged(context, v)" Dense="true" Margin="Margin.Dense" Clearable="true">
                        <MudSelectItem Value="0">— none —</MudSelectItem>
                        @if (_items is not null)
                        {
                            @foreach (var it in _items)
                            {
                                <MudSelectItem Value="it.Id">@it.Code — @it.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudTd>
                <MudTd><MudTextField @bind-Value="context.Description" Margin="Margin.Dense" Placeholder="Service / item" /></MudTd>
                <MudTd>
                    <MudSelect T="int" @bind-Value="context.RevenueAccountId" Dense="true" Margin="Margin.Dense">
                        <MudSelectItem Value="0">— select —</MudSelectItem>
                        @if (_revenueAccounts is not null)
                        {
                            @foreach (var a in _revenueAccounts)
                            {
                                <MudSelectItem Value="a.Id">@a.Code — @a.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudTd>
                <MudTd>
                    <MudSelect T="int?" @bind-Value="context.CostCenterId" Dense="true" Margin="Margin.Dense" Clearable="true">
                        @if (_costCenters is not null)
                        {
                            @foreach (var c in _costCenters)
                            {
                                <MudSelectItem T="int?" Value="c.Id">@c.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudTd>
                <MudTd><MudNumericField T="decimal" @bind-Value="context.Quantity" Min="0" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                <MudTd><MudTextField @bind-Value="context.Uom" Margin="Margin.Dense" Placeholder="unit" /></MudTd>
                <MudTd><MudNumericField T="decimal" @bind-Value="context.UnitPrice" Min="0" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                <MudTd><MudNumericField T="decimal" @bind-Value="context.DiscountPercent" Min="0" Max="100" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                <MudTd>
                    <MudSelect T="decimal" @bind-Value="context.VatRate" Dense="true" Margin="Margin.Dense">
                        <MudSelectItem Value="0.05m">5%</MudSelectItem>
                        <MudSelectItem Value="0m">0%</MudSelectItem>
                    </MudSelect>
                </MudTd>
                <MudTd Style="text-align:right;font-weight:600">@context.Gross.ToString("N2")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => RemoveLine(context))" Disabled="_lines.Count <= 1" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        <MudItem xs="12" Class="mb-2">
            <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".pdf,.jpg,.jpeg,.png">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile">
                        @(_attachmentFileName is null ? "Attach supporting document" : $"Replace: {_attachmentFileName}")
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            @if (_attachmentFileName is not null)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary ml-2">@_attachmentFileName selected (PDF, JPG, PNG — max 5 MB)</MudText>
            }
        </MudItem>

        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" OnClick="AddLine">Add line</MudButton>
            <MudSpacer />
            <MudText Class="mr-4">Net: <b>@TotalNet.ToString("N2")</b></MudText>
            <MudText Class="mr-4">VAT: <b>@TotalVat.ToString("N2")</b></MudText>
            <MudText Class="mr-4">Total: <b>AED @TotalGross.ToString("N2")</b></MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Drafts"
                   Disabled="@(!CanSaveDraft || _posting)" OnClick="SaveDraft">Save as Draft</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PostAdd"
                   Disabled="@(!CanPost || _posting)" OnClick="Post">Post Invoice</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Edit mode: update this draft in place instead of creating a new invoice. Only ever
    /// passed for a Draft invoice — posted invoices are immutable and reversed via Credit Note.</summary>
    [Parameter] public SalesInvoice? Existing { get; set; }
    /// <summary>Clone mode: seed a brand-new invoice's initial Customer/Narration/Lines from this one.</summary>
    [Parameter] public SalesInvoice? CloneFrom { get; set; }

    private bool IsEdit => Existing is not null;

    private List<Customer>? _customers;
    private List<Account>? _revenueAccounts;
    private List<CostCenter>? _costCenters;
    private List<FiscalPeriod>? _periods;
    private List<Item>? _items;

    private int _customerId;
    private DateTime? _date = DateTime.Today;
    private int _periodId;
    private string? _narration;
    private string? _customerPoNo;
    private string? _deliveryNoteRef;
    private string? _salesOrderRef;
    private string? _notes;
    private bool _posting;
    private string _dueLabel = "—";

    private string? _attachmentFileName;
    private string? _attachmentContentType;
    private byte[]? _attachmentBytes;

    private readonly List<LineVm> _lines = new() { new() };

    private decimal TotalNet => _lines.Sum(l => l.Net);
    private decimal TotalVat => _lines.Sum(l => l.Vat);
    private decimal TotalGross => _lines.Sum(l => l.Gross);
    private bool CanPost => _customerId > 0 && _periodId > 0 && TotalGross > 0
                            && _lines.All(l => l.RevenueAccountId > 0 && !string.IsNullOrWhiteSpace(l.Description));
    // Looser than CanPost: a draft can be saved before every account/price detail is finalized.
    private bool CanSaveDraft => _customerId > 0 && _periodId > 0
                            && _lines.Any(l => !string.IsNullOrWhiteSpace(l.Description));

    protected override async Task OnInitializedAsync()
    {
        _customers = await CustomerSvc.GetAllAsync(activeOnly: true);
        var accounts = await Coa.GetAllAsync(postableOnly: true);
        _revenueAccounts = accounts.Where(a => a.Type == AccountType.Income).ToList();
        _costCenters = await Coa.GetCostCentersAsync();
        _periods = await Ledger.GetPeriodsAsync();
        _items = await ItemSvc.GetAllAsync(activeOnly: true);

        var seed = Existing ?? CloneFrom;
        if (seed is not null)
        {
            _customerId = seed.CustomerId;
            _date = Existing is not null ? seed.Date.ToDateTime(TimeOnly.MinValue) : DateTime.Today;
            _narration = seed.Narration;
            _customerPoNo = seed.CustomerPoNo;
            _deliveryNoteRef = seed.DeliveryNoteRef;
            _salesOrderRef = seed.SalesOrderRef;
            _notes = seed.Notes;
            if (Existing is not null) _attachmentFileName = Existing.AttachmentFileName;
            _lines.Clear();
            foreach (var l in seed.Lines.OrderBy(l => l.LineNo))
                _lines.Add(new LineVm
                {
                    ItemId = l.ItemId,
                    Description = l.Description,
                    RevenueAccountId = l.RevenueAccountId,
                    CostCenterId = l.CostCenterId,
                    Quantity = l.Quantity,
                    UnitPrice = l.UnitPrice,
                    VatRate = l.VatRate,
                    DiscountPercent = l.DiscountPercent,
                    Uom = l.Uom,
                });
            UpdateDueLabel();
        }

        SyncPeriodToDate();
    }

    /// <summary>
    /// Picking an item pre-fills its description, price and VAT. The revenue account is set to
    /// whichever account this item was last billed to (falling back to the item's own default),
    /// so the user doesn't have to re-pick it every time the same item recurs on an invoice.
    /// </summary>
    private async Task OnItemChanged(LineVm line, int itemId)
    {
        line.ItemId = itemId == 0 ? null : itemId;
        var item = _items?.FirstOrDefault(i => i.Id == itemId);
        if (item is null) return;

        line.Description = item.SalesDescription ?? item.Name;
        line.UnitPrice = item.SellingPrice;
        line.Uom = item.Unit;
        if (item.TaxCode is not null) line.VatRate = item.TaxCode.Rate;

        var lastAccountId = await InvoiceSvc.GetLastRevenueAccountForItemAsync(itemId);
        line.RevenueAccountId = lastAccountId ?? item.SalesAccountId ?? 0;
    }

    private async Task OnFileSelected(IBrowserFile file)
    {
        if (file.Size > SalesInvoiceService.MaxAttachmentBytes)
        {
            Snackbar.Add($"That file is too large — the limit is {SalesInvoiceService.MaxAttachmentBytes / (1024 * 1024)} MB.", Severity.Error);
            return;
        }

        using var stream = file.OpenReadStream(SalesInvoiceService.MaxAttachmentBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _attachmentBytes = ms.ToArray();
        _attachmentFileName = file.Name;
        _attachmentContentType = file.ContentType;
    }

    private void OnCustomerChanged(int id) { _customerId = id; UpdateDueLabel(); }
    private void OnDateChanged(DateTime? d) { _date = d; SyncPeriodToDate(); UpdateDueLabel(); }

    private void SyncPeriodToDate()
    {
        if (_periods is null || _date is null) return;
        var d = DateOnly.FromDateTime(_date.Value);
        var match = _periods.FirstOrDefault(p => d >= p.StartDate && d <= p.EndDate);
        if (match is not null) _periodId = match.Id;
        else if (_periodId == 0) _periodId = _periods.LastOrDefault()?.Id ?? 0;
    }

    private void UpdateDueLabel()
    {
        var c = _customers?.FirstOrDefault(x => x.Id == _customerId);
        _dueLabel = c is null || _date is null
            ? "—"
            : DateOnly.FromDateTime(_date.Value).AddDays(c.PaymentTermsDays).ToString("yyyy-MM-dd");
    }

    private void AddLine() => _lines.Add(new());
    private void RemoveLine(LineVm l) { if (_lines.Count > 1) _lines.Remove(l); }

    private async Task Post()
    {
        _posting = true;
        try
        {
            var userName = AuthState is not null ? (await AuthState).User.Identity?.Name ?? "System Admin" : "System Admin";
            var inputs = _lines.Select(l => new InvoiceLineInput(
                l.Description, l.RevenueAccountId, l.CostCenterId, l.Quantity, l.UnitPrice, l.VatRate, l.ItemId,
                l.DiscountPercent, l.Uom));

            SalesInvoice inv;
            if (IsEdit)
            {
                await InvoiceSvc.UpdateDraftAsync(Existing!.Id, _customerId,
                    DateOnly.FromDateTime(_date ?? DateTime.Today), _periodId, _narration, inputs,
                    _customerPoNo, _deliveryNoteRef, _salesOrderRef, _notes);
                inv = await InvoiceSvc.PostDraftAsync(Existing!.Id, userName, DateTime.UtcNow);
            }
            else
            {
                inv = await InvoiceSvc.CreateAndPostAsync(
                    _customerId, DateOnly.FromDateTime(_date ?? DateTime.Today), _periodId,
                    _narration, userName, inputs, DateTime.UtcNow,
                    _customerPoNo, _deliveryNoteRef, _salesOrderRef, _notes);
            }
            if (_attachmentBytes is not null)
                await InvoiceSvc.SetAttachmentAsync(inv.Id, _attachmentFileName!, _attachmentContentType ?? "application/octet-stream", _attachmentBytes);

            Snackbar.Add($"Posted {inv.InvoiceNo} — GL voucher {inv.JournalVoucher?.VoucherNo} generated.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(inv.Id));
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _posting = false; }
    }

    private async Task SaveDraft()
    {
        _posting = true;
        try
        {
            var userName = AuthState is not null ? (await AuthState).User.Identity?.Name ?? "System Admin" : "System Admin";
            var inputs = _lines.Select(l => new InvoiceLineInput(
                l.Description, l.RevenueAccountId, l.CostCenterId, l.Quantity, l.UnitPrice, l.VatRate, l.ItemId,
                l.DiscountPercent, l.Uom));

            SalesInvoice inv;
            if (IsEdit)
            {
                inv = await InvoiceSvc.UpdateDraftAsync(Existing!.Id, _customerId,
                    DateOnly.FromDateTime(_date ?? DateTime.Today), _periodId, _narration, inputs,
                    _customerPoNo, _deliveryNoteRef, _salesOrderRef, _notes);
                Snackbar.Add($"Updated {inv.InvoiceNo}.", Severity.Success);
            }
            else
            {
                inv = await InvoiceSvc.CreateDraftAsync(
                    _customerId, DateOnly.FromDateTime(_date ?? DateTime.Today), _periodId,
                    _narration, userName, inputs, DateTime.UtcNow,
                    _customerPoNo, _deliveryNoteRef, _salesOrderRef, _notes);
                Snackbar.Add($"Saved {inv.InvoiceNo} as a draft.", Severity.Success);
            }
            if (_attachmentBytes is not null)
                await InvoiceSvc.SetAttachmentAsync(inv.Id, _attachmentFileName!, _attachmentContentType ?? "application/octet-stream", _attachmentBytes);

            MudDialog.Close(DialogResult.Ok(inv.Id));
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _posting = false; }
    }

    private void Cancel() => MudDialog.Cancel();

    private class LineVm
    {
        public int? ItemId { get; set; }
        public string Description { get; set; } = "";
        public int RevenueAccountId { get; set; }
        public int? CostCenterId { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal VatRate { get; set; } = 0.05m;
        public decimal DiscountPercent { get; set; }
        public string? Uom { get; set; }

        public decimal Net => Math.Round(Quantity * UnitPrice * (1 - DiscountPercent / 100m), 2, MidpointRounding.AwayFromZero);
        public decimal Vat => Math.Round(Net * VatRate, 2, MidpointRounding.AwayFromZero);
        public decimal Gross => Net + Vat;
    }
}
