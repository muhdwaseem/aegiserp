@inject LeadService LeadSvc
@inject CompanyService CompanySvc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? $"Edit {Existing!.Name}" : "New Lead")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_name" Label="Name" Required="true" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_companyName" Label="Company Name" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_mobile" Label="Mobile" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_source" Label="Source" Placeholder="e.g. Referral, Website, Walk-in" /></MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="decimal?" @bind-Value="_estimatedValue" Label="Estimated Value" HideSpinButtons="true" Min="0" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="string" @bind-Value="_assignedTo" Label="Assigned To" Clearable="true">
                    @if (_salespersons is not null)
                    {
                        @foreach (var s in _salespersons)
                        {
                            <MudSelectItem Value="s">@s</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_notes" Label="Notes" Lines="2" /></MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [Parameter] public Lead? Existing { get; set; }
    private bool IsEdit => Existing is not null;

    private List<string>? _salespersons;

    private string _name = "";
    private string? _companyName;
    private string? _mobile;
    private string? _email;
    private string? _source;
    private decimal? _estimatedValue;
    private string? _assignedTo;
    private string? _notes;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var company = await CompanySvc.GetAsync();
            _salespersons = company.Salespersons.Select(s => s.Name).OrderBy(n => n).ToList();
        }
        catch (PostingException) { _salespersons = new(); }

        if (Existing is { } l)
        {
            _name = l.Name;
            _companyName = l.CompanyName;
            _mobile = l.Mobile;
            _email = l.Email;
            _source = l.Source;
            _estimatedValue = l.EstimatedValue;
            _assignedTo = l.AssignedTo;
            _notes = l.Notes;
        }
    }

    private async Task Save()
    {
        try
        {
            var input = new LeadInput(_name, _companyName, _mobile, _email, _source, _estimatedValue, _assignedTo, _notes);

            if (IsEdit)
            {
                await LeadSvc.UpdateAsync(Existing!.Id, input);
                Snackbar.Add("Lead updated.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(Existing.Id));
            }
            else
            {
                var userName = AuthState is not null ? (await AuthState).User.Identity?.Name ?? "System Admin" : "System Admin";
                var created = await LeadSvc.CreateAsync(input, userName, DateTime.UtcNow);
                Snackbar.Add("Lead created.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(created.Id));
            }
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
