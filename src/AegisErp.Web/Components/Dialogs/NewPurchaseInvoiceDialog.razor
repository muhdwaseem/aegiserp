@using Microsoft.AspNetCore.Components.Forms
@inject PurchaseInvoiceService InvoiceSvc
@inject VendorService VendorSvc
@inject ChartOfAccountsService Coa
@inject LedgerService Ledger
@inject ItemService ItemSvc
@inject CompanyService CompanySvc
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">New Purchase Invoice</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Accounts Payable</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudSelect T="int" Value="_vendorId" ValueChanged="OnVendorChanged" Label="@(_proServiceFormat ? "Supplier" : "Vendor")" Dense="true">
                    <MudSelectItem Value="0">— select —</MudSelectItem>
                    @if (_vendors is not null)
                    {
                        @foreach (var v in _vendors)
                        {
                            <MudSelectItem Value="v.Id">@v.Code — @v.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudDatePicker Date="_date" DateChanged="OnDateChanged" Label="Invoice date" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField Value="@_dueLabel" Label="Due date" ReadOnly="true" />
            </MudItem>
            <MudItem xs="12" sm="@(_proServiceFormat ? 4 : 2)">
                <MudTextField @bind-Value="_vendorRef" Label="@(_proServiceFormat ? "Supplier Invoice #" : "Vendor Ref")" Placeholder="@(_proServiceFormat ? "Optional" : "Bill no.")" />
            </MudItem>
            @if (!_proServiceFormat)
            {
                <MudItem xs="12" sm="2">
                    <MudTextField @bind-Value="_lpoNo" Label="LPO No." Placeholder="Optional" />
                </MudItem>
            }
            @if (_proServiceFormat)
            {
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_narration" Label="Description" Placeholder="What this bill is for" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="int?" @bind-Value="_headerCostCenterId" Label="Cost Center" Dense="true" Clearable="true">
                        @if (_costCenters is not null)
                        {
                            @foreach (var c in _costCenters)
                            {
                                <MudSelectItem T="int?" Value="c.Id">@c.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
            }
            else
            {
                <MudItem xs="12">
                    <MudTextField @bind-Value="_narration" Label="Narration" Placeholder="Defaults to 'Purchase invoice — vendor'" />
                </MudItem>
            }
        </MudGrid>

        <div class="line-table-scroll">
        @if (_proServiceFormat)
        {
            <MudTable Items="_lines" Dense="true" Bordered="true" Elevation="0" Class="mt-4 mb-2">
                <HeaderContent>
                    <MudTh Style="width:40px">#</MudTh>
                    <MudTh Style="min-width:160px">Service</MudTh>
                    <MudTh Style="min-width:180px">Description</MudTh>
                    <MudTh Style="min-width:220px">Expense Account</MudTh>
                    <MudTh Style="min-width:120px;text-align:right">Non-Taxable Amt</MudTh>
                    <MudTh Style="min-width:120px;text-align:right">Taxable Amt</MudTh>
                    <MudTh Style="min-width:100px">VAT</MudTh>
                    <MudTh Style="min-width:110px;text-align:right">VAT Amt</MudTh>
                    <MudTh Style="min-width:130px;text-align:right">Total</MudTh>
                    <MudTh Style="width:48px"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@(_lines.IndexOf(context) + 1)</MudTd>
                    <MudTd>
                        <MudSelect T="int" Value="context.ItemId ?? 0" ValueChanged="v => OnItemChanged(context, v)" Dense="true" Margin="Margin.Dense" Clearable="true">
                            <MudSelectItem Value="0">— Custom —</MudSelectItem>
                            @if (_items is not null)
                            {
                                @foreach (var it in _items)
                                {
                                    <MudSelectItem Value="it.Id">@it.Code — @it.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd><MudTextField @bind-Value="context.Description" Margin="Margin.Dense" Placeholder="Service / fee" /></MudTd>
                    <MudTd>
                        <MudSelect T="int" @bind-Value="context.ExpenseAccountId" Dense="true" Margin="Margin.Dense">
                            <MudSelectItem Value="0">— select —</MudSelectItem>
                            @if (_expenseAccounts is not null)
                            {
                                @foreach (var a in _expenseAccounts)
                                {
                                    <MudSelectItem Value="a.Id">@a.Code — @a.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd><MudNumericField T="decimal" @bind-Value="context.NonTaxableAmount" Min="0" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                    <MudTd><MudNumericField T="decimal" @bind-Value="context.UnitPrice" Min="0" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                    <MudTd>
                        <MudSelect T="decimal" @bind-Value="context.VatRate" Dense="true" Margin="Margin.Dense">
                            <MudSelectItem Value="0m">Exempt (0%)</MudSelectItem>
                            <MudSelectItem Value="0.05m">5%</MudSelectItem>
                        </MudSelect>
                    </MudTd>
                    <MudTd Style="text-align:right">@context.Vat.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right;font-weight:600">@context.Gross.ToString("N2")</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => RemoveLine(context))" Disabled="_lines.Count <= 1" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudTable Items="_lines" Dense="true" Bordered="true" Elevation="0" Class="mt-4 mb-2">
                <HeaderContent>
                    <MudTh Style="width:40px">#</MudTh>
                    <MudTh Style="min-width:180px">Description</MudTh>
                    <MudTh Style="min-width:220px">Expense / Asset Account</MudTh>
                    <MudTh Style="min-width:160px">Cost Center</MudTh>
                    <MudTh Style="min-width:90px;text-align:right">Qty</MudTh>
                    <MudTh Style="min-width:130px;text-align:right">Unit Price</MudTh>
                    <MudTh Style="min-width:90px">VAT</MudTh>
                    <MudTh Style="min-width:130px;text-align:right">Line Total</MudTh>
                    <MudTh Style="width:48px"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@(_lines.IndexOf(context) + 1)</MudTd>
                    <MudTd><MudTextField @bind-Value="context.Description" Margin="Margin.Dense" Placeholder="Service / item" /></MudTd>
                    <MudTd>
                        <MudSelect T="int" @bind-Value="context.ExpenseAccountId" Dense="true" Margin="Margin.Dense">
                            <MudSelectItem Value="0">— select —</MudSelectItem>
                            @if (_expenseAccounts is not null)
                            {
                                @foreach (var a in _expenseAccounts)
                                {
                                    <MudSelectItem Value="a.Id">@a.Code — @a.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd>
                        <MudSelect T="int?" @bind-Value="context.CostCenterId" Dense="true" Margin="Margin.Dense" Clearable="true">
                            @if (_costCenters is not null)
                            {
                                @foreach (var c in _costCenters)
                                {
                                    <MudSelectItem T="int?" Value="c.Id">@c.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd><MudNumericField T="decimal" @bind-Value="context.Quantity" Min="0" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                    <MudTd><MudNumericField T="decimal" @bind-Value="context.UnitPrice" Min="0" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                    <MudTd>
                        <MudSelect T="decimal" @bind-Value="context.VatRate" Dense="true" Margin="Margin.Dense">
                            <MudSelectItem Value="0.05m">5%</MudSelectItem>
                            <MudSelectItem Value="0m">0%</MudSelectItem>
                        </MudSelect>
                    </MudTd>
                    <MudTd Style="text-align:right;font-weight:600">@context.Gross.ToString("N2")</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => RemoveLine(context))" Disabled="_lines.Count <= 1" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        </div>

        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" OnClick="AddLine">Add line</MudButton>
            <MudSpacer />
            @if (_proServiceFormat)
            {
                <MudText Class="mr-4">Non-Taxable: <b>@TotalNonTaxable.ToString("N2")</b></MudText>
                <MudText Class="mr-4">Taxable: <b>@TotalTaxable.ToString("N2")</b></MudText>
                <MudText Class="mr-4">VAT: <b>@TotalVat.ToString("N2")</b></MudText>
                <MudText Class="mr-4">Grand Total: <b>AED @TotalGross.ToString("N2")</b></MudText>
            }
            else
            {
                <MudText Class="mr-4">Net: <b>@TotalNet.ToString("N2")</b></MudText>
                <MudText Class="mr-4">VAT: <b>@TotalVat.ToString("N2")</b></MudText>
                <MudText Class="mr-4">Total: <b>AED @TotalGross.ToString("N2")</b></MudText>
            }
        </MudStack>

        @* Notes / Attachment sit below the line items, same as Sales Invoice — not up top before
           the bill's own detail has even been entered. *@
        <MudGrid Class="mt-2">
            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Notes" Lines="2" Placeholder="Internal note about this bill (payment arrangement, dispute, etc.)" />
            </MudItem>
            <MudItem xs="12">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudFileUpload T="IBrowserFile" FilesChanged="OnInvoiceFileSelected" Accept=".pdf,.jpg,.jpeg,.png">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile" Size="Size.Small">
                                Attach Document
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    @if (_invoiceAttachmentFileName is not null)
                    {
                        <MudChip T="string" Size="Size.Small" OnClose="RemoveInvoiceAttachment" CloseIcon="@Icons.Material.Filled.Close">@_invoiceAttachmentFileName</MudChip>
                    }
                </MudStack>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PostAdd"
                   Disabled="@(!CanPost || _posting)" OnClick="Post">Post Invoice</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Clone mode: seed a brand-new invoice's initial Vendor/Narration/Lines from this one. No vendor ref carried over.</summary>
    [Parameter] public PurchaseInvoice? CloneFrom { get; set; }

    private List<Vendor>? _vendors;
    private List<Account>? _expenseAccounts;
    private List<CostCenter>? _costCenters;
    private List<FiscalPeriod>? _periods;
    private List<Item>? _items;

    private bool _proServiceFormat;
    private int? _headerCostCenterId;

    private int _vendorId;
    private string? _vendorRef;
    private string? _lpoNo;
    private DateTime? _date = DateTime.Today;
    private int _periodId;
    private string? _narration;
    private string? _notes;
    private bool _posting;
    private string _dueLabel = "—";

    private string? _invoiceAttachmentFileName;
    private string? _invoiceAttachmentContentType;
    private byte[]? _invoiceAttachmentBytes;

    private readonly List<LineVm> _lines = new() { new() };

    private decimal TotalNet => _lines.Sum(l => l.Net);
    private decimal TotalVat => _lines.Sum(l => l.Vat);
    private decimal TotalGross => _lines.Sum(l => l.Gross);
    private decimal TotalNonTaxable => _lines.Sum(l => l.NonTaxableAmount);
    private decimal TotalTaxable => _lines.Sum(l => l.Quantity * l.UnitPrice);
    private bool CanPost => _vendorId > 0 && _periodId > 0 && TotalGross > 0
                            && _lines.All(l => l.ExpenseAccountId > 0 && !string.IsNullOrWhiteSpace(l.Description));

    protected override async Task OnInitializedAsync()
    {
        _vendors = await VendorSvc.GetAllAsync(activeOnly: true);
        var accounts = await Coa.GetAllAsync(postableOnly: true);
        // Purchases are charged to expense or (capitalised) asset accounts.
        _expenseAccounts = accounts.Where(a => a.Type == AccountType.Expense || a.Type == AccountType.Asset).ToList();
        _costCenters = await Coa.GetCostCentersAsync();
        _periods = await Ledger.GetPeriodsAsync();
        _items = await ItemSvc.GetAllAsync(activeOnly: true);

        CompanySetup? company = null;
        try { company = await CompanySvc.GetAsync(); }
        catch (PostingException) { /* no company selected yet — keep the built-in defaults */ }
        _proServiceFormat = company?.ProServiceModeEnabled ?? false;
        if (_proServiceFormat && CloneFrom is null) _lines[0].VatRate = 0m;

        if (CloneFrom is not null)
        {
            _vendorId = CloneFrom.VendorId;
            _narration = CloneFrom.Narration;
            _notes = CloneFrom.Notes;
            _headerCostCenterId = CloneFrom.CostCenterId;
            _lines.Clear();
            foreach (var l in CloneFrom.Lines.OrderBy(l => l.LineNo))
                _lines.Add(new LineVm
                {
                    Description = l.Description,
                    ExpenseAccountId = l.ExpenseAccountId,
                    CostCenterId = l.CostCenterId,
                    Quantity = l.Quantity,
                    UnitPrice = l.UnitPrice,
                    VatRate = l.VatRate,
                    NonTaxableAmount = l.NonTaxableAmount,
                });
            UpdateDueLabel();
        }

        SyncPeriodToDate();
    }

    /// <summary>Picking a service pre-fills its description, expense account and VAT from the
    /// item's own purchase-side fields — mirrors Sales Invoice's <c>OnItemChanged</c>.</summary>
    private void OnItemChanged(LineVm line, int itemId)
    {
        line.ItemId = itemId == 0 ? null : itemId;
        var item = _items?.FirstOrDefault(i => i.Id == itemId);
        if (item is null) return;

        line.Description = item.PurchaseDescription ?? item.Name;
        line.UnitPrice = item.CostPrice ?? line.UnitPrice;
        line.ExpenseAccountId = item.PurchaseAccountId ?? line.ExpenseAccountId;
        line.VatRate = item.TaxCode?.Rate ?? line.VatRate;
    }

    private void OnVendorChanged(int id) { _vendorId = id; UpdateDueLabel(); }
    private void OnDateChanged(DateTime? d) { _date = d; SyncPeriodToDate(); UpdateDueLabel(); }

    private void SyncPeriodToDate()
    {
        if (_periods is null || _date is null) return;
        var d = DateOnly.FromDateTime(_date.Value);
        var match = _periods.FirstOrDefault(p => d >= p.StartDate && d <= p.EndDate);
        if (match is not null) _periodId = match.Id;
        else if (_periodId == 0) _periodId = _periods.LastOrDefault()?.Id ?? 0;
    }

    private void UpdateDueLabel()
    {
        var v = _vendors?.FirstOrDefault(x => x.Id == _vendorId);
        _dueLabel = v is null || _date is null
            ? "—"
            : DateOnly.FromDateTime(_date.Value).AddDays(v.PaymentTermsDays).ToString("yyyy-MM-dd");
    }

    private void AddLine() => _lines.Add(_proServiceFormat ? new() { VatRate = 0m } : new());
    private void RemoveLine(LineVm l) { if (_lines.Count > 1) _lines.Remove(l); }

    private async Task Post()
    {
        _posting = true;
        try
        {
            var userName = AuthState is not null ? (await AuthState).User.Identity?.Name ?? "System Admin" : "System Admin";
            var inputs = _lines.Select(l => new PurchaseLineInput(
                l.Description, l.ExpenseAccountId, l.CostCenterId, l.Quantity, l.UnitPrice, l.VatRate, l.NonTaxableAmount));

            var inv = await InvoiceSvc.CreateAndPostAsync(
                _vendorId, _vendorRef, DateOnly.FromDateTime(_date ?? DateTime.Today), _periodId,
                _narration, userName, inputs, DateTime.UtcNow, _lpoNo, _notes,
                _proServiceFormat ? _headerCostCenterId : null);

            if (_invoiceAttachmentBytes is not null)
                await InvoiceSvc.SetAttachmentAsync(inv.Id, _invoiceAttachmentFileName!,
                    _invoiceAttachmentContentType ?? "application/octet-stream", _invoiceAttachmentBytes);

            Snackbar.Add($"Posted {inv.InvoiceNo} — GL voucher {inv.JournalVoucher?.VoucherNo} generated.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(inv.Id));
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _posting = false; }
    }

    private async Task OnInvoiceFileSelected(IBrowserFile file)
    {
        if (file.Size > PurchaseInvoiceService.MaxAttachmentBytes)
        {
            Snackbar.Add($"That file is too large — the limit is {PurchaseInvoiceService.MaxAttachmentBytes / (1024 * 1024)} MB.", Severity.Error);
            return;
        }

        using var stream = file.OpenReadStream(PurchaseInvoiceService.MaxAttachmentBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _invoiceAttachmentBytes = ms.ToArray();
        _invoiceAttachmentFileName = file.Name;
        _invoiceAttachmentContentType = file.ContentType;
    }

    private void RemoveInvoiceAttachment()
    {
        _invoiceAttachmentFileName = null;
        _invoiceAttachmentContentType = null;
        _invoiceAttachmentBytes = null;
    }

    private void Cancel() => MudDialog.Cancel();

    private class LineVm
    {
        public int? ItemId { get; set; }
        public string Description { get; set; } = "";
        public int ExpenseAccountId { get; set; }
        public int? CostCenterId { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal VatRate { get; set; } = 0.05m;

        /// <summary>Only ever nonzero in the PRO Service format — a flat amount this line
        /// carries no VAT on at all (e.g. a government fee disbursement).</summary>
        public decimal NonTaxableAmount { get; set; }

        private decimal TaxableNet => Math.Round(Quantity * UnitPrice, 2, MidpointRounding.AwayFromZero);
        public decimal Net => TaxableNet + NonTaxableAmount;
        public decimal Vat => Math.Round(TaxableNet * VatRate, 2, MidpointRounding.AwayFromZero);
        public decimal Gross => Net + Vat;
    }
}
