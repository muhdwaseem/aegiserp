@inject CreditNoteService CreditNoteSvc
@inject CustomerService CustomerSvc
@inject SalesInvoiceService InvoiceSvc
@inject ChartOfAccountsService Coa
@inject LedgerService Ledger
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">New Credit Note</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Accounts Receivable</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Picking an invoice pulls its lines in automatically to edit/adjust. Settlement method
            controls where the credit lands: reduce the invoice's balance, leave it on account, or
            refund the customer in cash straight away.
        </MudText>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudSelect T="int" Value="_customerId" ValueChanged="OnCustomerChanged" Label="Customer" Dense="true">
                    <MudSelectItem Value="0">— select —</MudSelectItem>
                    @if (_customers is not null)
                    {
                        @foreach (var c in _customers)
                        {
                            <MudSelectItem Value="c.Id">@c.Code — @c.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="int" Value="_invoiceId" ValueChanged="OnInvoiceChanged" Label="Against invoice (optional)" Dense="true">
                    <MudSelectItem Value="0">On account</MudSelectItem>
                    @foreach (var inv in _openInvoices)
                    {
                        <MudSelectItem Value="inv.Id">@inv.InvoiceNo — outstanding @inv.Outstanding.ToString("N2")</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="CreditNoteSettlementMethod" @bind-Value="_settlementMethod" Label="Settlement Method" Dense="true">
                    <MudSelectItem Value="CreditNoteSettlementMethod.ApplyToInvoice" Disabled="_invoiceId == 0">Apply to open invoice</MudSelectItem>
                    <MudSelectItem Value="CreditNoteSettlementMethod.CreditOnAccount">Credit on account</MudSelectItem>
                    <MudSelectItem Value="CreditNoteSettlementMethod.CashRefund">Cash refund</MudSelectItem>
                </MudSelect>
            </MudItem>
            @if (_settlementMethod == CreditNoteSettlementMethod.CashRefund)
            {
                <MudItem xs="12" sm="4">
                    <MudSelect T="int" @bind-Value="_bankAccountId" Label="Refund From" Dense="true">
                        <MudSelectItem Value="0">— select —</MudSelectItem>
                        @if (_bankAccounts is not null)
                        {
                            @foreach (var a in _bankAccounts)
                            {
                                <MudSelectItem Value="a.Id">@a.Code — @a.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_reason" Label="Reason" Placeholder="Return / discount / correction" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker Date="_date" DateChanged="OnDateChanged" Label="Date" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="int" @bind-Value="_periodId" Label="Period" Dense="true">
                    @if (_periods is not null)
                    {
                        @foreach (var p in _periods)
                        {
                            <MudSelectItem Value="p.Id">@p.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_narration" Label="Narration" Placeholder="Defaults to 'Credit note — customer'" />
            </MudItem>
        </MudGrid>

        <MudTable Items="_lines" Dense="true" Bordered="true" Elevation="0" Class="mt-4 mb-2">
            <HeaderContent>
                <MudTh Style="width:40px">#</MudTh>
                <MudTh>Description</MudTh>
                <MudTh>Revenue Account</MudTh>
                <MudTh>Cost Center</MudTh>
                <MudTh Style="width:90px;text-align:right">Qty</MudTh>
                <MudTh Style="width:120px;text-align:right">Unit Price</MudTh>
                <MudTh Style="width:100px">VAT</MudTh>
                <MudTh Style="width:120px;text-align:right">Line Total</MudTh>
                <MudTh Style="width:48px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@(_lines.IndexOf(context) + 1)</MudTd>
                <MudTd><MudTextField @bind-Value="context.Description" Margin="Margin.Dense" Placeholder="Service / item" /></MudTd>
                <MudTd>
                    <MudSelect T="int" @bind-Value="context.RevenueAccountId" Dense="true" Margin="Margin.Dense">
                        <MudSelectItem Value="0">— select —</MudSelectItem>
                        @if (_revenueAccounts is not null)
                        {
                            @foreach (var a in _revenueAccounts)
                            {
                                <MudSelectItem Value="a.Id">@a.Code — @a.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudTd>
                <MudTd>
                    <MudSelect T="int?" @bind-Value="context.CostCenterId" Dense="true" Margin="Margin.Dense" Clearable="true">
                        @if (_costCenters is not null)
                        {
                            @foreach (var c in _costCenters)
                            {
                                <MudSelectItem T="int?" Value="c.Id">@c.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudTd>
                <MudTd><MudNumericField T="decimal" @bind-Value="context.Quantity" Min="0" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                <MudTd><MudNumericField T="decimal" @bind-Value="context.UnitPrice" Min="0" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                <MudTd>
                    <MudSelect T="decimal" @bind-Value="context.VatRate" Dense="true" Margin="Margin.Dense">
                        <MudSelectItem Value="0.05m">5%</MudSelectItem>
                        <MudSelectItem Value="0m">0%</MudSelectItem>
                    </MudSelect>
                </MudTd>
                <MudTd Style="text-align:right;font-weight:600">@context.Gross.ToString("N2")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => RemoveLine(context))" Disabled="_lines.Count <= 1" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" OnClick="AddLine">Add line</MudButton>
            <MudSpacer />
            <MudText Class="mr-4">Net: <b>@TotalNet.ToString("N2")</b></MudText>
            <MudText Class="mr-4">VAT: <b>@TotalVat.ToString("N2")</b></MudText>
            <MudText Class="mr-4">Total: <b>AED @TotalGross.ToString("N2")</b></MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PostAdd"
                   Disabled="@(!CanPost || _posting)" OnClick="Post">Post Credit Note</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Pre-fills from a Sales Invoice detail page's "Create Credit Note" action.</summary>
    [Parameter] public int? InvoiceId { get; set; }

    private List<Customer>? _customers;
    private List<Account>? _revenueAccounts;
    private List<Account>? _bankAccounts;
    private List<CostCenter>? _costCenters;
    private List<FiscalPeriod>? _periods;
    private List<OpenInvoice> _openInvoices = new();

    private int _customerId;
    private int _invoiceId;
    private CreditNoteSettlementMethod _settlementMethod = CreditNoteSettlementMethod.CreditOnAccount;
    private int _bankAccountId;
    private DateTime? _date = DateTime.Today;
    private int _periodId;
    private string? _reason;
    private string? _narration;
    private bool _posting;

    private readonly List<LineVm> _lines = new() { new() };

    private decimal TotalNet => _lines.Sum(l => l.Net);
    private decimal TotalVat => _lines.Sum(l => l.Vat);
    private decimal TotalGross => _lines.Sum(l => l.Gross);
    private bool CanPost => _customerId > 0 && _periodId > 0 && TotalGross > 0
                            && _lines.All(l => l.RevenueAccountId > 0 && !string.IsNullOrWhiteSpace(l.Description))
                            && (_settlementMethod != CreditNoteSettlementMethod.ApplyToInvoice || _invoiceId > 0)
                            && (_settlementMethod != CreditNoteSettlementMethod.CashRefund || _bankAccountId > 0);

    protected override async Task OnInitializedAsync()
    {
        _customers = await CustomerSvc.GetAllAsync(activeOnly: true);
        var accounts = await Coa.GetAllAsync(postableOnly: true);
        _revenueAccounts = accounts.Where(a => a.Type == AccountType.Income).ToList();
        _bankAccounts = accounts.Where(a => a.Type == AccountType.Asset && a.Code.StartsWith("110")).ToList();
        _costCenters = await Coa.GetCostCentersAsync();
        _periods = await Ledger.GetPeriodsAsync();
        SyncPeriodToDate();

        if (InvoiceId is int invId)
        {
            var invoice = await InvoiceSvc.GetByIdAsync(invId);
            if (invoice is not null)
            {
                await OnCustomerChanged(invoice.CustomerId);
                await OnInvoiceChanged(invId);
            }
        }
    }

    private async Task OnCustomerChanged(int id)
    {
        _customerId = id;
        _openInvoices = id > 0 ? await CustomerSvc.GetOpenInvoicesAsync(id) : new();
        await OnInvoiceChanged(0);
    }

    /// <summary>
    /// Picking an invoice pulls its lines in as a starting point (still fully editable/adjustable)
    /// instead of asking the user to re-type them, and defaults the settlement method to "apply to
    /// invoice" since that's the common case. Clearing the invoice resets to a single blank line.
    /// </summary>
    private async Task OnInvoiceChanged(int id)
    {
        _invoiceId = id;
        if (id == 0)
        {
            if (_settlementMethod == CreditNoteSettlementMethod.ApplyToInvoice)
                _settlementMethod = CreditNoteSettlementMethod.CreditOnAccount;
            _lines.Clear();
            _lines.Add(new());
            return;
        }

        var invoice = await InvoiceSvc.GetByIdAsync(id);
        if (invoice is null) return;

        if (_settlementMethod == CreditNoteSettlementMethod.CreditOnAccount)
            _settlementMethod = CreditNoteSettlementMethod.ApplyToInvoice;

        _lines.Clear();
        foreach (var l in invoice.Lines.OrderBy(l => l.LineNo))
            _lines.Add(new LineVm
            {
                Description = l.Description,
                RevenueAccountId = l.RevenueAccountId,
                CostCenterId = l.CostCenterId,
                Quantity = l.Quantity,
                UnitPrice = l.UnitPrice,
                VatRate = l.VatRate,
            });
    }

    private void OnDateChanged(DateTime? d) { _date = d; SyncPeriodToDate(); }

    private void SyncPeriodToDate()
    {
        if (_periods is null || _date is null) return;
        var d = DateOnly.FromDateTime(_date.Value);
        var match = _periods.FirstOrDefault(p => d >= p.StartDate && d <= p.EndDate);
        if (match is not null) _periodId = match.Id;
        else if (_periodId == 0) _periodId = _periods.LastOrDefault()?.Id ?? 0;
    }

    private void AddLine() => _lines.Add(new());
    private void RemoveLine(LineVm l) { if (_lines.Count > 1) _lines.Remove(l); }

    private async Task Post()
    {
        _posting = true;
        try
        {
            var userName = AuthState is not null ? (await AuthState).User.Identity?.Name ?? "System Admin" : "System Admin";
            var inputs = _lines.Select(l => new CreditNoteLineInput(
                l.Description, l.RevenueAccountId, l.CostCenterId, l.Quantity, l.UnitPrice, l.VatRate));

            var note = await CreditNoteSvc.CreateAndPostAsync(
                _customerId, _invoiceId > 0 ? _invoiceId : null,
                DateOnly.FromDateTime(_date ?? DateTime.Today), _periodId,
                _reason, _narration, userName, inputs, DateTime.UtcNow,
                _settlementMethod, _settlementMethod == CreditNoteSettlementMethod.CashRefund ? _bankAccountId : null);

            Snackbar.Add($"Posted {note.CreditNoteNo} — GL voucher {note.JournalVoucher?.VoucherNo} generated.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(note.Id));
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _posting = false; }
    }

    private void Cancel() => MudDialog.Cancel();

    private class LineVm
    {
        public string Description { get; set; } = "";
        public int RevenueAccountId { get; set; }
        public int? CostCenterId { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal VatRate { get; set; } = 0.05m;

        public decimal Net => Math.Round(Quantity * UnitPrice, 2, MidpointRounding.AwayFromZero);
        public decimal Vat => Math.Round(Net * VatRate, 2, MidpointRounding.AwayFromZero);
        public decimal Gross => Net + Vat;
    }
}
