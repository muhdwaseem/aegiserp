@inject ChartOfAccountsService Coa
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? "Edit Account" : "New Main Account")</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">General Ledger · Chart of Accounts</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="5">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.End">
                    <MudTextField @bind-Value="_code" Label="Account No." Required="true" Immediate="true" Placeholder="e.g. 51030" Disabled="IsEdit" />
                    @if (!IsEdit)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Bolt" OnClick="AutoNumber">Auto</MudButton>
                    }
                </MudStack>
            </MudItem>
            <MudItem xs="12" sm="7">
                <MudTextField @bind-Value="_name" Label="Account Name" Required="true" Placeholder="e.g. Utilities Expense" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudSelect T="AccountType" Value="_type" ValueChanged="OnTypeChanged" Label="Account Type" Required="true" Disabled="IsEdit">
                    <MudSelectItem Value="AccountType.Asset">Asset</MudSelectItem>
                    <MudSelectItem Value="AccountType.Liability">Liability</MudSelectItem>
                    <MudSelectItem Value="AccountType.Equity">Equity</MudSelectItem>
                    <MudSelectItem Value="AccountType.Income">Revenue</MudSelectItem>
                    <MudSelectItem Value="AccountType.Expense">Expense</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="string" @bind-Value="_category" Label="Main Account Category" Clearable="true">
                    @foreach (var c in Categories)
                    {
                        <MudSelectItem Value="c">@c</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (_type is AccountType.Income or AccountType.Expense)
            {
                <MudItem xs="12" sm="4">
                    <MudSelect T="PnlSection" @bind-Value="_pnlSection" Label="P&amp;L Section">
                        @foreach (var s in PnlSectionsFor(_type))
                        {
                            <MudSelectItem Value="s">@PnlSectionLabel(s)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12" sm="4">
                <MudSelect T="string" @bind-Value="_currency" Label="Currency">
                    <MudSelectItem Value="@("AED")">AED — UAE Dirham</MudSelectItem>
                    <MudSelectItem Value="@("USD")">USD — US Dollar</MudSelectItem>
                    <MudSelectItem Value="@("EUR")">EUR — Euro</MudSelectItem>
                    <MudSelectItem Value="@("GBP")">GBP — British Pound</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudSelect T="int?" Value="_parentId" ValueChanged="OnParentChanged" Label="Parent Account / Group" Clearable="true">
                    @foreach (var h in Headers.Where(h => h.Id != Existing?.Id))
                    {
                        <MudSelectItem T="int?" Value="h.Id">@h.Code — @h.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (!IsEdit)
            {
                <MudItem xs="12" sm="4">
                    <MudSelect T="bool" @bind-Value="_isPostable" Label="Posting Type">
                        <MudSelectItem Value="true">Allow posting</MudSelectItem>
                        <MudSelectItem Value="false">Do not allow posting (header)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" @bind-Value="_openingBalance" Label="Opening Balance" HideSpinButtons="true"
                                     Disabled="@(!_isPostable)" Adornment="Adornment.End" AdornmentText="@_currency" />
                </MudItem>
            }
            else
            {
                <MudItem xs="12" sm="4" Class="d-flex align-center">
                    <MudSwitch T="bool" @bind-Value="_isActive" Label="Active" Color="Color.Primary" />
                </MudItem>
            }

            <MudItem xs="12">
                <MudTextField @bind-Value="_description" Label="Description / Notes" Lines="2" Placeholder="Optional description for this account…" />
            </MudItem>

            @if (!IsEdit && _openingBalance != 0)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        An opening balance posts a balanced entry against equity account 31010.
                    </MudAlert>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Check"
                   OnClick="Save" Disabled="_saving">@(IsEdit ? "Save Changes" : "Save Account")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [Parameter] public List<Account> Headers { get; set; } = new();
    [Parameter] public Account? Existing { get; set; }

    private bool IsEdit => Existing is not null;

    private string _code = "";
    private string? _autoSuggestedCode;
    private string _name = "";
    private AccountType _type = AccountType.Expense;
    private PnlSection _pnlSection = PnlSection.OperatingExpense;
    private string? _category;
    private string _currency = "AED";
    private int? _parentId;
    private bool _isPostable = true;
    private bool _isActive = true;
    private decimal _openingBalance;
    private string? _description;
    private bool _saving;

    private static readonly string[] Categories =
    {
        "Cash and cash equivalents", "Accounts receivable", "Inventory", "Fixed asset",
        "Accounts payable", "Current liability", "Long-term liability",
        "Income", "Direct expense", "Indirect expense", "Other income"
    };

    protected override void OnInitialized()
    {
        if (Existing is Account e)
        {
            _code = e.Code; _name = e.Name; _type = e.Type; _category = e.Category;
            _currency = e.Currency; _parentId = e.ParentId; _isPostable = e.IsPostable;
            _isActive = e.IsActive; _description = e.Description;
            if (e.PnlSection is PnlSection s) _pnlSection = s;
        }
        // Asset/Liability/Equity accounts have no P&L sections at all (PnlSectionsFor returns
        // empty) — editing one of those was crashing here before this guard, since it indexed
        // into that empty array instead of just leaving _pnlSection at its harmless default.
        var options = PnlSectionsFor(_type);
        if (options.Length > 0 && !options.Contains(_pnlSection)) _pnlSection = options[0];
    }

    private void OnTypeChanged(AccountType type)
    {
        _type = type;
        var options = PnlSectionsFor(type);
        if (options.Length > 0 && !options.Contains(_pnlSection)) _pnlSection = options[0];
    }

    /// <summary>The P&amp;L sections that make sense for this account type — Cost of Goods Sold only
    /// applies to expenses, never income.</summary>
    private static PnlSection[] PnlSectionsFor(AccountType type) => type switch
    {
        AccountType.Income => new[] { PnlSection.OperatingIncome, PnlSection.NonOperatingIncome },
        AccountType.Expense => new[] { PnlSection.CostOfGoodsSold, PnlSection.OperatingExpense, PnlSection.NonOperatingExpense },
        _ => Array.Empty<PnlSection>(),
    };

    private static string PnlSectionLabel(PnlSection s) => s switch
    {
        PnlSection.OperatingIncome => "Operating Income",
        PnlSection.CostOfGoodsSold => "Cost of Goods Sold",
        PnlSection.OperatingExpense => "Operating Expense",
        PnlSection.NonOperatingIncome => "Non-Operating Income",
        PnlSection.NonOperatingExpense => "Non-Operating Expense",
        _ => s.ToString(),
    };

    /// <summary>Picking a parent group is the point a user has committed to where this account
    /// lives, so the next code in that group's sequence fills in right away — no separate click
    /// needed. It only overwrites the code if it still holds our own last suggestion (or is empty),
    /// so it never clobbers a code the user typed themselves.</summary>
    private async Task OnParentChanged(int? parentId)
    {
        _parentId = parentId;
        if (IsEdit) return;
        if (!string.IsNullOrEmpty(_code) && _code != _autoSuggestedCode) return;

        var next = parentId is not null ? await Coa.SuggestCodeAsync(parentId) : "";
        _code = next;
        _autoSuggestedCode = string.IsNullOrEmpty(next) ? null : next;
    }

    private async Task AutoNumber()
    {
        if (_parentId is null) { Snackbar.Add("Pick a parent group first, then Auto.", Severity.Info); return; }
        var next = await Coa.SuggestCodeAsync(_parentId);
        if (!string.IsNullOrEmpty(next)) { _code = next; _autoSuggestedCode = next; }
    }

    private async Task Save()
    {
        _saving = true;
        try
        {
            var user = AuthState is not null ? (await AuthState).User.Identity?.Name ?? "System Admin" : "System Admin";
            if (IsEdit)
            {
                var acc = await Coa.UpdateAsync(Existing!.Id, _name, _category, _currency, _parentId, _description,
                    _isActive, Existing.RowVersion, user,
                    _type is AccountType.Income or AccountType.Expense ? _pnlSection : null);
                Snackbar.Add($"Account {acc.Code} updated.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(acc.Id));
            }
            else
            {
                var input = new NewAccountInput(_code, _name, _type, _isPostable, _category, _currency, _parentId, _description,
                    _isPostable ? _openingBalance : 0,
                    _type is AccountType.Income or AccountType.Expense ? _pnlSection : null);
                var acc = await Coa.CreateAsync(input, user);
                Snackbar.Add($"Account {acc.Code} created.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(acc.Id));
            }
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _saving = false; }
    }

    private void Cancel() => MudDialog.Cancel();
}
