@inject DirectExpenseService ExpenseSvc
@inject VendorService VendorSvc
@inject CustomerService CustomerSvc
@inject ChartOfAccountsService Coa
@inject LedgerService Ledger
@inject ItemService ItemSvc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">New Expense</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Direct cash/bank expense — no vendor invoice or Accounts Payable involved</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="3">
                <MudDatePicker Date="_date" DateChanged="OnDateChanged" Label="Date" />
            </MudItem>
            <MudItem xs="12" sm="3">
                @if (_payLater)
                {
                    <MudTextField Value="@("Pay Later — posts to Expenses Payable")" Label="Paid Through" ReadOnly="true" Disabled="true" />
                }
                else
                {
                    <MudSelect T="int" @bind-Value="_bankAccountId" Label="Paid Through" Dense="true">
                        <MudSelectItem Value="0">— select account —</MudSelectItem>
                        @if (_bankAccounts is not null)
                        {
                            @foreach (var a in _bankAccounts)
                            {
                                <MudSelectItem Value="a.Id">@a.Code — @a.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                }
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_reference" Label="Reference#" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_vendorInvoiceNo" Label="Invoice/Receipt No. (optional)" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSwitch T="bool" @bind-Value="_payLater" Color="Color.Primary" Label="Pay Later" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSwitch T="bool" @bind-Value="_amountsIncludeVat" Color="Color.Primary" Label="Amounts entered below already include VAT" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSwitch T="bool" @bind-Value="_showVatColumn" Color="Color.Primary" Label="Show VAT amount column" />
            </MudItem>
            @if (_payLater)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        This expense will post as owing (Dr each line's expense account / Cr Expenses Payable) instead of
                        settling from a bank account now. Settle it — in full or split across its lines — from the
                        expense's detail page later.
                    </MudAlert>
                </MudItem>
            }

            @if (!_itemized)
            {
                <MudItem xs="12" sm="@(_showVatColumn ? 4 : 5)">
                    <MudSelect T="int" @bind-Value="_singleExpenseAccountId" Label="Expense Account" Dense="true">
                        <MudSelectItem Value="0">— select account —</MudSelectItem>
                        @if (_expenseAccounts is not null)
                        {
                            @foreach (var a in _expenseAccounts)
                            {
                                <MudSelectItem Value="a.Id">@a.Code — @a.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                    <MudLink Typo="Typo.caption" Class="mt-1 d-inline-block" OnClick="EnableItemize">Itemize</MudLink>
                </MudItem>
                <MudItem xs="12" sm="@(_showVatColumn ? 3 : 4)">
                    <MudSelect T="int?" @bind-Value="_singleCostCenterId" Label="Cost Center" Dense="true" Clearable="true">
                        @if (_costCenters is not null)
                        {
                            @foreach (var c in _costCenters)
                            {
                                <MudSelectItem T="int?" Value="c.Id">@c.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                @if (_showVatColumn)
                {
                    <MudItem xs="12" sm="2">
                        <MudSelect T="decimal" @bind-Value="_singleVatRate" Label="VAT" Dense="true">
                            <MudSelectItem Value="0m">Exempt (0%)</MudSelectItem>
                            <MudSelectItem Value="0.05m">5%</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                }
                <MudItem xs="12" sm="3">
                    <MudNumericField T="decimal" @bind-Value="_singleAmount" Label="Amount (AED)" Min="0" HideSpinButtons="true" />
                </MudItem>
                @if (_showVatColumn)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Net: @SingleSplit.Net.ToString("N2") · VAT: @SingleSplit.Vat.ToString("N2") · Total: @SingleSplit.Gross.ToString("N2")
                        </MudText>
                    </MudItem>
                }
            }
            else
            {
                <MudItem xs="12">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                        <MudText Typo="Typo.subtitle2">Itemized lines</MudText>
                        <MudSpacer />
                        <MudLink Typo="Typo.caption" OnClick="DisableItemize">Use a single account instead</MudLink>
                    </MudStack>
                    <div class="line-table-scroll">
                    <MudTable Items="_lines" Dense="true" Bordered="true" Elevation="0">
                        <HeaderContent>
                            <MudTh Style="min-width:180px">Item</MudTh>
                            <MudTh Style="min-width:200px">Expense Account</MudTh>
                            <MudTh Style="min-width:160px">Cost Center</MudTh>
                            <MudTh Style="min-width:180px">Description</MudTh>
                            <MudTh Style="min-width:130px;text-align:right">Amount</MudTh>
                            @if (_showVatColumn)
                            {
                                <MudTh Style="min-width:100px">VAT %</MudTh>
                                <MudTh Style="min-width:110px;text-align:right">VAT Amt</MudTh>
                            }
                            <MudTh Style="width:48px"></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudSelect T="int" Value="context.ItemId ?? 0" ValueChanged="v => OnItemChanged(context, v)" Dense="true" Margin="Margin.Dense" Clearable="true">
                                    <MudSelectItem Value="0">— none —</MudSelectItem>
                                    @if (_items is not null)
                                    {
                                        @foreach (var it in _items)
                                        {
                                            <MudSelectItem Value="it.Id">@it.Code — @it.Name</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                <MudSelect T="int" @bind-Value="context.ExpenseAccountId" Dense="true" Margin="Margin.Dense">
                                    <MudSelectItem Value="0">— select —</MudSelectItem>
                                    @if (_expenseAccounts is not null)
                                    {
                                        @foreach (var a in _expenseAccounts)
                                        {
                                            <MudSelectItem Value="a.Id">@a.Code — @a.Name</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                <MudSelect T="int?" @bind-Value="context.CostCenterId" Dense="true" Margin="Margin.Dense" Clearable="true">
                                    @if (_costCenters is not null)
                                    {
                                        @foreach (var c in _costCenters)
                                        {
                                            <MudSelectItem T="int?" Value="c.Id">@c.Name</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd><MudTextField @bind-Value="context.Description" Margin="Margin.Dense" /></MudTd>
                            <MudTd Style="text-align:right">
                                <MudNumericField T="decimal" @bind-Value="context.Amount" Min="0" HideSpinButtons="true" Margin="Margin.Dense" />
                            </MudTd>
                            @if (_showVatColumn)
                            {
                                <MudTd>
                                    <MudSelect T="decimal" @bind-Value="context.VatRate" Dense="true" Margin="Margin.Dense">
                                        <MudSelectItem Value="0m">Exempt (0%)</MudSelectItem>
                                        <MudSelectItem Value="0.05m">5%</MudSelectItem>
                                    </MudSelect>
                                </MudTd>
                                <MudTd Style="text-align:right">@context.Split(_amountsIncludeVat).Vat.ToString("N2")</MudTd>
                            }
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => RemoveLine(context))" Disabled="_lines.Count <= 1" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                    </div>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" OnClick="AddLine">Add line</MudButton>
                        <MudSpacer />
                        @if (_showVatColumn)
                        {
                            <MudText Class="mr-4">Net: @TotalNet.ToString("N2")</MudText>
                            <MudText Class="mr-4">VAT: @TotalVat.ToString("N2")</MudText>
                        }
                        <MudText>Total: <b>AED @TotalAmount.ToString("N2")</b></MudText>
                    </MudStack>
                </MudItem>
            }

            <MudItem xs="12" sm="4">
                <MudSelect T="int" @bind-Value="_vendorId" Label="Vendor (optional)" Dense="true">
                    <MudSelectItem Value="0">— none —</MudSelectItem>
                    @if (_vendors is not null)
                    {
                        @foreach (var v in _vendors)
                        {
                            <MudSelectItem Value="v.Id">@v.Code — @v.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="int" @bind-Value="_customerId" Label="Customer Name (optional)" Dense="true">
                    <MudSelectItem Value="0">— none —</MudSelectItem>
                    @if (_customers is not null)
                    {
                        @foreach (var c in _customers)
                        {
                            <MudSelectItem Value="c.Id">@c.Code — @c.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_narration" Label="Notes" Lines="2" Placeholder="Max. 500 characters" MaxLength="500" />
            </MudItem>
            <MudItem xs="12">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".pdf,.jpg,.jpeg,.png">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile" Size="Size.Small">
                                Attach Receipt
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    @if (_attachmentFileName is not null)
                    {
                        <MudChip T="string" Size="Size.Small" OnClose="RemoveAttachment" CloseIcon="@Icons.Material.Filled.Close">@_attachmentFileName</MudChip>
                    }
                </MudStack>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PostAdd"
                   Disabled="@(!CanPost || _posting)" OnClick="Post">Post Expense</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<Vendor>? _vendors;
    private List<Customer>? _customers;
    private List<Account>? _bankAccounts;
    private List<Account>? _expenseAccounts;
    private List<CostCenter>? _costCenters;
    private List<FiscalPeriod>? _periods;
    private List<Item>? _items;

    private int _vendorId;
    private int _customerId;
    private int _bankAccountId;
    private DateTime? _date = DateTime.Today;
    private int _periodId;
    private string? _reference;
    private string? _vendorInvoiceNo;
    private string? _narration;
    private bool _posting;
    private bool _amountsIncludeVat;
    private bool _showVatColumn;
    private bool _payLater;

    private string? _attachmentFileName;
    private string? _attachmentContentType;
    private byte[]? _attachmentBytes;

    private bool _itemized;
    private int _singleExpenseAccountId;
    private int? _singleCostCenterId;
    private decimal _singleAmount;
    private decimal _singleVatRate;
    private readonly List<LineVm> _lines = new() { new() };

    private (decimal Net, decimal Vat, decimal Gross) SingleSplit =>
        new LineVm { Amount = _singleAmount, VatRate = _singleVatRate }.Split(_amountsIncludeVat);

    private decimal TotalNet => _itemized ? _lines.Sum(l => l.Split(_amountsIncludeVat).Net) : SingleSplit.Net;
    private decimal TotalVat => _itemized ? _lines.Sum(l => l.Split(_amountsIncludeVat).Vat) : SingleSplit.Vat;
    private decimal TotalAmount => _itemized ? _lines.Sum(l => l.Split(_amountsIncludeVat).Gross) : SingleSplit.Gross;

    private bool CanPost => (_payLater || _bankAccountId > 0) && _periodId > 0 && TotalAmount > 0
        && (_itemized
            ? _lines.All(l => l.ExpenseAccountId > 0 && l.Amount > 0)
            : _singleExpenseAccountId > 0);

    protected override async Task OnInitializedAsync()
    {
        _vendors = await VendorSvc.GetAllAsync(activeOnly: true);
        _customers = await CustomerSvc.GetAllAsync(activeOnly: true);
        var accounts = await Coa.GetAllAsync(postableOnly: true);
        _bankAccounts = accounts.Where(a => a.Type == AccountType.Asset && a.Code.StartsWith("110")).ToList();
        _expenseAccounts = accounts.Where(a => a.Type == AccountType.Expense).ToList();
        _costCenters = await Coa.GetCostCentersAsync();
        _periods = await Ledger.GetPeriodsAsync();
        _items = await ItemSvc.GetAllAsync(activeOnly: true);
        SyncPeriodToDate();
    }

    private void EnableItemize()
    {
        _itemized = true;
        if (_singleExpenseAccountId > 0 || _singleAmount > 0)
            _lines[0] = new LineVm { ExpenseAccountId = _singleExpenseAccountId, CostCenterId = _singleCostCenterId, Amount = _singleAmount, VatRate = _singleVatRate };
    }

    private void DisableItemize()
    {
        _itemized = false;
        var first = _lines.FirstOrDefault();
        if (first is not null)
        {
            _singleExpenseAccountId = first.ExpenseAccountId;
            _singleCostCenterId = first.CostCenterId;
            _singleAmount = _lines.Sum(l => l.Amount);
            _singleVatRate = first.VatRate;
        }
        _lines.Clear();
        _lines.Add(new());
    }

    private void AddLine() => _lines.Add(new());
    private void RemoveLine(LineVm l) { if (_lines.Count > 1) _lines.Remove(l); }

    /// <summary>Picking an item pre-fills its purchase account, description and cost price — still fully editable afterward.</summary>
    private void OnItemChanged(LineVm line, int itemId)
    {
        line.ItemId = itemId == 0 ? null : itemId;
        var item = _items?.FirstOrDefault(i => i.Id == itemId);
        if (item is null) return;

        if (item.PurchaseAccountId is int accId) line.ExpenseAccountId = accId;
        line.Description = item.PurchaseDescription ?? item.Name;
        if (item.CostPrice is decimal cost) line.Amount = cost;
    }

    private void OnDateChanged(DateTime? d) { _date = d; SyncPeriodToDate(); }

    private void SyncPeriodToDate()
    {
        if (_periods is null || _date is null) return;
        var dd = DateOnly.FromDateTime(_date.Value);
        var match = _periods.FirstOrDefault(p => dd >= p.StartDate && dd <= p.EndDate);
        if (match is not null) _periodId = match.Id;
        else if (_periodId == 0) _periodId = _periods.LastOrDefault()?.Id ?? 0;
    }

    private async Task Post()
    {
        _posting = true;
        try
        {
            if (_periodId == 0)
                throw new PostingException("No fiscal period covers this date.");

            var userName = AuthState is not null ? (await AuthState).User.Identity?.Name ?? "System Admin" : "System Admin";
            var inputs = _itemized
                ? _lines.Select(l => new DirectExpenseLineInput(l.ExpenseAccountId, l.CostCenterId, l.Description, l.Amount, l.ItemId, l.VatRate))
                : new[] { new DirectExpenseLineInput(_singleExpenseAccountId, _singleCostCenterId, null, _singleAmount, VatRate: _singleVatRate) };

            var e = await ExpenseSvc.CreateAndPostAsync(
                _vendorId > 0 ? _vendorId : null, _customerId > 0 ? _customerId : null,
                DateOnly.FromDateTime(_date ?? DateTime.Today), _periodId, _payLater ? null : _bankAccountId,
                _reference, _narration, userName, DateTime.UtcNow, inputs,
                _vendorInvoiceNo, _amountsIncludeVat, _payLater);

            if (_attachmentBytes is not null)
                await ExpenseSvc.SetAttachmentAsync(e.Id, _attachmentFileName!,
                    _attachmentContentType ?? "application/octet-stream", _attachmentBytes);

            Snackbar.Add($"Posted {e.ExpenseNo} — GL voucher generated.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(e.Id));
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _posting = false; }
    }

    private async Task OnFileSelected(IBrowserFile file)
    {
        if (file.Size > DirectExpenseService.MaxAttachmentBytes)
        {
            Snackbar.Add($"That file is too large — the limit is {DirectExpenseService.MaxAttachmentBytes / (1024 * 1024)} MB.", Severity.Error);
            return;
        }

        using var stream = file.OpenReadStream(DirectExpenseService.MaxAttachmentBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _attachmentBytes = ms.ToArray();
        _attachmentFileName = file.Name;
        _attachmentContentType = file.ContentType;
    }

    private void RemoveAttachment()
    {
        _attachmentFileName = null;
        _attachmentContentType = null;
        _attachmentBytes = null;
    }

    private void Cancel() => MudDialog.Cancel();

    private class LineVm
    {
        public int? ItemId { get; set; }
        public int ExpenseAccountId { get; set; }
        public int? CostCenterId { get; set; }
        public string? Description { get; set; }
        public decimal Amount { get; set; }
        public decimal VatRate { get; set; }

        /// <summary>Mirrors <see cref="DirectExpenseLine.Split"/> exactly, so the dialog's live
        /// preview always matches what the service will actually post.</summary>
        public (decimal Net, decimal Vat, decimal Gross) Split(bool amountsIncludeVat)
        {
            if (amountsIncludeVat)
            {
                var gross = Amount;
                var net = Math.Round(gross / (1 + VatRate), 2, MidpointRounding.AwayFromZero);
                return (net, gross - net, gross);
            }
            else
            {
                var net = Amount;
                var vat = Math.Round(net * VatRate, 2, MidpointRounding.AwayFromZero);
                return (net, vat, net + vat);
            }
        }
    }
}
