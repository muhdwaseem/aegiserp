@inject DirectExpenseService ExpenseSvc
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (_loaded && _expense is null)
{
    <MudAlert Severity="Severity.Error">Expense not found.</MudAlert>
}
else if (_expense is not null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h5">@_expense.ExpenseNo</MudText>
        <MudChip T="string" Size="Size.Small" Color="StatusColor(_expense.Status)" Variant="Variant.Text">@_expense.Status</MudChip>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Load" />
    </MudStack>

    <MudPaper Elevation="1">
        <MudTabs Elevation="0" ApplyEffectsToContainer="true" PanelClass="pa-4" Border="true">
            <MudTabPanel Text="General">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Date</MudText>
                        <MudText Class="mb-2">@_expense.Date.ToString("dd MMM yyyy")</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Paid Through</MudText>
                        <MudText Class="mb-2">@_expense.BankAccount.Name</MudText>
                        @if (!string.IsNullOrWhiteSpace(_expense.Reference))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Reference#</MudText>
                            <MudText Class="mb-2">@_expense.Reference</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(_expense.VendorInvoiceNo))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Invoice/Receipt No.</MudText>
                            <MudText Class="mb-2">@_expense.VendorInvoiceNo</MudText>
                        }
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Vendor</MudText>
                        <MudText Class="mb-2">@(_expense.Vendor?.Name ?? "—")</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Customer</MudText>
                        <MudText Class="mb-2">@(_expense.Customer?.Name ?? "—")</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Total</MudText>
                        <MudText Typo="Typo.h6" Class="mb-2">AED @_expense.TotalAmount.ToString("N2")</MudText>
                    </MudItem>
                </MudGrid>
                @if (!string.IsNullOrWhiteSpace(_expense.Narration))
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">Notes</MudText>
                    <MudText>@_expense.Narration</MudText>
                }

                @if (!string.IsNullOrWhiteSpace(_expense.AttachmentFileName))
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3">
                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                        <MudText Typo="Typo.body2">@_expense.AttachmentFileName</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="DownloadAttachment">Download</MudButton>
                    </MudStack>
                }

                <MudDivider Class="my-4" />
                <MudTable Items="_expense.Lines.OrderBy(l => l.LineNo)" Dense="true" Bordered="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Expense Account</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh Style="text-align:right">Net</MudTh>
                        @if (_expense.TotalVat > 0)
                        {
                            <MudTh Style="text-align:right">VAT</MudTh>
                        }
                        <MudTh Style="text-align:right">Amount</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.ExpenseAccount.Code — @context.ExpenseAccount.Name</MudTd>
                        <MudTd>@context.Description</MudTd>
                        <MudTd Style="text-align:right">@context.Split(_expense.AmountsIncludeVat).Net.ToString("N2")</MudTd>
                        @if (_expense.TotalVat > 0)
                        {
                            <MudTd Style="text-align:right">@context.Split(_expense.AmountsIncludeVat).Vat.ToString("N2")</MudTd>
                        }
                        <MudTd Style="text-align:right">@context.Split(_expense.AmountsIncludeVat).Gross.ToString("N2")</MudTd>
                    </RowTemplate>
                </MudTable>
                <MudStack Class="mt-3" AlignItems="AlignItems.End">
                    @if (_expense.TotalVat > 0)
                    {
                        <MudText>Net: AED @_expense.TotalNet.ToString("N2")</MudText>
                        <MudText>VAT: AED @_expense.TotalVat.ToString("N2")</MudText>
                    }
                    <MudText Typo="Typo.h6">Total: AED @_expense.TotalAmount.ToString("N2")</MudText>
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="GL Voucher">
                @if (_expense.JournalVoucher is null)
                {
                    <MudText Class="mud-text-secondary">No GL voucher generated.</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Voucher No.</MudText>
                    <MudText Class="mb-2">@_expense.JournalVoucher.VoucherNo</MudText>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.MenuBook" OnClick="ViewJournal">View Journal</MudButton>
                }
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public int ExpenseId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private int _loadedForId = -1;
    private bool _loaded;
    private DirectExpense? _expense;

    protected override async Task OnParametersSetAsync()
    {
        if (ExpenseId != _loadedForId)
        {
            _loadedForId = ExpenseId;
            await Load();
        }
    }

    private async Task Load()
    {
        _expense = await ExpenseSvc.GetByIdAsync(ExpenseId);
        _loaded = true;
    }

    private void ViewJournal() => Nav.NavigateTo($"/general-ledger?voucherNo={Uri.EscapeDataString(_expense!.JournalVoucher!.VoucherNo)}");

    private async Task DownloadAttachment()
    {
        var full = await ExpenseSvc.GetAttachmentAsync(ExpenseId);
        if (full is null) return;
        var base64 = Convert.ToBase64String(full.Value.Data);
        await JS.InvokeVoidAsync("downloadFileFromBytes", full.Value.FileName, full.Value.ContentType, base64);
    }

    private static Color StatusColor(VoucherStatus status) => status switch
    {
        VoucherStatus.Draft => Color.Default,
        VoucherStatus.Posted => Color.Success,
        VoucherStatus.Void => Color.Dark,
        _ => Color.Default,
    };
}
