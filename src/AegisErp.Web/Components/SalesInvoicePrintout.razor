@* The printable invoice document itself — company header, Bill To, line items, totals, bank
   details, notes and signature blocks. Deliberately has no actions/attachments/audit trail so it's
   safe to reuse on the public, anonymous Share page as well as the authenticated detail panel. *@

<MudPaper Class="pa-6 mb-4 invoice-printout" Elevation="1" Style="position:relative;overflow:hidden">
    @if (Status == ArStatus.Overdue)
    {
        <div class="overdue-ribbon">Overdue</div>
    }
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.h6">@Company?.LegalName</MudText>
            @if (!string.IsNullOrWhiteSpace(Company?.AddressLine1))
            {
                <MudText Typo="Typo.body2">@Company!.AddressLine1 @Company?.City</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(Company?.Phone))
            {
                <MudText Typo="Typo.body2">Tel: @Company!.Phone</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(EmirateLabel))
            {
                <MudText Typo="Typo.body2">Emirate: @EmirateLabel</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(Company?.AddressCountry))
            {
                <MudText Typo="Typo.body2">Country: @Company!.AddressCountry</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(Company?.TrnNumber))
            {
                <MudText Typo="Typo.body2">TRN: @Company!.TrnNumber</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(PlaceOfSupplyLabel))
            {
                <MudText Typo="Typo.body2">Place of Supply: @PlaceOfSupplyLabel</MudText>
            }
        </MudItem>
        <MudItem xs="12" sm="6" Class="text-right">
            <MudText Typo="Typo.h4">TAX INVOICE</MudText>
            <MudText Typo="Typo.body1"># @Invoice.InvoiceNo</MudText>
            @if (!string.IsNullOrWhiteSpace(Invoice.Subject))
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Invoice.Subject</MudText>
            }
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.subtitle2">Bill To</MudText>
            <MudText Typo="Typo.body1">@Invoice.Customer.Name</MudText>
            @if (Invoice.Organization is not null)
            {
                <MudText Typo="Typo.body2">Organization: @Invoice.Organization.Name</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(Invoice.ContactTrn ?? Invoice.Customer.Trn))
            {
                <MudText Typo="Typo.body2">TRN: @(Invoice.ContactTrn ?? Invoice.Customer.Trn)</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(Invoice.ContactMobile) || !string.IsNullOrWhiteSpace(Invoice.ContactEmail))
            {
                <MudText Typo="Typo.body2">@Invoice.ContactMobile @Invoice.ContactEmail</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(Invoice.CustomerPoNo))
            {
                <MudText Typo="Typo.body2">PO No.: @Invoice.CustomerPoNo</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(Invoice.DeliveryNoteRef))
            {
                <MudText Typo="Typo.body2">Delivery Note Ref.: @Invoice.DeliveryNoteRef</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(Invoice.SalesOrderRef))
            {
                <MudText Typo="Typo.body2">Sales Order Ref.: @Invoice.SalesOrderRef</MudText>
            }
        </MudItem>
        <MudItem xs="12" sm="6" Class="text-right">
            <MudText Typo="Typo.body2">Invoice Date: @Invoice.Date.ToString("dd MMM yyyy")</MudText>
            <MudText Typo="Typo.body2">Due Date: @Invoice.DueDate.ToString("dd MMM yyyy")</MudText>
            @if (!string.IsNullOrWhiteSpace(Invoice.Salesperson))
            {
                <MudText Typo="Typo.body2">Salesperson: @Invoice.Salesperson</MudText>
            }
            <MudText Typo="Typo.h6" Class="mt-2">Balance Due: AED @Balance.ToString("N2")</MudText>
        </MudItem>
    </MudGrid>

    @if (IsProServiceFormat)
    {
        <MudTable Items="Invoice.Lines.OrderBy(l => l.LineNo)" Dense="true" Bordered="true" Elevation="0" Class="mt-4">
            <HeaderContent>
                <MudTh>#</MudTh>
                <MudTh>Description</MudTh>
                <MudTh Style="text-align:right">Qty</MudTh>
                <MudTh Style="text-align:right">Govt Fee</MudTh>
                <MudTh Style="text-align:right">Center Fee</MudTh>
                <MudTh Style="text-align:right">Bank Charge</MudTh>
                <MudTh Style="text-align:right">VAT %</MudTh>
                <MudTh Style="text-align:right">Amount</MudTh>
                <MudTh>Assigned To</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.LineNo</MudTd>
                <MudTd>@context.Description</MudTd>
                <MudTd Style="text-align:right">@context.Quantity.ToString("N2")</MudTd>
                <MudTd Style="text-align:right">@context.GovtFee.ToString("N2")</MudTd>
                <MudTd Style="text-align:right">@context.UnitPrice.ToString("N2")</MudTd>
                <MudTd Style="text-align:right">@context.BankCharge.ToString("N2")</MudTd>
                <MudTd Style="text-align:right">@context.VatRate.ToString("P0")</MudTd>
                <MudTd Style="text-align:right">@context.Gross.ToString("N2")</MudTd>
                <MudTd>@context.AssignedTo</MudTd>
            </RowTemplate>
        </MudTable>

        <MudStack Class="mt-3" AlignItems="AlignItems.End">
            <MudText>Govt Fee: @Invoice.Lines.Sum(l => l.Quantity * l.GovtFee).ToString("N2")</MudText>
            <MudText>Center Fee: @Invoice.Lines.Sum(l => l.TaxableNet).ToString("N2")</MudText>
            <MudText>Bank Charge: @Invoice.Lines.Sum(l => l.Quantity * l.BankCharge).ToString("N2")</MudText>
            <MudText>VAT: @Invoice.TotalVat.ToString("N2")</MudText>
            <MudText Typo="Typo.h6">Grand Total: AED @Invoice.TotalGross.ToString("N2")</MudText>
        </MudStack>
    }
    else
    {
        <MudTable Items="Invoice.Lines.OrderBy(l => l.LineNo)" Dense="true" Bordered="true" Elevation="0" Class="mt-4">
            <HeaderContent>
                <MudTh>#</MudTh>
                <MudTh>Item &amp; Description</MudTh>
                <MudTh Style="text-align:right">Qty</MudTh>
                <MudTh>UOM</MudTh>
                <MudTh Style="text-align:right">Rate</MudTh>
                <MudTh Style="text-align:right">Discount</MudTh>
                <MudTh Style="text-align:right">VAT %</MudTh>
                <MudTh Style="text-align:right">Amount</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.LineNo</MudTd>
                <MudTd>@context.Description</MudTd>
                <MudTd Style="text-align:right">@context.Quantity.ToString("N2")</MudTd>
                <MudTd>@context.Uom</MudTd>
                <MudTd Style="text-align:right">@context.UnitPrice.ToString("N2")</MudTd>
                <MudTd Style="text-align:right">@(context.DiscountValue > 0 ? (context.DiscountType == DiscountType.Percent ? $"{context.DiscountValue:N2}%" : $"AED {context.DiscountValue:N2}") : "—")</MudTd>
                <MudTd Style="text-align:right">@context.VatRate.ToString("P0")</MudTd>
                <MudTd Style="text-align:right">@context.Gross.ToString("N2")</MudTd>
            </RowTemplate>
        </MudTable>

        <MudStack Class="mt-3" AlignItems="AlignItems.End">
            <MudText>Net: @Invoice.TotalNet.ToString("N2")</MudText>
            <MudText>VAT: @Invoice.TotalVat.ToString("N2")</MudText>
            <MudText Typo="Typo.h6">Total: AED @Invoice.TotalGross.ToString("N2")</MudText>
        </MudStack>
    }

    <MudText Typo="Typo.body2" Class="mt-3"><b>Amount Chargeable (in words):</b> @AmountInWords.ToWords(Invoice.TotalGross)</MudText>

    @if (Invoice.TotalVat > 0)
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle2">VAT Summary</MudText>
        <MudTable Items="VatSummary" Dense="true" Bordered="true" Elevation="0" Class="mt-2" Style="max-width:420px">
            <HeaderContent>
                <MudTh>VAT %</MudTh>
                <MudTh Style="text-align:right">Assessable Value</MudTh>
                <MudTh Style="text-align:right">Tax Amount</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Rate.ToString("P0")</MudTd>
                <MudTd Style="text-align:right">@context.Net.ToString("N2")</MudTd>
                <MudTd Style="text-align:right">@context.Vat.ToString("N2")</MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd><b>Total</b></MudTd>
                <MudTd Style="text-align:right"><b>@Invoice.TotalNet.ToString("N2")</b></MudTd>
                <MudTd Style="text-align:right"><b>@Invoice.TotalVat.ToString("N2")</b></MudTd>
            </FooterContent>
        </MudTable>
        <MudText Typo="Typo.body2" Class="mt-2"><b>VAT Amount (in words):</b> @AmountInWords.ToWords(Invoice.TotalVat)</MudText>
    }

    @{ var bank = Company?.BankAccounts.FirstOrDefault(a => a.IsPrimary) ?? Company?.BankAccounts.FirstOrDefault(); }
    @if (bank is not null)
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle2">Payment Details</MudText>
        <MudText Typo="Typo.body2">Bank: @bank.BankName</MudText>
        @if (!string.IsNullOrWhiteSpace(bank.AccountName))
        {
            <MudText Typo="Typo.body2">Account Name: @bank.AccountName</MudText>
        }
        @if (!string.IsNullOrWhiteSpace(bank.AccountNumber))
        {
            <MudText Typo="Typo.body2">Account No.: @bank.AccountNumber</MudText>
        }
        @if (!string.IsNullOrWhiteSpace(bank.Iban))
        {
            <MudText Typo="Typo.body2">IBAN: @bank.Iban</MudText>
        }
        @if (!string.IsNullOrWhiteSpace(bank.Swift))
        {
            <MudText Typo="Typo.body2">SWIFT: @bank.Swift</MudText>
        }
    }

    @if (!string.IsNullOrWhiteSpace(Invoice.Notes))
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle2">Notes</MudText>
        <MudText Typo="Typo.body2" Style="white-space:pre-wrap">@Invoice.Notes</MudText>
    }

    @if (!string.IsNullOrWhiteSpace(Invoice.TermsAndConditions))
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle2">Terms &amp; Conditions</MudText>
        <MudText Typo="Typo.body2" Style="white-space:pre-wrap">@Invoice.TermsAndConditions</MudText>
    }

    @if (!string.IsNullOrWhiteSpace(Company?.TrnNumber))
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.caption">Declaration: We declare that this invoice shows the actual price of the goods/services described and that all particulars are true and correct.</MudText>
    }

    <div class="sig-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:2rem">
        <div style="display:flex;flex-direction:column;gap:8px">
            @if (!string.IsNullOrWhiteSpace(Company?.LegalName))
            {
                <MudText Typo="Typo.body2" Align="Align.Center">for @Company!.LegalName</MudText>
            }
            <div style="height:1px;background:rgba(0,0,0,0.2);margin-top:32px"></div>
            <MudText Typo="Typo.caption" Align="Align.Center" Class="mud-text-secondary">Authorised Signatory</MudText>
        </div>
        <div style="display:flex;flex-direction:column;gap:8px">
            <div style="height:1px;background:rgba(0,0,0,0.2);margin-top:56px"></div>
            <MudText Typo="Typo.caption" Align="Align.Center" Class="mud-text-secondary">Customer Acknowledgement</MudText>
        </div>
    </div>

    <MudText Typo="Typo.caption" Align="Align.Center" Class="mud-text-secondary d-block mt-4">This is a Computer Generated Invoice</MudText>
</MudPaper>

<style>
    .overdue-ribbon {
        position: absolute; top: 18px; left: -38px; width: 160px;
        transform: rotate(-45deg); text-align: center;
        background: var(--mud-palette-error); color: var(--mud-palette-error-text);
        font-size: 12px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
        padding: 4px 0; box-shadow: 0 2px 4px rgba(0,0,0,.2); z-index: 1;
    }
    @@media print {
        .overdue-ribbon { display: none; }
    }
</style>

@code {
    [Parameter, EditorRequired] public SalesInvoice Invoice { get; set; } = null!;
    [Parameter] public CompanySetup? Company { get; set; }
    [Parameter] public decimal Balance { get; set; }
    [Parameter] public ArStatus Status { get; set; }

    private bool IsProServiceFormat => Invoice.Lines.Any(l => l.GovtFee > 0 || l.BankCharge > 0);

    private string? EmirateLabel => Company?.Emirate ?? Company?.AddressEmirate;

    /// <summary>Defaults to the supplier's own Emirate/Country — correct for the common case (the
    /// supplier is established in the UAE and the recipient has no other place of establishment).</summary>
    private string? PlaceOfSupplyLabel => string.IsNullOrWhiteSpace(EmirateLabel)
        ? null
        : string.IsNullOrWhiteSpace(Company?.AddressCountry) ? EmirateLabel : $"{Company!.AddressCountry}, {EmirateLabel}";

    private IEnumerable<(decimal Rate, decimal Net, decimal Vat)> VatSummary => Invoice.Lines
        .GroupBy(l => l.VatRate)
        .Select(g => (Rate: g.Key, Net: g.Sum(l => l.Net), Vat: g.Sum(l => l.Vat)))
        .OrderByDescending(x => x.Rate);
}
