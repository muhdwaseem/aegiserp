@inherits LayoutComponentBase
@implements IDisposable
@inject LedgerService Ledger
@inject CompanySession Session
@inject NavigationManager Navigation

@* One-way IsDarkMode: the app controls the theme (default light) so the OS preference can't flip it unexpectedly. The toolbar button toggles _isDark. *@
<MudThemeProvider Theme="_theme" IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <span class="brand-mark ml-1">AE</span>
        <MudText Typo="Typo.h6" Class="ml-2" Style="font-weight:700;letter-spacing:-.3px">Aegis&nbsp;ERP</MudText>
        <MudText Typo="Typo.caption" Class="ml-2 d-none d-sm-flex" Style="opacity:.7">Finance &amp; Operations</MudText>
        <MudSpacer />
        @* Company switcher — re-scopes every query to the chosen company. *@
        <AuthorizeView>
            <Authorized>
                @if (Session.Companies.Count > 1)
                {
                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="d-none d-md-flex">
                        <ActivatorContent>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit"
                                     Icon="@Icons.Material.Filled.Business" Class="company-chip">
                                @(Session.Active?.Name ?? "Select company") ▾
                            </MudChip>
                        </ActivatorContent>
                        <ChildContent>
                            <div class="px-4 py-2">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Switch company</MudText>
                            </div>
                            <MudDivider />
                            @foreach (var c in Session.Companies)
                            {
                                <MudMenuItem OnClick="@(() => SwitchCompany(c.CompanyId))">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        @if (c.CompanyId == Session.Active?.CompanyId)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                                        }
                                        <div>
                                            <MudText Typo="Typo.body2"><b>@c.Name</b></MudText>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@c.Code · @c.Role</MudText>
                                        </div>
                                    </MudStack>
                                </MudMenuItem>
                            }
                        </ChildContent>
                    </MudMenu>
                }
                else if (Session.Active is not null)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit"
                             Icon="@Icons.Material.Filled.Business" Class="d-none d-md-flex company-chip">@Session.Active.Name</MudChip>
                }
            </Authorized>
        </AuthorizeView>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" Icon="@Icons.Material.Filled.CalendarMonth" Class="d-none d-md-flex">@_periodLabel</MudChip>
        <MudIconButton Icon="@(_isDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="@(() => _isDark = !_isDark)" />
        <AuthorizeView>
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudChip T="string" Icon="@Icons.Material.Filled.Person" Color="Color.Inherit" Variant="Variant.Text">
                            @context.User.Identity?.Name
                        </MudChip>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="px-4 py-2">
                            <MudText Typo="Typo.body2"><b>@context.User.Identity?.Name</b></MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @string.Join(", ", context.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))
                            </MudText>
                        </div>
                        <MudDivider />
                        <form action="Account/Logout" method="post" class="px-4 py-2">
                            <AntiforgeryToken />
                            <button type="submit"
                                    style="background:none;border:none;cursor:pointer;color:var(--mud-palette-error);font-size:13px;font-weight:600;padding:0">
                                Sign out
                            </button>
                        </form>
                    </ChildContent>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @* Keyed by company: switching disposes and rebuilds the page so it reloads its data
               under the new company scope, without a full page reload. *@
            <div @key="@(Session.Active?.CompanyId ?? 0)">
                @* Catches anything an action handler doesn't (only PostingException is caught
                   per-page today) so an unexpected error — a lock/busy DB error, a bug — shows a
                   scoped message and lets the user retry the current page, instead of tearing
                   down the whole circuit and losing every other open tab/page for that user. *@
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent>
                        <MudAlert Severity="Severity.Error" Class="ma-4">
                            <MudText>Something went wrong loading or saving this page.</MudText>
                            <MudText Typo="Typo.body2" Class="mt-1">
                                This is usually transient (e.g. another user saving at the same moment). Try again.
                            </MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Error" Class="mt-2"
                                       OnClick="@(() => _errorBoundary?.Recover())">
                                Try again
                            </MudButton>
                        </MudAlert>
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@* App-bar text/chips: MudChip's text variant dims the inherited colour to a faint grey on the
   navy bar. Force crisp white with a subtle translucent pill so they read clearly. *@
<style>
    /* Brand mark: small gradient tile echoing the ledger-and-ink identity — primary blue into a
       warm gold, the one place gold appears in the chrome (kept sparing on purpose). */
    .brand-mark {
        display: inline-flex; align-items: center; justify-content: center;
        width: 28px; height: 28px; border-radius: 3px; flex: 0 0 28px;
        background: linear-gradient(135deg, var(--mud-palette-primary), var(--brand-gold, #92662c));
        color: #fff; font-weight: 700; font-size: 11px; letter-spacing: .02em;
    }

    .mud-appbar .mud-chip.mud-chip-text {
        color: #ffffff !important;
        background-color: rgba(255, 255, 255, 0.10);
        font-weight: 500;
    }
    .mud-appbar .mud-chip .mud-chip-icon,
    .mud-appbar .mud-chip .mud-icon-root,
    .mud-appbar .mud-chip.mud-chip-text:hover {
        color: rgba(255, 255, 255, 0.9) !important;
    }
    .mud-appbar .mud-chip.mud-chip-text:hover {
        background-color: rgba(255, 255, 255, 0.18);
    }
    /* Toolbar icon buttons (menu, dark-mode) crisp white */
    .mud-appbar .mud-icon-button { color: rgba(255, 255, 255, 0.9); }

    /* The active company must be unmistakable — it decides whose books you are editing. Gold
       reads clearly against the constant dark-olive appbar in both light and dark mode. */
    .mud-appbar .mud-chip.company-chip {
        background-color: rgba(146, 102, 44, 0.35) !important;
        border: 1px solid rgba(242, 230, 207, 0.45);
        font-weight: 700 !important;
        letter-spacing: .2px;
    }
    .mud-appbar .mud-chip.company-chip:hover {
        background-color: rgba(146, 102, 44, 0.5) !important;
    }
</style>

@code {
    private bool _drawerOpen = true;
    private bool _isDark = false;
    private string _periodLabel = "…";
    private ErrorBoundary? _errorBoundary;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureInitialisedAsync();

        // No company exists/granted yet: a FirmAdmin goes straight to creating the first one; any
        // other user goes to the picker, which shows a friendly "ask an admin" message instead of
        // every company-scoped page failing with an unhandled exception under the error boundary.
        // These two branches must be mutually exclusive — a FirmAdmin with no companies used to
        // also match the "send to the picker" check below (HasNoCompanies is true either way),
        // bouncing forever between /company-setup/new and /select-company (ERR_TOO_MANY_REDIRECTS).
        if (Session.HasNoCompanies)
        {
            if (Session.IsFirmAdmin)
            {
                if (!Navigation.Uri.Contains("/company-setup", StringComparison.OrdinalIgnoreCase))
                    Navigation.NavigateTo("company-setup/new");
                return;
            }

            if (!Navigation.Uri.Contains("/select-company", StringComparison.OrdinalIgnoreCase))
                Navigation.NavigateTo("select-company");
            return;
        }

        // Several companies and none chosen yet → make the user pick, so it is never ambiguous
        // whose books are open. (Skip the redirect when already there.)
        if (Session.NeedsSelection
            && !Navigation.Uri.Contains("/select-company", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("select-company");
            return;
        }

        // The company can also change from the picker page, so refresh the header when it does.
        Session.Changed += OnCompanyChanged;
        await LoadPeriodAsync();
    }

    private void OnCompanyChanged() => _ = InvokeAsync(async () =>
    {
        await LoadPeriodAsync();
        StateHasChanged();
    });

    public void Dispose() => Session.Changed -= OnCompanyChanged;

    private async Task LoadPeriodAsync()
    {
        // Periods are per company, so this must be read after the company is resolved.
        var p = Session.Active is null
            ? null
            : await Ledger.GetDefaultPeriodAsync(DateOnly.FromDateTime(DateTime.Today));
        _periodLabel = p is null ? "No period" : $"Period {p.PeriodNo} · {p.Name}";
    }

    private async Task SwitchCompany(int companyId)
    {
        Session.SwitchTo(companyId);
        await LoadPeriodAsync();
        // No reload: a forceLoad would start a new circuit and drop the selection. Instead the
        // @key on the body below changes with the company, so Blazor rebuilds the current page
        // and its OnInitializedAsync re-queries under the new scope.
        StateHasChanged();
    }

    // "Ledger" palette — warm stone canvas + deep forest-green primary + brass/gold secondary,
    // approved design direction (see design-preview artifact). The appbar/drawer shell stays a
    // constant dark olive in BOTH modes (only the page canvas/cards switch between the warm-stone
    // light surface and the charcoal-green dark surface) — matching the reference prototype's
    // "dark nav shell regardless of theme" pattern.
    private readonly MudTheme _theme = new()
    {
        Typography = new Typography
        {
            Default = new Default { FontFamily = new[] { "Plex Sans", "Segoe UI", "system-ui", "sans-serif" } }
        },
        PaletteLight = new PaletteLight
        {
            Primary = "#1f4d3a",
            PrimaryContrastText = "#f8f6f1",
            Secondary = "#92662c",
            SecondaryContrastText = "#f8f6f1",
            Info = "#315a86",
            Success = "#2f6b3f",
            Warning = "#8a5a09",
            Error = "#8f3a2a",
            Dark = "#21261e",

            Background = "#e9e6de",
            Surface = "#f8f6f1",
            BackgroundGray = "#ded9cc",

            AppbarBackground = "#21261e",
            AppbarText = "rgba(242,240,230,0.92)",
            DrawerBackground = "#21261e",
            DrawerText = "#cdd0c2",
            DrawerIcon = "#cdd0c2",

            TextPrimary = "#262a22",
            TextSecondary = "#565b4c",
            TextDisabled = "rgba(38,42,34,0.38)",
            ActionDefault = "#6b7060",
            ActionDisabled = "rgba(38,42,34,0.26)",
            ActionDisabledBackground = "rgba(38,42,34,0.10)",

            LinesDefault = "#d2ccbb",
            LinesInputs = "#b7ae97",
            Divider = "#d2ccbb",
            DividerLight = "rgba(0,0,0,0.05)",
            TableLines = "#d2ccbb",
            TableStriped = "rgba(38,42,34,0.02)",
            TableHover = "rgba(31,77,58,0.09)",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#6fae84",
            PrimaryContrastText = "#0d150f",
            Secondary = "#d3a15c",
            SecondaryContrastText = "#0d150f",
            Info = "#7fa8d6",
            Success = "#7fc696",
            Warning = "#e0b34d",
            Error = "#d97b6a",
            Dark = "#0e120b",

            Background = "#14180f",     // page
            Surface = "#1b2015",        // cards / paper (elevated)
            BackgroundGray = "#232a1a",

            AppbarBackground = "#0e120b",
            AppbarText = "rgba(242,240,230,0.92)",
            DrawerBackground = "#0e120b",
            DrawerText = "#cdd0c2",
            DrawerIcon = "#cdd0c2",

            TextPrimary = "#e7e6dc",
            TextSecondary = "#aaad9b",
            TextDisabled = "rgba(231,230,220,0.34)",
            ActionDefault = "#8b8f7c",
            ActionDisabled = "rgba(231,230,220,0.26)",
            ActionDisabledBackground = "rgba(231,230,220,0.10)",

            LinesDefault = "#2c331f",
            LinesInputs = "#3a4326",
            Divider = "#2c331f",
            DividerLight = "rgba(255,255,255,0.06)",
            TableLines = "#2c331f",
            TableStriped = "rgba(255,255,255,0.03)",
            TableHover = "rgba(111,174,132,0.14)",
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "8px" }
    };
}
