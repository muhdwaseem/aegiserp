@* Force high-contrast nav text in both themes (text-primary is dark in light, light in dark).
   Active item gets a bold accent bar instead of low-contrast coloured text. *@
<style>
    .mud-navmenu .mud-nav-link,
    .mud-navmenu .mud-nav-group > .mud-nav-link {
        color: var(--mud-palette-text-primary);
        font-weight: 500;
        opacity: 1;
    }
    .mud-navmenu .mud-nav-link .mud-nav-link-icon {
        color: var(--mud-palette-text-secondary);
    }
    .mud-navmenu .mud-nav-link.active {
        color: var(--mud-palette-text-primary) !important;
        background-color: rgba(46, 134, 222, 0.12);
        font-weight: 700;
        box-shadow: inset 3px 0 0 var(--mud-palette-primary);
    }
    .mud-navmenu .mud-nav-link.active .mud-nav-link-icon {
        color: var(--mud-palette-primary);
    }
    .mud-navmenu .mud-nav-link:hover {
        background-color: var(--mud-palette-action-default-hover);
    }
</style>
