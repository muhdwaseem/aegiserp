@page "/Account/AccessDenied"
@layout AccountLayout
@attribute [AllowAnonymous]

<PageTitle>Access denied · Aegis ERP</PageTitle>

<div style="background:#fff;border:1px solid #e2e5ec;border-radius:8px;padding:28px;text-align:center;box-shadow:0 4px 12px rgba(0,0,0,.06)">
    <div style="font-size:34px;margin-bottom:8px">🔒</div>
    <h1 style="font-size:17px;font-weight:700;color:#1c2333;margin-bottom:6px">Access denied</h1>
    <p style="font-size:12.5px;color:#8a93a6;margin-bottom:18px">
        Your account does not have permission for that page. Contact an administrator if you need access.
    </p>
    <a href="/" style="color:#2e86de;font-size:13px;font-weight:600">Back to dashboard</a>
</div>
