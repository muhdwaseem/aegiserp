@page "/sales-invoice"
@attribute [Authorize(Roles = AppRoles.Posters)]
@using AegisErp.Web.Components.Dialogs
@inject SalesInvoiceService InvoiceSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Sales Invoice · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">Sales Invoices</MudText>
    <MudSpacer />
    <MudSelect T="string" Value="_statusFilter" ValueChanged="OnFilterChanged" Label="Status" Dense="true" Style="min-width:160px">
        @foreach (var s in StatusFilters)
        {
            <MudSelectItem Value="s">@s</MudSelectItem>
        }
    </MudSelect>
    <MudMenu>
        <ActivatorContent>
            <MudButton Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.ArrowDropDown">Related Documents</MudButton>
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem Icon="@Icons.Material.Filled.RequestQuote" OnClick="@(() => Nav.NavigateTo("estimate"))">Estimate / Quotation</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.LocalShipping" OnClick="@(() => Nav.NavigateTo("delivery-note"))">Delivery Note</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Payments" OnClick="@(() => Nav.NavigateTo("receipt-voucher"))">Receipt Voucher</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Undo" OnClick="@(() => Nav.NavigateTo("credit-note"))">Credit Note</MudMenuItem>
        </ChildContent>
    </MudMenu>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNew">
        New Invoice
    </MudButton>
</MudStack>

<MudTable Items="FilteredRows" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="_rows is null">
    <HeaderContent>
        <MudTh>Invoice</MudTh>
        <MudTh>Date</MudTh>
        <MudTh>Due</MudTh>
        <MudTh>Customer</MudTh>
        <MudTh Style="text-align:right">Total</MudTh>
        <MudTh Style="text-align:right">Balance Due</MudTh>
        <MudTh>GL Voucher</MudTh>
        <MudTh>Status</MudTh>
        <MudTh Style="width:48px"></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd Style="font-family:monospace">@context.Invoice.InvoiceNo</MudTd>
        <MudTd>@context.Invoice.Date.ToString("yyyy-MM-dd")</MudTd>
        <MudTd>@context.Invoice.DueDate.ToString("yyyy-MM-dd")</MudTd>
        <MudTd>@context.Invoice.Customer.Name</MudTd>
        <MudTd Style="text-align:right;font-weight:600">@context.Invoice.TotalGross.ToString("N2")</MudTd>
        <MudTd Style="text-align:right">@context.Balance.ToString("N2")</MudTd>
        <MudTd Style="font-family:monospace;font-size:11.5px">@context.Invoice.JournalVoucher?.VoucherNo</MudTd>
        <MudTd><MudChip T="string" Size="Size.Small" Color="StatusColor(context.Status)" Variant="Variant.Text">@context.Status</MudChip></MudTd>
        <MudTd>
            @if (context.Status == ArStatus.Draft)
            {
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small">
                    <MudMenuItem Icon="@Icons.Material.Filled.PostAdd" OnClick="@(() => PostDraft(context.Invoice.Id))">Post Invoice</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Block" OnClick="@(() => VoidDraft(context.Invoice.Id))">Void</MudMenuItem>
                </MudMenu>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4 mud-text-secondary">No invoices match this filter.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private static readonly string[] StatusFilters = { "All", "Draft", "Pending", "Outstanding", "Overdue", "Paid", "Void" };

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<SalesInvoiceRow>? _rows;
    private string _statusFilter = "All";

    private IEnumerable<SalesInvoiceRow> FilteredRows => _rows is null ? Enumerable.Empty<SalesInvoiceRow>() : _statusFilter switch
    {
        "All" => _rows,
        // Zoho-style umbrella filter: anything posted and not yet fully paid, due or not.
        "Outstanding" => _rows.Where(r => r.Status is ArStatus.Pending or ArStatus.Overdue),
        _ => _rows.Where(r => r.Status.ToString() == _statusFilter),
    };

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _rows = await InvoiceSvc.GetAllAsync();

    private void OnFilterChanged(string s) => _statusFilter = s;

    private static Color StatusColor(ArStatus status) => status switch
    {
        ArStatus.Draft => Color.Default,
        ArStatus.Pending => Color.Info,
        ArStatus.Overdue => Color.Error,
        ArStatus.Paid => Color.Success,
        ArStatus.Void => Color.Dark,
        _ => Color.Default,
    };

    private async Task OpenNew()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<NewSalesInvoiceDialog>("New Sales Invoice", options);
        if ((await dialog.Result) is { Canceled: false }) await Load();
    }

    private async Task PostDraft(int invoiceId)
    {
        try
        {
            var userName = AuthState is not null ? (await AuthState).User.Identity?.Name ?? "System Admin" : "System Admin";
            var inv = await InvoiceSvc.PostDraftAsync(invoiceId, userName, DateTime.UtcNow);
            Snackbar.Add($"Posted {inv.InvoiceNo} — GL voucher {inv.JournalVoucher?.VoucherNo} generated.", Severity.Success);
            await Load();
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task VoidDraft(int invoiceId)
    {
        try
        {
            await InvoiceSvc.VoidDraftAsync(invoiceId);
            Snackbar.Add("Invoice voided.", Severity.Success);
            await Load();
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
