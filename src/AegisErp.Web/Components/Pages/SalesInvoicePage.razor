@page "/sales-invoice"
@page "/sales-invoice/{Id:int?}"
@attribute [Authorize]
@using AegisErp.Web.Components.Dialogs
@inject SalesInvoiceService InvoiceSvc
@inject LedgerService Ledger
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject CompanySession Session

<PageTitle>Sales Invoice · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h5">Sales Invoices</MudText>
    <MudSpacer />
    <MudSelect T="string" Value="_statusFilter" ValueChanged="OnFilterChanged" Label="Status" Dense="true" Style="min-width:160px">
        @foreach (var s in StatusFilters)
        {
            <MudSelectItem Value="s">@s</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="int?" @bind-Value="_periodFilter" Label="Period" Dense="true" Clearable="true" Style="min-width:160px">
        <MudSelectItem T="int?" Value="@((int?)null)">All periods</MudSelectItem>
        @if (_periods is not null)
        {
            @foreach (var p in _periods)
            {
                <MudSelectItem T="int?" Value="@((int?)p.Id)">@p.Name</MudSelectItem>
            }
        }
    </MudSelect>
    <MudMenu>
        <ActivatorContent>
            <MudButton Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.ArrowDropDown">Related Documents</MudButton>
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem Icon="@Icons.Material.Filled.RequestQuote" OnClick="@(() => Nav.NavigateTo("estimate"))">Estimate / Quotation</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.LocalShipping" OnClick="@(() => Nav.NavigateTo("delivery-note"))">Delivery Note</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Payments" OnClick="@(() => Nav.NavigateTo("receipt-voucher"))">Receipt Voucher</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Undo" OnClick="@(() => Nav.NavigateTo("credit-note"))">Credit Note</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Autorenew" OnClick="@(() => Nav.NavigateTo("recurring-invoices"))">Recurring Invoices</MudMenuItem>
        </ChildContent>
    </MudMenu>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNew">
        New Invoice
    </MudButton>
</MudStack>

<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="invoice-list-pane" Elevation="1">
            @if (_rows is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (FilteredRows.Count == 0)
            {
                <MudText Class="pa-4 mud-text-secondary">No invoices match this filter.</MudText>
            }
            else
            {
                @foreach (var row in FilteredRows)
                {
                    <div class="invoice-row @(row.Invoice.Id == _selectedId ? "selected" : "")" @onclick="@(() => SelectRow(row))">
                        <div class="invoice-row-top">
                            <span class="invoice-row-customer">@row.Invoice.Customer.Name</span>
                            <span class="invoice-row-amount">AED @row.Invoice.TotalGross.ToString("N2")</span>
                        </div>
                        <div class="invoice-row-meta">@row.Invoice.InvoiceNo · @row.Invoice.Date.ToString("dd MMM yyyy")</div>
                        <div class="invoice-row-status status-@row.Status.ToString().ToLowerInvariant()">
                            @SalesInvoiceDetailPanel.StatusLabel(row.Status, row.Invoice.DueDate)
                        </div>
                    </div>
                }
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="8">
        @if (_selectedId is int id)
        {
            <SalesInvoiceDetailPanel @key="id" InvoiceId="id" OnChanged="Load" />
        }
        else
        {
            <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" Elevation="1" Style="min-height:300px">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Large" Class="mud-text-secondary mb-2" />
                <MudText Class="mud-text-secondary">Select an invoice on the left to view its details.</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

<style>
    .invoice-list-pane { max-height: calc(100vh - 220px); overflow-y: auto; }
    .invoice-row { padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-lines-default); cursor: pointer; }
    .invoice-row:hover { background: var(--mud-palette-action-default-hover); }
    .invoice-row.selected { background: var(--mud-palette-primary-hover); border-left: 3px solid var(--mud-palette-primary); }
    .invoice-row-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .invoice-row-customer { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .invoice-row-amount { font-weight: 600; white-space: nowrap; }
    .invoice-row-meta { font-size: 12px; color: var(--mud-palette-text-secondary); margin-top: 2px; }
    .invoice-row-status { font-size: 11px; font-weight: 700; letter-spacing: .03em; margin-top: 4px; }
    .status-overdue { color: var(--mud-palette-error); }
    .status-paid { color: var(--mud-palette-success); }
    .status-pending { color: var(--mud-palette-info); }
    .status-draft, .status-void { color: var(--mud-palette-text-secondary); }
</style>

@code {
    private static readonly string[] StatusFilters = { "All", "Draft", "Pending", "Outstanding", "Overdue", "Paid", "Void" };

    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<SalesInvoiceRow>? _rows;
    private List<FiscalPeriod>? _periods;
    private string _statusFilter = "All";
    private int? _periodFilter;
    private int? _selectedId;

    private List<SalesInvoiceRow> FilteredRows
    {
        get
        {
            if (_rows is null) return new();
            var rows = _statusFilter switch
            {
                "All" => _rows,
                // Zoho-style umbrella filter: anything posted and not yet fully paid, due or not.
                "Outstanding" => _rows.Where(r => r.Status is ArStatus.Pending or ArStatus.Overdue),
                _ => _rows.Where(r => r.Status.ToString() == _statusFilter),
            };
            return (_periodFilter is int periodId ? rows.Where(r => r.Invoice.FiscalPeriodId == periodId) : rows).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureInitialisedAsync();
        if (!Session.CanPost) { Nav.NavigateTo(""); return; }

        _periods = await Ledger.GetPeriodsAsync();
        await Load();
    }

    protected override void OnParametersSet()
    {
        if (Id is int id) _selectedId = id;
        else if (_selectedId is null && _rows is { Count: > 0 }) _selectedId = _rows[0].Invoice.Id;
    }

    private async Task Load()
    {
        _rows = await InvoiceSvc.GetAllAsync();
        if (_selectedId is null && _rows.Count > 0) _selectedId = Id ?? _rows[0].Invoice.Id;
    }

    private void SelectRow(SalesInvoiceRow row)
    {
        _selectedId = row.Invoice.Id;
        Nav.NavigateTo($"/sales-invoice/{row.Invoice.Id}");
    }

    private void OnFilterChanged(string s) => _statusFilter = s;

    private async Task OpenNew()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<NewSalesInvoiceDialog>("New Sales Invoice", options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await Load();
            if (result.Data is int newId)
            {
                _selectedId = newId;
                Nav.NavigateTo($"/sales-invoice/{newId}");
            }
        }
    }
}
