@page "/sales-invoice/{Id:int}"
@attribute [Authorize(Roles = AppRoles.Posters)]
@using AegisErp.Web.Components.Dialogs
@inject SalesInvoiceService InvoiceSvc
@inject CompanyService CompanySvc
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>@(_invoice?.InvoiceNo ?? "Invoice") · Aegis ERP</PageTitle>

@if (_loaded && _invoice is null)
{
    <MudAlert Severity="Severity.Error">Invoice not found.</MudAlert>
    <MudButton Class="mt-3" Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("sales-invoice"))">Back to Sales Invoices</MudButton>
}
else if (_invoice is not null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3 invoice-print-hide" Wrap="Wrap.Wrap">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("sales-invoice"))" />
        <MudText Typo="Typo.h5">@_invoice.InvoiceNo</MudText>
        <MudChip T="string" Size="Size.Small" Color="StatusColor(_status)" Variant="Variant.Text">@_status</MudChip>
        @if (_invoice.ApprovalStatus != ApprovalStatus.None)
        {
            <MudChip T="string" Size="Size.Small" Color="ApprovalColor(_invoice.ApprovalStatus)" Variant="Variant.Text">@ApprovalLabel(_invoice.ApprovalStatus)</MudChip>
        }
        <MudSpacer />
        @if (_invoice.Status == VoucherStatus.Draft)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditInvoice">Edit</MudButton>
        }
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" OnClick="Print">PDF/Print</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Email" OnClick="SendByEmail">Send by Email</MudButton>
        @if (_invoice.Status == VoucherStatus.Draft && _invoice.ApprovalStatus != ApprovalStatus.PendingApproval)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RateReview" OnClick="SubmitForApproval">Submit for Approval</MudButton>
        }
        @if (_invoice.ApprovalStatus == ApprovalStatus.PendingApproval && _canApprove)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" OnClick="Approve">Approve</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick="Reject">Reject</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Payments" OnClick="RecordPayment">Record Payment</MudButton>
        <MudMenu Icon="@Icons.Material.Filled.MoreVert">
            <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy" OnClick="Clone">Clone</MudMenuItem>
            @if (_invoice.Status == VoucherStatus.Draft)
            {
                <MudMenuItem Icon="@Icons.Material.Filled.Block" OnClick="VoidInvoice">Void</MudMenuItem>
            }
            @if (_invoice.JournalVoucher is not null)
            {
                <MudMenuItem Icon="@Icons.Material.Filled.MenuBook" OnClick="ViewJournal">View Journal</MudMenuItem>
            }
            <MudMenuItem Icon="@Icons.Material.Filled.Undo" OnClick="CreateCreditNote">Create Credit Note</MudMenuItem>
        </MudMenu>
    </MudStack>

    @if (_status is ArStatus.Overdue or ArStatus.Pending)
    {
        <MudAlert Severity="@(_status == ArStatus.Overdue ? Severity.Warning : Severity.Info)" Class="mb-3 invoice-print-hide">
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudText>@(_status == ArStatus.Overdue ? "Payment is overdue." : "Payment is not yet due.") Balance due: AED @_balance.ToString("N2").</MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="RecordPayment">Record Payment</MudButton>
            </MudStack>
        </MudAlert>
    }
    else if (_status == ArStatus.Draft)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3 invoice-print-hide">This invoice is a draft — it hasn't posted to the ledger yet. Edit it or post it when ready.</MudAlert>
    }

    @if (_invoice.ApprovalStatus == ApprovalStatus.PendingApproval)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3 invoice-print-hide">Pending approval — submitted by @_invoice.SubmittedForApprovalBy on @_invoice.SubmittedForApprovalAtUtc?.ToString("dd MMM yyyy"). Posting is blocked until this is approved or rejected.</MudAlert>
    }
    else if (_invoice.ApprovalStatus == ApprovalStatus.Rejected)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3 invoice-print-hide">Rejected by @_invoice.ApprovalDecisionBy on @_invoice.ApprovalDecisionAtUtc?.ToString("dd MMM yyyy")@(string.IsNullOrWhiteSpace(_invoice.ApprovalNote) ? "." : $": {_invoice.ApprovalNote}")</MudAlert>
    }

    @if (_creditedTotal > 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3 invoice-print-hide">
            This invoice also has @_creditedTotal.ToString("N2") credited via Credit Note(s) — reflected in the Balance Due below, not in the per-service breakdown.
        </MudAlert>
    }

    <MudPaper Class="pa-6 mb-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.h6">@_company?.LegalName</MudText>
                @if (!string.IsNullOrWhiteSpace(_company?.AddressLine1))
                {
                    <MudText Typo="Typo.body2">@_company!.AddressLine1</MudText>
                }
                @if (!string.IsNullOrWhiteSpace(_company?.City) || !string.IsNullOrWhiteSpace(_company?.AddressCountry))
                {
                    <MudText Typo="Typo.body2">@_company?.City @_company?.AddressCountry</MudText>
                }
                @if (!string.IsNullOrWhiteSpace(_company?.TrnNumber))
                {
                    <MudText Typo="Typo.body2">TRN: @_company!.TrnNumber</MudText>
                }
            </MudItem>
            <MudItem xs="12" sm="6" Class="text-right">
                <MudText Typo="Typo.h4">TAX INVOICE</MudText>
                <MudText Typo="Typo.body1"># @_invoice.InvoiceNo</MudText>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2">Bill To</MudText>
                <MudText Typo="Typo.body1">@_invoice.Customer.Name</MudText>
                @if (!string.IsNullOrWhiteSpace(_invoice.Customer.Trn))
                {
                    <MudText Typo="Typo.body2">TRN: @_invoice.Customer.Trn</MudText>
                }
                @if (!string.IsNullOrWhiteSpace(_invoice.CustomerPoNo))
                {
                    <MudText Typo="Typo.body2">PO No.: @_invoice.CustomerPoNo</MudText>
                }
                @if (!string.IsNullOrWhiteSpace(_invoice.DeliveryNoteRef))
                {
                    <MudText Typo="Typo.body2">Delivery Note Ref.: @_invoice.DeliveryNoteRef</MudText>
                }
                @if (!string.IsNullOrWhiteSpace(_invoice.SalesOrderRef))
                {
                    <MudText Typo="Typo.body2">Sales Order Ref.: @_invoice.SalesOrderRef</MudText>
                }
            </MudItem>
            <MudItem xs="12" sm="6" Class="text-right">
                <MudText Typo="Typo.body2">Invoice Date: @_invoice.Date.ToString("dd MMM yyyy")</MudText>
                <MudText Typo="Typo.body2">Due Date: @_invoice.DueDate.ToString("dd MMM yyyy")</MudText>
                <MudText Typo="Typo.h6" Class="mt-2">Balance Due: AED @_balance.ToString("N2")</MudText>
            </MudItem>
        </MudGrid>

        <MudTable Items="_invoice.Lines.OrderBy(l => l.LineNo)" Dense="true" Bordered="true" Elevation="0" Class="mt-4">
            <HeaderContent>
                <MudTh>#</MudTh>
                <MudTh>Item &amp; Description</MudTh>
                <MudTh Style="text-align:right">Qty</MudTh>
                <MudTh>UOM</MudTh>
                <MudTh Style="text-align:right">Rate</MudTh>
                <MudTh Style="text-align:right">Disc %</MudTh>
                <MudTh Style="text-align:right">Amount</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.LineNo</MudTd>
                <MudTd>@context.Description</MudTd>
                <MudTd Style="text-align:right">@context.Quantity.ToString("N2")</MudTd>
                <MudTd>@context.Uom</MudTd>
                <MudTd Style="text-align:right">@context.UnitPrice.ToString("N2")</MudTd>
                <MudTd Style="text-align:right">@(context.DiscountPercent > 0 ? context.DiscountPercent.ToString("N2") : "—")</MudTd>
                <MudTd Style="text-align:right">@context.Gross.ToString("N2")</MudTd>
            </RowTemplate>
        </MudTable>

        <MudStack Class="mt-3" AlignItems="AlignItems.End">
            <MudText>Net: @_invoice.TotalNet.ToString("N2")</MudText>
            <MudText>VAT: @_invoice.TotalVat.ToString("N2")</MudText>
            <MudText Typo="Typo.h6">Total: AED @_invoice.TotalGross.ToString("N2")</MudText>
        </MudStack>

        @{ var bank = _company?.BankAccounts.FirstOrDefault(a => a.IsPrimary) ?? _company?.BankAccounts.FirstOrDefault(); }
        @if (bank is not null)
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2">Payment Details</MudText>
            <MudText Typo="Typo.body2">Bank: @bank.BankName</MudText>
            @if (!string.IsNullOrWhiteSpace(bank.AccountName))
            {
                <MudText Typo="Typo.body2">Account Name: @bank.AccountName</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(bank.AccountNumber))
            {
                <MudText Typo="Typo.body2">Account No.: @bank.AccountNumber</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(bank.Iban))
            {
                <MudText Typo="Typo.body2">IBAN: @bank.Iban</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(bank.Swift))
            {
                <MudText Typo="Typo.body2">SWIFT: @bank.Swift</MudText>
            }
        }

        @if (!string.IsNullOrWhiteSpace(_invoice.Notes))
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2">Notes</MudText>
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap">@_invoice.Notes</MudText>
        }

        <MudDivider Class="my-4 invoice-print-hide" />
        <MudText Typo="Typo.subtitle2" Class="invoice-print-hide">Supporting Document</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2 invoice-print-hide" Wrap="Wrap.Wrap">
            @if (!string.IsNullOrWhiteSpace(_invoice.AttachmentFileName))
            {
                <MudChip T="string" Icon="@Icons.Material.Filled.AttachFile" Color="Color.Default">@_invoice.AttachmentFileName</MudChip>
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadAttachment">Download</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="RemoveAttachment">Remove</MudButton>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">No document attached.</MudText>
            }
            <MudFileUpload T="IBrowserFile" FilesChanged="OnAttachmentSelected" Accept=".pdf,.jpg,.jpeg,.png">
                <ActivatorContent>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile">
                        @(string.IsNullOrWhiteSpace(_invoice.AttachmentFileName) ? "Attach document" : "Replace")
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudStack>

        <div class="sig-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:2rem">
            <div style="display:flex;flex-direction:column;gap:8px">
                <div style="height:1px;background:rgba(0,0,0,0.2)"></div>
                <MudText Typo="Typo.caption" Align="Align.Center" Class="mud-text-secondary">Authorised Signature &amp; Stamp</MudText>
            </div>
            <div style="display:flex;flex-direction:column;gap:8px">
                <div style="height:1px;background:rgba(0,0,0,0.2)"></div>
                <MudText Typo="Typo.caption" Align="Align.Center" Class="mud-text-secondary">Customer Acknowledgement</MudText>
            </div>
        </div>

        <FastTab Title="Audit Trail" StartOpen="false" Class="mt-4 invoice-print-hide">
            @foreach (var entry in AuditEntries())
            {
                <MudStack Row="true" Spacing="1" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Size="Size.Small" Class="mt-1" Style="font-size:8px" />
                    <div>
                        <MudText Typo="Typo.body2">@entry.Text</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-tertiary">@entry.At.ToString("dd MMM yyyy · HH:mm")</MudText>
                    </div>
                </MudStack>
            }
        </FastTab>
    </MudPaper>

    @if (_lineBalances is not null && _lineBalances.Count > 1)
    {
        <FastTab Title="Per-Service Payment Status" Class="invoice-print-hide">
            <MudTable Items="_lineBalances" Dense="true" Bordered="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Service / Description</MudTh>
                    <MudTh Style="text-align:right">Amount</MudTh>
                    <MudTh Style="text-align:right">Paid</MudTh>
                    <MudTh Style="text-align:right">Balance</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@(context.ItemName is null ? context.Description : $"{context.ItemName} — {context.Description}")</MudTd>
                    <MudTd Style="text-align:right">@context.Gross.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right">@context.Allocated.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right;font-weight:600">@context.Balance.ToString("N2")</MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small" Color="LineStatusColor(context)" Variant="Variant.Text">@LineStatusLabel(context)</MudChip></MudTd>
                </RowTemplate>
            </MudTable>
        </FastTab>
    }
}

<style>
    @@media print {
        .mud-appbar, .mud-drawer, .invoice-print-hide { display: none !important; }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private SalesInvoice? _invoice;
    private bool _loaded;
    private List<SalesInvoiceLineBalance>? _lineBalances;
    private decimal _creditedTotal;
    private CompanySetup? _company;
    private decimal _balance;
    private ArStatus _status;
    private bool _canApprove;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _invoice = await InvoiceSvc.GetByIdAsync(Id);
        _loaded = true;
        if (_invoice is null) return;

        _lineBalances = await InvoiceSvc.GetLineBalancesAsync(Id);
        _creditedTotal = await InvoiceSvc.GetCreditedTotalAsync(Id);
        try { _company = await CompanySvc.GetAsync(); }
        catch (PostingException) { _company = null; }

        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _canApprove = user.IsInRole(AppRoles.FirmAdmin) || user.IsInRole(AppRoles.Admin);
        }

        var totalAllocated = _lineBalances.Sum(l => l.Allocated) + _creditedTotal;
        _balance = _invoice.TotalGross - totalAllocated;
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        _status = _invoice.Status switch
        {
            VoucherStatus.Draft => ArStatus.Draft,
            VoucherStatus.Void => ArStatus.Void,
            _ => _balance <= 0 ? ArStatus.Paid : _invoice.DueDate < today ? ArStatus.Overdue : ArStatus.Pending,
        };
    }

    private async Task<string> CurrentUserAsync() =>
        AuthState is not null ? (await AuthState).User.Identity?.Name ?? "System Admin" : "System Admin";

    private async Task EditInvoice()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var parameters = new DialogParameters<NewSalesInvoiceDialog> { { x => x.Existing, _invoice } };
        var dialog = await DialogService.ShowAsync<NewSalesInvoiceDialog>("Edit Sales Invoice", parameters, options);
        if ((await dialog.Result) is { Canceled: false }) await Load();
    }

    private async Task Clone()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var parameters = new DialogParameters<NewSalesInvoiceDialog> { { x => x.CloneFrom, _invoice } };
        var dialog = await DialogService.ShowAsync<NewSalesInvoiceDialog>("New Sales Invoice", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is int newId)
            Nav.NavigateTo($"/sales-invoice/{newId}");
    }

    private async Task VoidInvoice()
    {
        try
        {
            await InvoiceSvc.VoidDraftAsync(Id, await CurrentUserAsync(), DateTime.UtcNow);
            Snackbar.Add("Invoice voided.", Severity.Success);
            await Load();
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SubmitForApproval()
    {
        try
        {
            await InvoiceSvc.SubmitForApprovalAsync(Id, await CurrentUserAsync(), DateTime.UtcNow);
            Snackbar.Add("Submitted for approval.", Severity.Success);
            await Load();
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task Approve()
    {
        try
        {
            await InvoiceSvc.ApproveAsync(Id, await CurrentUserAsync(), DateTime.UtcNow);
            Snackbar.Add("Invoice approved.", Severity.Success);
            await Load();
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task Reject()
    {
        var parameters = new DialogParameters<RejectInvoiceDialog> { { x => x.InvoiceNo, _invoice!.InvoiceNo } };
        var dialog = await DialogService.ShowAsync<RejectInvoiceDialog>("Reject Invoice", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            try
            {
                await InvoiceSvc.RejectAsync(Id, await CurrentUserAsync(), DateTime.UtcNow, result.Data as string);
                Snackbar.Add("Invoice rejected.", Severity.Success);
                await Load();
            }
            catch (PostingException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task SendByEmail()
    {
        var parameters = new DialogParameters<SendInvoiceEmailDialog> { { x => x.Invoice, _invoice! } };
        await DialogService.ShowAsync<SendInvoiceEmailDialog>("Send Invoice", parameters);
    }

    private async Task OnAttachmentSelected(IBrowserFile file)
    {
        if (file.Size > SalesInvoiceService.MaxAttachmentBytes)
        {
            Snackbar.Add($"That file is too large — the limit is {SalesInvoiceService.MaxAttachmentBytes / (1024 * 1024)} MB.", Severity.Error);
            return;
        }

        using var stream = file.OpenReadStream(SalesInvoiceService.MaxAttachmentBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        try
        {
            await InvoiceSvc.SetAttachmentAsync(Id, file.Name, file.ContentType, ms.ToArray());
            Snackbar.Add("Document attached.", Severity.Success);
            await Load();
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DownloadAttachment()
    {
        var att = await InvoiceSvc.GetAttachmentAsync(Id);
        if (att is null) return;
        var base64 = Convert.ToBase64String(att.Value.Data);
        await JS.InvokeVoidAsync("downloadFileFromBytes", att.Value.FileName, att.Value.ContentType, base64);
    }

    private async Task RemoveAttachment()
    {
        await InvoiceSvc.RemoveAttachmentAsync(Id);
        Snackbar.Add("Attachment removed.", Severity.Success);
        await Load();
    }

    private record AuditEntry(string Text, DateTime At);

    private List<AuditEntry> AuditEntries()
    {
        var entries = new List<AuditEntry> { new($"Invoice created by {_invoice!.CreatedBy}", _invoice.CreatedAtUtc) };
        if (_invoice.SubmittedForApprovalAtUtc is DateTime submittedAt)
            entries.Add(new($"Submitted for approval by {_invoice.SubmittedForApprovalBy}", submittedAt));
        if (_invoice.ApprovalDecisionAtUtc is DateTime decidedAt)
        {
            var verb = _invoice.ApprovalStatus == ApprovalStatus.Approved ? "Approved" : "Rejected";
            var note = _invoice.ApprovalStatus == ApprovalStatus.Rejected && !string.IsNullOrWhiteSpace(_invoice.ApprovalNote)
                ? $" — {_invoice.ApprovalNote}" : "";
            entries.Add(new($"{verb} by {_invoice.ApprovalDecisionBy}{note}", decidedAt));
        }
        if (_invoice.PostedAtUtc is DateTime postedAt)
            entries.Add(new($"Posted by {_invoice.PostedBy}", postedAt));
        if (_invoice.VoidedAtUtc is DateTime voidedAt)
            entries.Add(new($"Voided by {_invoice.VoidedBy}", voidedAt));
        return entries.OrderBy(e => e.At).ToList();
    }

    private void RecordPayment() => Nav.NavigateTo($"/receipt-voucher?customerId={_invoice!.CustomerId}&invoiceId={Id}");
    private void ViewJournal() => Nav.NavigateTo($"/general-ledger?voucherNo={Uri.EscapeDataString(_invoice!.JournalVoucher!.VoucherNo)}");
    private void CreateCreditNote() => Nav.NavigateTo($"/credit-note?invoiceId={Id}");

    private async Task Print() => await JS.InvokeVoidAsync("print");

    private static Color StatusColor(ArStatus status) => status switch
    {
        ArStatus.Draft => Color.Default,
        ArStatus.Pending => Color.Info,
        ArStatus.Overdue => Color.Error,
        ArStatus.Paid => Color.Success,
        ArStatus.Void => Color.Dark,
        _ => Color.Default,
    };

    private static string ApprovalLabel(ApprovalStatus status) => status switch
    {
        ApprovalStatus.PendingApproval => "Pending Approval",
        ApprovalStatus.Approved => "Approved",
        ApprovalStatus.Rejected => "Rejected",
        _ => "",
    };

    private static Color ApprovalColor(ApprovalStatus status) => status switch
    {
        ApprovalStatus.PendingApproval => Color.Warning,
        ApprovalStatus.Approved => Color.Success,
        ApprovalStatus.Rejected => Color.Error,
        _ => Color.Default,
    };

    private static string LineStatusLabel(SalesInvoiceLineBalance l) =>
        l.Balance <= 0 ? "Paid" : l.Allocated > 0 ? "Partially Paid" : "Unpaid";

    private static Color LineStatusColor(SalesInvoiceLineBalance l) =>
        l.Balance <= 0 ? Color.Success : l.Allocated > 0 ? Color.Info : Color.Default;
}
