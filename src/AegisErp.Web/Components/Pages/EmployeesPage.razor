@page "/employees"
@page "/employees/{Id:int?}"
@attribute [Authorize]
@using AegisErp.Web.Components.Dialogs
@inject EmployeeService EmployeeSvc
@inject NavigationManager Nav
@inject CompanySession Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Employees · Aegis ERP</PageTitle>

@if (!_ready)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.h5">Employees</MudText>
        <MudSpacer />
        @if (Session.CanAccessPayroll)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenNewForm">New Employee</MudButton>
        }
    </MudStack>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Class="employee-list-pane" Elevation="1">
                @if (_employees is null)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (_employees.Count == 0)
                {
                    <MudText Class="pa-4 mud-text-secondary">No employees yet.</MudText>
                }
                else
                {
                    @foreach (var m in _employees)
                    {
                        <div class="employee-row @(m.Id == _selectedId ? "selected" : "")" @onclick="@(() => SelectRow(m))">
                            <div class="employee-row-top">
                                <span class="employee-row-name">@m.FullName</span>
                                <span class="employee-row-amount">@m.GrossSalary.ToString("N2")</span>
                            </div>
                            <div class="employee-row-meta">@m.EmployeeCode</div>
                        </div>
                    }
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="8">
            @if (_selectedId is int id)
            {
                <EmployeeDetailPanel @key="id" EmployeeId="id" OnChanged="Load" />
            }
            else
            {
                <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" Elevation="1" Style="min-height:300px">
                    <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Large" Class="mud-text-secondary mb-2" />
                    <MudText Class="mud-text-secondary">Select an employee on the left to view their details.</MudText>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}

<style>
    .employee-list-pane { max-height: calc(100vh - 220px); overflow-y: auto; }
    .employee-row { padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-lines-default); cursor: pointer; }
    .employee-row:hover { background: var(--mud-palette-action-default-hover); }
    .employee-row.selected { background: var(--mud-palette-primary-hover); border-left: 3px solid var(--mud-palette-primary); }
    .employee-row-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .employee-row-name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .employee-row-amount { font-weight: 600; white-space: nowrap; }
    .employee-row-meta { font-size: 12px; color: var(--mud-palette-text-secondary); margin-top: 2px; }
</style>

@code {
    [Parameter] public int? Id { get; set; }

    private bool _ready;
    private List<Employee>? _employees;
    private int? _selectedId;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureInitialisedAsync();
        if (!Session.CanAccessPayroll)
        {
            Snackbar.Add("You don't have access to HR & Payroll for this company.", Severity.Error);
            Nav.NavigateTo("");
            return;
        }

        _ready = true;
        await Load();
    }

    protected override void OnParametersSet()
    {
        if (Id is int id) _selectedId = id;
        else if (_selectedId is null && _employees is { Count: > 0 }) _selectedId = _employees[0].Id;
    }

    private async Task Load()
    {
        _employees = await EmployeeSvc.GetAllAsync();
        if (_selectedId is null && _employees.Count > 0) _selectedId = Id ?? _employees[0].Id;
    }

    private void SelectRow(Employee m)
    {
        _selectedId = m.Id;
        Nav.NavigateTo($"/employees/{m.Id}");
    }

    private async Task OpenNewForm()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<NewEmployeeDialog>("New Employee", options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await Load();
            if (result.Data is int newId)
            {
                _selectedId = newId;
                Nav.NavigateTo($"/employees/{newId}");
            }
        }
    }
}
