@page "/leads"
@page "/leads/{Id:int?}"
@attribute [Authorize]
@using AegisErp.Web.Components.Dialogs
@inject LeadService LeadSvc
@inject NavigationManager Nav
@inject CompanySession Session
@inject IDialogService DialogService

<PageTitle>Leads · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">Leads</MudText>
    <MudSpacer />
    @if (Session.CanPost)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNewForm">New Lead</MudButton>
    }
</MudStack>

<MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mb-3">
    @foreach (var stage in AllStages)
    {
        <MudChip T="string" Size="Size.Small" Color="@(_stageFilter == stage ? Color.Primary : Color.Default)"
                 Variant="@(_stageFilter == stage ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => SetStageFilter(stage))">
            @stage: @StageCount(stage)
        </MudChip>
    }
    <MudChip T="string" Size="Size.Small" Color="@(_stageFilter is null ? Color.Primary : Color.Default)"
             Variant="@(_stageFilter is null ? Variant.Filled : Variant.Outlined)"
             OnClick="@(() => SetStageFilter(null))">
        All: @(_allLeads?.Count ?? 0)
    </MudChip>
</MudStack>

<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="lead-list-pane" Elevation="1">
            @if (_allLeads is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (FilteredLeads().Count == 0)
            {
                <MudText Class="pa-4 mud-text-secondary">No leads match this filter.</MudText>
            }
            else
            {
                @foreach (var l in FilteredLeads())
                {
                    <div class="lead-row @(l.Id == _selectedId ? "selected" : "")" @onclick="@(() => SelectRow(l))">
                        <div class="lead-row-top">
                            <span class="lead-row-name">@l.Name</span>
                            <span class="lead-row-amount">@(l.EstimatedValue?.ToString("N2") ?? "—")</span>
                        </div>
                        <div class="lead-row-meta">@l.Stage @(l.CompanyName is null ? "" : $"· {l.CompanyName}")</div>
                    </div>
                }
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="8">
        @if (_selectedId is int id)
        {
            <LeadDetailPanel @key="id" LeadId="id" OnChanged="Load" />
        }
        else
        {
            <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" Elevation="1" Style="min-height:300px">
                <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Large" Class="mud-text-secondary mb-2" />
                <MudText Class="mud-text-secondary">Select a lead on the left to view its details.</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

<style>
    .lead-list-pane { max-height: calc(100vh - 280px); overflow-y: auto; }
    .lead-row { padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-lines-default); cursor: pointer; }
    .lead-row:hover { background: var(--mud-palette-action-default-hover); }
    .lead-row.selected { background: var(--mud-palette-primary-hover); border-left: 3px solid var(--mud-palette-primary); }
    .lead-row-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .lead-row-name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .lead-row-amount { font-weight: 600; white-space: nowrap; }
    .lead-row-meta { font-size: 12px; color: var(--mud-palette-text-secondary); margin-top: 2px; }
</style>

@code {
    [Parameter] public int? Id { get; set; }

    private static readonly LeadStage[] AllStages = { LeadStage.New, LeadStage.Contacted, LeadStage.Qualified, LeadStage.Won, LeadStage.Lost };

    private List<Lead>? _allLeads;
    private LeadStage? _stageFilter;
    private int? _selectedId;

    protected override async Task OnInitializedAsync() => await Load();

    protected override void OnParametersSet()
    {
        if (Id is int id) _selectedId = id;
        else if (_selectedId is null && FilteredLeads() is { Count: > 0 } leads) _selectedId = leads[0].Id;
    }

    private async Task Load()
    {
        _allLeads = await LeadSvc.GetAllAsync();
        if (_selectedId is null && FilteredLeads() is { Count: > 0 } leads) _selectedId = Id ?? leads[0].Id;
    }

    private List<Lead> FilteredLeads() =>
        _allLeads is null ? new() :
        _stageFilter is null ? _allLeads : _allLeads.Where(l => l.Stage == _stageFilter).ToList();

    private int StageCount(LeadStage stage) => _allLeads?.Count(l => l.Stage == stage) ?? 0;

    private void SetStageFilter(LeadStage? stage) => _stageFilter = stage;

    private void SelectRow(Lead l)
    {
        _selectedId = l.Id;
        Nav.NavigateTo($"/leads/{l.Id}");
    }

    private async Task OpenNewForm()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<NewLeadDialog>("New Lead", options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await Load();
            if (result.Data is int newId)
            {
                _selectedId = newId;
                Nav.NavigateTo($"/leads/{newId}");
            }
        }
    }
}
