@page "/assets"
@page "/assets/{Id:int?}"
@attribute [Authorize]
@using AegisErp.Web.Components.Dialogs
@inject FixedAssetService AssetSvc
@inject LedgerService Ledger
@inject NavigationManager Nav
@inject CompanySession Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Fixed Assets · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">Fixed Assets</MudText>
    <MudSpacer />
    @if (Session.CanPost)
    {
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="OpenRunDepreciation">Run Depreciation</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNewForm">New Asset</MudButton>
    }
</MudStack>

<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="asset-list-pane" Elevation="1">
            @if (_assets is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_assets.Count == 0)
            {
                <MudText Class="pa-4 mud-text-secondary">No fixed assets yet.</MudText>
            }
            else
            {
                @foreach (var a in _assets)
                {
                    <div class="asset-row @(a.Id == _selectedId ? "selected" : "")" @onclick="@(() => SelectRow(a))">
                        <div class="asset-row-top">
                            <span class="asset-row-name">@a.Name</span>
                            <span class="asset-row-amount">@a.NetBookValue.ToString("N2")</span>
                        </div>
                        <div class="asset-row-meta">@a.AssetCode</div>
                    </div>
                }
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="8">
        @if (_selectedId is int id)
        {
            <AssetDetailPanel @key="id" AssetId="id" OnChanged="Load" />
        }
        else
        {
            <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" Elevation="1" Style="min-height:300px">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Class="mud-text-secondary mb-2" />
                <MudText Class="mud-text-secondary">Select an asset on the left to view its details.</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

<style>
    .asset-list-pane { max-height: calc(100vh - 220px); overflow-y: auto; }
    .asset-row { padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-lines-default); cursor: pointer; }
    .asset-row:hover { background: var(--mud-palette-action-default-hover); }
    .asset-row.selected { background: var(--mud-palette-primary-hover); border-left: 3px solid var(--mud-palette-primary); }
    .asset-row-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .asset-row-name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .asset-row-amount { font-weight: 600; white-space: nowrap; }
    .asset-row-meta { font-size: 12px; color: var(--mud-palette-text-secondary); margin-top: 2px; }
</style>

@code {
    [Parameter] public int? Id { get; set; }

    private List<FixedAsset>? _assets;
    private int? _selectedId;

    protected override async Task OnInitializedAsync() => await Load();

    protected override void OnParametersSet()
    {
        if (Id is int id) _selectedId = id;
        else if (_selectedId is null && _assets is { Count: > 0 }) _selectedId = _assets[0].Id;
    }

    private async Task Load()
    {
        _assets = await AssetSvc.GetAllAsync();
        if (_selectedId is null && _assets.Count > 0) _selectedId = Id ?? _assets[0].Id;
    }

    private void SelectRow(FixedAsset a)
    {
        _selectedId = a.Id;
        Nav.NavigateTo($"/assets/{a.Id}");
    }

    private async Task OpenNewForm()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<NewAssetDialog>("New Fixed Asset", options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await Load();
            if (result.Data is int newId)
            {
                _selectedId = newId;
                Nav.NavigateTo($"/assets/{newId}");
            }
        }
    }

    private async Task OpenRunDepreciation()
    {
        var periods = await Ledger.GetPeriodsAsync();
        var parameters = new DialogParameters { { "Periods", periods } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<RunDepreciationDialog>("Run Depreciation", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is int fiscalPeriodId)
        {
            try
            {
                var voucher = await AssetSvc.RunDepreciationAsync(fiscalPeriodId, "System Admin", DateTime.UtcNow);
                Snackbar.Add(voucher is null
                    ? "Nothing was due for depreciation in that period."
                    : $"Depreciation posted — voucher {voucher.VoucherNo}.", Severity.Success);
                await Load();
            }
            catch (PostingException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}
