@page "/payment-voucher"
@page "/payment-voucher/{Id:int?}"
@attribute [Authorize]
@using AegisErp.Web.Components.Dialogs
@inject VendorPaymentService PaymentSvc
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject CompanySession Session

<PageTitle>Payment Voucher · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">Payment Voucher</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenNew(null, null))">
        New Payment
    </MudButton>
</MudStack>

<MudText Typo="Typo.subtitle1" Class="mb-2">Payments</MudText>
<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="payment-list-pane" Elevation="1">
            @if (_recent is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_recent.Count == 0)
            {
                <MudText Class="pa-4 mud-text-secondary">No payments yet.</MudText>
            }
            else
            {
                @foreach (var p in _recent)
                {
                    <div class="payment-row @(p.Id == _selectedId ? "selected" : "")" @onclick="@(() => SelectRow(p))">
                        <div class="payment-row-top">
                            <span class="payment-row-name">@p.Vendor.Name</span>
                            <span class="payment-row-amount">@p.Amount.ToString("N2")</span>
                        </div>
                        <div class="payment-row-meta">@p.PaymentNo · @p.Date.ToString("dd MMM yyyy")</div>
                        <div class="payment-row-status">
                            <MudChip T="string" Size="Size.Small" Color="StatusColor(p.Status)" Variant="Variant.Text">@p.Status</MudChip>
                        </div>
                    </div>
                }
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="8">
        @if (_selectedId is int id)
        {
            <PaymentVoucherDetailPanel @key="id" PaymentId="id" OnChanged="RefreshList" />
        }
        else
        {
            <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" Elevation="1" Style="min-height:300px">
                <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Large" Class="mud-text-secondary mb-2" />
                <MudText Class="mud-text-secondary">Select a payment on the left to view its details.</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

<style>
    .payment-list-pane { max-height: calc(100vh - 220px); overflow-y: auto; }
    .payment-row { padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-lines-default); cursor: pointer; }
    .payment-row:hover { background: var(--mud-palette-action-default-hover); }
    .payment-row.selected { background: var(--mud-palette-primary-hover); border-left: 3px solid var(--mud-palette-primary); }
    .payment-row-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .payment-row-name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .payment-row-amount { font-weight: 600; white-space: nowrap; }
    .payment-row-meta { font-size: 12px; color: var(--mud-palette-text-secondary); margin-top: 2px; }
    .payment-row-status { margin-top: 4px; }
</style>

@code {
    private List<VendorPayment>? _recent;
    private int? _selectedId;

    [Parameter] public int? Id { get; set; }

    [SupplyParameterFromQuery(Name = "vendorId")]
    [Parameter]
    public int? QueryVendorId { get; set; }

    [SupplyParameterFromQuery(Name = "invoiceId")]
    [Parameter]
    public int? QueryInvoiceId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureInitialisedAsync();
        if (!Session.CanPost) { Nav.NavigateTo(""); return; }

        _recent = await PaymentSvc.GetRecentAsync(50);
        if (_selectedId is null && _recent.Count > 0) _selectedId = Id ?? _recent[0].Id;

        // Arriving via a Purchase Invoice detail page's "Record Payment" action
        // (?vendorId=...&invoiceId=...) opens the dialog pre-filled instead of waiting for the
        // "New Payment" button.
        if (QueryVendorId is int vId) await OpenNew(vId, QueryInvoiceId);
    }

    protected override void OnParametersSet()
    {
        if (Id is int id) _selectedId = id;
        else if (_selectedId is null && _recent is { Count: > 0 }) _selectedId = _recent[0].Id;
    }

    private void SelectRow(VendorPayment p)
    {
        _selectedId = p.Id;
        Nav.NavigateTo($"/payment-voucher/{p.Id}");
    }

    private async Task RefreshList() => _recent = await PaymentSvc.GetRecentAsync(50);

    private static Color StatusColor(VoucherStatus status) => status switch
    {
        VoucherStatus.Draft => Color.Default,
        VoucherStatus.Posted => Color.Success,
        VoucherStatus.Void => Color.Dark,
        _ => Color.Default,
    };

    private async Task OpenNew(int? vendorId, int? invoiceId)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var parameters = new DialogParameters<NewPaymentVoucherDialog> { { x => x.VendorId, vendorId }, { x => x.InvoiceId, invoiceId } };
        var dialog = await DialogService.ShowAsync<NewPaymentVoucherDialog>("New Payment Voucher", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await RefreshList();
            if (result.Data is int newId)
            {
                _selectedId = newId;
                Nav.NavigateTo($"/payment-voucher/{newId}");
            }
        }
    }
}
