@page "/credit-note"
@page "/credit-note/{Id:int?}"
@attribute [Authorize(Roles = AppRoles.Posters)]
@using AegisErp.Web.Components.Dialogs
@inject CreditNoteService CreditNoteSvc
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Credit Note · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <div>
        <MudText Typo="Typo.h5">Credit Note</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            A credit issued to a customer (return, discount, correction).
        </MudText>
    </div>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenNew(null))">
        New Credit Note
    </MudButton>
</MudStack>

<MudText Typo="Typo.subtitle1" Class="mb-2">Credit Notes</MudText>
<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="cn-list-pane" Elevation="1">
            @if (_recent is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_recent.Count == 0)
            {
                <MudText Class="pa-4 mud-text-secondary">No credit notes yet.</MudText>
            }
            else
            {
                @foreach (var n in _recent)
                {
                    <div class="cn-row @(n.Id == _selectedId ? "selected" : "")" @onclick="@(() => SelectRow(n))">
                        <div class="cn-row-top">
                            <span class="cn-row-name">@n.Customer.Name</span>
                            <span class="cn-row-amount">@n.TotalGross.ToString("N2")</span>
                        </div>
                        <div class="cn-row-meta">@n.CreditNoteNo · @n.Date.ToString("dd MMM yyyy")</div>
                    </div>
                }
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="8">
        @if (_selectedId is int id)
        {
            <CreditNoteDetailPanel @key="id" CreditNoteId="id" />
        }
        else
        {
            <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" Elevation="1" Style="min-height:300px">
                <MudIcon Icon="@Icons.Material.Filled.Undo" Size="Size.Large" Class="mud-text-secondary mb-2" />
                <MudText Class="mud-text-secondary">Select a credit note on the left to view its details.</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

<style>
    .cn-list-pane { max-height: calc(100vh - 220px); overflow-y: auto; }
    .cn-row { padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-lines-default); cursor: pointer; }
    .cn-row:hover { background: var(--mud-palette-action-default-hover); }
    .cn-row.selected { background: var(--mud-palette-primary-hover); border-left: 3px solid var(--mud-palette-primary); }
    .cn-row-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .cn-row-name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cn-row-amount { font-weight: 600; white-space: nowrap; }
    .cn-row-meta { font-size: 12px; color: var(--mud-palette-text-secondary); margin-top: 2px; }
</style>

@code {
    private List<CreditNote>? _recent;
    private int? _selectedId;

    [Parameter] public int? Id { get; set; }

    [SupplyParameterFromQuery(Name = "invoiceId")]
    [Parameter]
    public int? QueryInvoiceId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _recent = await CreditNoteSvc.GetRecentAsync(50);
        if (_selectedId is null && _recent.Count > 0) _selectedId = Id ?? _recent[0].Id;

        // Arriving via a Sales Invoice detail page's "Create Credit Note" action (?invoiceId=...)
        // opens the dialog pre-filled instead of waiting for the "New Credit Note" button.
        if (QueryInvoiceId is int invId) await OpenNew(invId);
    }

    protected override void OnParametersSet()
    {
        if (Id is int id) _selectedId = id;
        else if (_selectedId is null && _recent is { Count: > 0 }) _selectedId = _recent[0].Id;
    }

    private void SelectRow(CreditNote n)
    {
        _selectedId = n.Id;
        Nav.NavigateTo($"/credit-note/{n.Id}");
    }

    private async Task RefreshList() => _recent = await CreditNoteSvc.GetRecentAsync(50);

    private async Task OpenNew(int? invoiceId)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var parameters = new DialogParameters<NewCreditNoteDialog> { { x => x.InvoiceId, invoiceId } };
        var dialog = await DialogService.ShowAsync<NewCreditNoteDialog>("New Credit Note", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await RefreshList();
            if (result.Data is int newId)
            {
                _selectedId = newId;
                Nav.NavigateTo($"/credit-note/{newId}");
            }
        }
    }
}
