@page "/estimate"
@page "/estimate/{Id:int?}"
@attribute [Authorize]
@using AegisErp.Web.Components.Dialogs
@inject EstimateService EstimateSvc
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Estimate / Quotation · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <div>
        <MudText Typo="Typo.h5">Estimate / Quotation</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            A non-posting quotation. It never touches the ledger — when a customer accepts it you can convert it into a posted sales invoice.
        </MudText>
    </div>
    <MudSpacer />
    <AuthorizeView Roles="@AppRoles.Posters">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNew">
            New Quotation
        </MudButton>
    </AuthorizeView>
</MudStack>

<MudText Typo="Typo.subtitle1" Class="mb-2">Quotations</MudText>
<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="est-list-pane" Elevation="1">
            @if (_recent is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_recent.Count == 0)
            {
                <MudText Class="pa-4 mud-text-secondary">No quotations yet.</MudText>
            }
            else
            {
                @foreach (var e in _recent)
                {
                    <div class="est-row @(e.Id == _selectedId ? "selected" : "")" @onclick="@(() => SelectRow(e))">
                        <div class="est-row-top">
                            <span class="est-row-name">@e.Customer.Name</span>
                            <span class="est-row-amount">@e.TotalGross.ToString("N2")</span>
                        </div>
                        <div class="est-row-meta">@e.EstimateNo · @e.Date.ToString("dd MMM yyyy")</div>
                        <div class="est-row-status">
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(e.Status)" Variant="Variant.Text">@e.Status</MudChip>
                        </div>
                    </div>
                }
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="8">
        @if (_selectedId is int id)
        {
            <EstimateDetailPanel @key="id" EstimateId="id" OnChanged="RefreshList" />
        }
        else
        {
            <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" Elevation="1" Style="min-height:300px">
                <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Size="Size.Large" Class="mud-text-secondary mb-2" />
                <MudText Class="mud-text-secondary">Select a quotation on the left to view its details.</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

<style>
    .est-list-pane { max-height: calc(100vh - 220px); overflow-y: auto; }
    .est-row { padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-lines-default); cursor: pointer; }
    .est-row:hover { background: var(--mud-palette-action-default-hover); }
    .est-row.selected { background: var(--mud-palette-primary-hover); border-left: 3px solid var(--mud-palette-primary); }
    .est-row-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .est-row-name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .est-row-amount { font-weight: 600; white-space: nowrap; }
    .est-row-meta { font-size: 12px; color: var(--mud-palette-text-secondary); margin-top: 2px; }
    .est-row-status { margin-top: 4px; }
</style>

@code {
    private List<Estimate>? _recent;
    private int? _selectedId;

    [Parameter] public int? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _recent = await EstimateSvc.GetRecentAsync(50);
        if (_selectedId is null && _recent.Count > 0) _selectedId = Id ?? _recent[0].Id;
    }

    protected override void OnParametersSet()
    {
        if (Id is int id) _selectedId = id;
        else if (_selectedId is null && _recent is { Count: > 0 }) _selectedId = _recent[0].Id;
    }

    private void SelectRow(Estimate e)
    {
        _selectedId = e.Id;
        Nav.NavigateTo($"/estimate/{e.Id}");
    }

    private async Task RefreshList() => _recent = await EstimateSvc.GetRecentAsync(50);

    private static Color StatusColor(DocumentStatus s) => s switch
    {
        DocumentStatus.Accepted => Color.Success,
        DocumentStatus.Declined => Color.Error,
        DocumentStatus.Converted => Color.Primary,
        DocumentStatus.Sent => Color.Info,
        _ => Color.Default
    };

    private async Task OpenNew()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<NewEstimateDialog>("New Quotation", options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await RefreshList();
            if (result.Data is int newId)
            {
                _selectedId = newId;
                Nav.NavigateTo($"/estimate/{newId}");
            }
        }
    }
}
