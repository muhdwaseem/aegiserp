@page "/estimate"
@attribute [Authorize]
@inject EstimateService EstimateSvc
@inject CustomerService CustomerSvc
@inject ChartOfAccountsService Coa
@inject LedgerService Ledger
@inject ISnackbar Snackbar

<PageTitle>Estimate / Quotation · Aegis ERP</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Estimate / Quotation</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
    A non-posting quotation. It never touches the ledger — when a customer accepts it you can convert it into a posted sales invoice.
</MudText>

<AuthorizeView Roles="@AppRoles.Posters" Context="edit">
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudSelect T="int" @bind-Value="_customerId" Label="Customer" Dense="true">
                    <MudSelectItem Value="0">— select —</MudSelectItem>
                    @if (_customers is not null)
                    {
                        @foreach (var c in _customers)
                        {
                            <MudSelectItem Value="c.Id">@c.Code — @c.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker Date="_date" DateChanged="OnDateChanged" Label="Estimate date" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker @bind-Date="_validUntil" Label="Valid until" />
            </MudItem>
            <MudItem xs="12" sm="2" />
            <MudItem xs="12">
                <MudTextField @bind-Value="_narration" Label="Narration" Placeholder="Defaults to 'Quotation — customer'" />
            </MudItem>
        </MudGrid>

        <MudTable Items="_lines" Dense="true" Bordered="true" Elevation="0" Class="mt-3 mb-2">
            <HeaderContent>
                <MudTh Style="width:40px">#</MudTh>
                <MudTh>Description</MudTh>
                <MudTh>Revenue Account</MudTh>
                <MudTh>Cost Center</MudTh>
                <MudTh Style="width:90px;text-align:right">Qty</MudTh>
                <MudTh Style="width:120px;text-align:right">Unit Price</MudTh>
                <MudTh Style="width:100px">VAT</MudTh>
                <MudTh Style="width:120px;text-align:right">Line Total</MudTh>
                <MudTh Style="width:48px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@(_lines.IndexOf(context) + 1)</MudTd>
                <MudTd><MudTextField @bind-Value="context.Description" Margin="Margin.Dense" Placeholder="Service / item" /></MudTd>
                <MudTd>
                    <MudSelect T="int" @bind-Value="context.RevenueAccountId" Dense="true" Margin="Margin.Dense">
                        <MudSelectItem Value="0">— select —</MudSelectItem>
                        @if (_revenueAccounts is not null)
                        {
                            @foreach (var a in _revenueAccounts)
                            {
                                <MudSelectItem Value="a.Id">@a.Code — @a.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudTd>
                <MudTd>
                    <MudSelect T="int?" @bind-Value="context.CostCenterId" Dense="true" Margin="Margin.Dense" Clearable="true">
                        @if (_costCenters is not null)
                        {
                            @foreach (var c in _costCenters)
                            {
                                <MudSelectItem T="int?" Value="c.Id">@c.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudTd>
                <MudTd><MudNumericField T="decimal" @bind-Value="context.Quantity" Min="0" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                <MudTd><MudNumericField T="decimal" @bind-Value="context.UnitPrice" Min="0" HideSpinButtons="true" Margin="Margin.Dense" /></MudTd>
                <MudTd>
                    <MudSelect T="decimal" @bind-Value="context.VatRate" Dense="true" Margin="Margin.Dense">
                        <MudSelectItem Value="0.05m">5%</MudSelectItem>
                        <MudSelectItem Value="0m">0%</MudSelectItem>
                    </MudSelect>
                </MudTd>
                <MudTd Style="text-align:right;font-weight:600">@context.Gross.ToString("N2")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => RemoveLine(context))" Disabled="_lines.Count <= 1" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" OnClick="AddLine">Add line</MudButton>
            <MudSpacer />
            <MudText Class="mr-4">Total: <b>AED @TotalGross.ToString("N2")</b></MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       Disabled="@(!CanSave || _saving)" OnClick="Save">Save Quotation</MudButton>
        </MudStack>
    </MudPaper>
</AuthorizeView>

@if (_recent is not null && _recent.Count > 0)
{
    <MudText Typo="Typo.subtitle1" Class="mb-2">Recent quotations</MudText>
    <MudTable Items="_recent" Dense="true" Hover="true" Bordered="true" T="Estimate">
        <HeaderContent>
            <MudTh>Estimate</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Valid Until</MudTh>
            <MudTh>Customer</MudTh>
            <MudTh Style="text-align:right">Total</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="width:280px">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="font-family:monospace">@context.EstimateNo</MudTd>
            <MudTd>@context.Date.ToString("yyyy-MM-dd")</MudTd>
            <MudTd>@context.ValidUntil.ToString("yyyy-MM-dd")</MudTd>
            <MudTd>@context.Customer.Name</MudTd>
            <MudTd Style="text-align:right;font-weight:600">@context.TotalGross.ToString("N2")</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)" Variant="Variant.Text">@context.Status</MudChip></MudTd>
            <MudTd>
                <AuthorizeView Roles="@AppRoles.Posters" Context="auth">
                    @if (context.Status == DocumentStatus.Draft)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => SetStatus(context, DocumentStatus.Sent))">Mark Sent</MudButton>
                    }
                    @if (context.Status is DocumentStatus.Draft or DocumentStatus.Sent)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="@(() => SetStatus(context, DocumentStatus.Accepted))">Accept</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => SetStatus(context, DocumentStatus.Declined))">Decline</MudButton>
                    }
                    @if (context.Status == DocumentStatus.Accepted)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ReceiptLong"
                                   Disabled="_converting" OnClick="@(() => Convert(context))">Convert to Invoice</MudButton>
                    }
                    @if (context.Status == DocumentStatus.Converted && context.ConvertedInvoice is not null)
                    {
                        <MudText Typo="Typo.caption" Style="font-family:monospace">→ @context.ConvertedInvoice.InvoiceNo</MudText>
                    }
                </AuthorizeView>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<Customer>? _customers;
    private List<Account>? _revenueAccounts;
    private List<CostCenter>? _costCenters;
    private List<FiscalPeriod>? _periods;
    private List<Estimate>? _recent;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string _userName = "System Admin";

    private int _customerId;
    private DateTime? _date = DateTime.Today;
    private DateTime? _validUntil = DateTime.Today.AddDays(30);
    private string? _narration;
    private bool _saving;
    private bool _converting;

    private readonly List<LineVm> _lines = new() { new() };

    private decimal TotalGross => _lines.Sum(l => l.Gross);
    private bool CanSave => _customerId > 0 && TotalGross > 0
                            && _lines.All(l => l.RevenueAccountId > 0 && !string.IsNullOrWhiteSpace(l.Description));

    protected override async Task OnInitializedAsync()
    {
        _customers = await CustomerSvc.GetAllAsync(activeOnly: true);
        var accounts = await Coa.GetAllAsync(postableOnly: true);
        _revenueAccounts = accounts.Where(a => a.Type == AccountType.Income).ToList();
        _costCenters = await Coa.GetCostCentersAsync();
        _periods = await Ledger.GetPeriodsAsync();
        _recent = await EstimateSvc.GetRecentAsync(10);
        if (AuthState is not null)
            _userName = (await AuthState).User.Identity?.Name ?? "System Admin";
    }

    private void OnDateChanged(DateTime? d)
    {
        _date = d;
        if (d is not null && (_validUntil is null || _validUntil < d))
            _validUntil = d.Value.AddDays(30);
    }

    private void AddLine() => _lines.Add(new());
    private void RemoveLine(LineVm l) { if (_lines.Count > 1) _lines.Remove(l); }

    private static Color StatusColor(DocumentStatus s) => s switch
    {
        DocumentStatus.Accepted => Color.Success,
        DocumentStatus.Declined => Color.Error,
        DocumentStatus.Converted => Color.Primary,
        DocumentStatus.Sent => Color.Info,
        _ => Color.Default
    };

    private async Task Save()
    {
        _saving = true;
        try
        {
            var inputs = _lines.Select(l => new EstimateLineInput(
                l.Description, l.RevenueAccountId, l.CostCenterId, l.Quantity, l.UnitPrice, l.VatRate));

            var est = await EstimateSvc.CreateAsync(
                _customerId, DateOnly.FromDateTime(_date ?? DateTime.Today),
                DateOnly.FromDateTime(_validUntil ?? DateTime.Today.AddDays(30)),
                _narration, _userName, inputs, DateTime.UtcNow);

            Snackbar.Add($"Saved quotation {est.EstimateNo}.", Severity.Success);
            _lines.Clear(); _lines.Add(new());
            _narration = null; _customerId = 0;
            _recent = await EstimateSvc.GetRecentAsync(10);
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _saving = false; }
    }

    private async Task SetStatus(Estimate est, DocumentStatus status)
    {
        try
        {
            await EstimateSvc.SetStatusAsync(est.Id, status);
            _recent = await EstimateSvc.GetRecentAsync(10);
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task Convert(Estimate est)
    {
        _converting = true;
        try
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var period = _periods?.FirstOrDefault(p => today >= p.StartDate && today <= p.EndDate)
                         ?? _periods?.LastOrDefault();
            if (period is null) { Snackbar.Add("No fiscal period available for conversion.", Severity.Error); return; }

            var inv = await EstimateSvc.ConvertToInvoiceAsync(est.Id, period.Id, _userName, DateTime.UtcNow);
            Snackbar.Add($"Converted {est.EstimateNo} → sales invoice {inv.InvoiceNo} (posted).", Severity.Success);
            _recent = await EstimateSvc.GetRecentAsync(10);
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _converting = false; }
    }

    private class LineVm
    {
        public string Description { get; set; } = "";
        public int RevenueAccountId { get; set; }
        public int? CostCenterId { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal VatRate { get; set; } = 0.05m;

        public decimal Net => Math.Round(Quantity * UnitPrice, 2, MidpointRounding.AwayFromZero);
        public decimal Vat => Math.Round(Net * VatRate, 2, MidpointRounding.AwayFromZero);
        public decimal Gross => Net + Vat;
    }
}
