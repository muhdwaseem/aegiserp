@page "/trial-balance"
@attribute [Authorize]
@inject LedgerService Ledger

<PageTitle>Trial Balance · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
    <MudText Typo="Typo.h5">Trial Balance</MudText>
    <MudSpacer />
    <MudTooltip Text="Configuration">
        <MudIconButton Icon="@Icons.Material.Filled.Tune" Color="@(_configOpen ? Color.Primary : Color.Default)"
                       OnClick="@(() => _configOpen = !_configOpen)" />
    </MudTooltip>
</MudStack>
@if (_fromDate is { } f && _toDate is { } t)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">From @f.ToString("dd MMM yyyy") To @t.ToString("dd MMM yyyy")</MudText>
}

@if (_configOpen)
{
    <MudPaper Class="pa-4 mb-3" Elevation="1">
        <MudText Typo="Typo.subtitle2" Class="mb-3">Configuration</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6" md="4" Class="cfg-row">
                <span>Show Opening Balance</span>
                <MudSwitch T="bool" @bind-Value="_showOpeningBalance" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" Class="cfg-row">
                <span>Show Transactions</span>
                <MudSwitch T="bool" @bind-Value="_showTransactions" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" Class="cfg-row">
                <span class="@(_showTransactions ? "" : "mud-text-secondary")">Nett Transactions only</span>
                <MudSwitch T="bool" @bind-Value="_nettTransactionsOnly" Color="Color.Primary" Disabled="!_showTransactions" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" Class="cfg-row">
                <span>Show Closing Balance</span>
                <MudSwitch T="bool" @bind-Value="_showClosingBalance" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" Class="cfg-row">
                <span>Show Percentages</span>
                <MudSwitch T="bool" @bind-Value="_showPercentages" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="string" @bind-Value="_format" Label="Format of Report" Dense="true">
                    <MudSelectItem Value="@("Detailed")">Detailed</MudSelectItem>
                    <MudSelectItem Value="@("Summary")">Summary</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="string" @bind-Value="_sortBy" Label="Sorting Method" Dense="true">
                    <MudSelectItem Value="@("Default")">Default (Code)</MudSelectItem>
                    <MudSelectItem Value="@("Name")">Name</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
    <MudSelect T="string" Value="_preset" ValueChanged="OnPresetChanged" Label="Date Range" Dense="true" Style="max-width:200px">
        @foreach (var p in Presets)
        {
            <MudSelectItem Value="p">@p</MudSelectItem>
        }
    </MudSelect>
    @if (_preset == "Custom")
    {
        <div style="max-width:160px">
            <MudDatePicker @bind-Date="_fromDate" Label="From" Margin="Margin.Dense" PickerVariant="PickerVariant.Dialog" />
        </div>
        <div style="max-width:160px">
            <MudDatePicker @bind-Date="_toDate" Label="To" Margin="Margin.Dense" PickerVariant="PickerVariant.Dialog" />
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="Load">Run Report</MudButton>
    }
    <MudSpacer />
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Report Basis: <b>Accrual</b></MudText>
</MudStack>

@if (_tb is not null)
{
    @if (_tb.IsBalanced)
    {
        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">In balance — total closing debits equal total closing credits.</MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">Out of balance by @Math.Abs(_tb.TotalClosingDebit - _tb.TotalClosingCredit).ToString("N2").</MudAlert>
    }

    <MudPaper Elevation="1" Class="pa-0">
        <div style="overflow-x:auto">
            <table class="tb-tbl">
                <thead>
                    <tr>
                        <th rowspan="2">Code</th>
                        <th rowspan="2">Account</th>
                        @if (_showOpeningBalance)
                        {
                            <th colspan="2" class="grp">Opening Balance</th>
                        }
                        @if (_showTransactions)
                        {
                            <th colspan="@(_nettTransactionsOnly ? 1 : 2)" class="grp">Transactions</th>
                        }
                        @if (_showClosingBalance)
                        {
                            <th colspan="2" class="grp">Closing Balance</th>
                        }
                        @if (_showPercentages)
                        {
                            <th rowspan="2">% of Total</th>
                        }
                    </tr>
                    <tr>
                        @if (_showOpeningBalance)
                        {
                            <th class="amt">Debit</th>
                            <th class="amt">Credit</th>
                        }
                        @if (_showTransactions)
                        {
                            @if (_nettTransactionsOnly)
                            {
                                <th class="amt">Net</th>
                            }
                            else
                            {
                                <th class="amt">Debit</th>
                                <th class="amt">Credit</th>
                            }
                        }
                        @if (_showClosingBalance)
                        {
                            <th class="amt">Debit</th>
                            <th class="amt">Credit</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (_format == "Detailed")
                    {
                        @foreach (var r in SortedRows)
                        {
                            <tr>
                                <td class="mono"><AccountLink AccountId="r.AccountId">@r.Code</AccountLink></td>
                                <td><AccountLink AccountId="r.AccountId">@r.Name</AccountLink></td>
                                @if (_showOpeningBalance)
                                {
                                    <td class="amt">@(r.OpeningDebit > 0 ? r.OpeningDebit.ToString("N2") : "")</td>
                                    <td class="amt">@(r.OpeningCredit > 0 ? r.OpeningCredit.ToString("N2") : "")</td>
                                }
                                @if (_showTransactions)
                                {
                                    @if (_nettTransactionsOnly)
                                    {
                                        <td class="amt">@NetLabel(r.PeriodDebit, r.PeriodCredit)</td>
                                    }
                                    else
                                    {
                                        <td class="amt">@(r.PeriodDebit > 0 ? r.PeriodDebit.ToString("N2") : "")</td>
                                        <td class="amt">@(r.PeriodCredit > 0 ? r.PeriodCredit.ToString("N2") : "")</td>
                                    }
                                }
                                @if (_showClosingBalance)
                                {
                                    <td class="amt">@(r.ClosingDebit > 0 ? r.ClosingDebit.ToString("N2") : "")</td>
                                    <td class="amt">@(r.ClosingCredit > 0 ? r.ClosingCredit.ToString("N2") : "")</td>
                                }
                                @if (_showPercentages)
                                {
                                    <td class="amt">@Pct(r.ClosingDebit != 0 ? r.ClosingDebit : r.ClosingCredit, _tb.TotalClosingDebit)</td>
                                }
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr class="tot">
                        <td colspan="2">Total (AED)</td>
                        @if (_showOpeningBalance)
                        {
                            <td class="amt">@_tb.TotalOpeningDebit.ToString("N2")</td>
                            <td class="amt">@_tb.TotalOpeningCredit.ToString("N2")</td>
                        }
                        @if (_showTransactions)
                        {
                            @if (_nettTransactionsOnly)
                            {
                                <td class="amt">@NetLabel(_tb.TotalPeriodDebit, _tb.TotalPeriodCredit)</td>
                            }
                            else
                            {
                                <td class="amt">@_tb.TotalPeriodDebit.ToString("N2")</td>
                                <td class="amt">@_tb.TotalPeriodCredit.ToString("N2")</td>
                            }
                        }
                        @if (_showClosingBalance)
                        {
                            <td class="amt">@_tb.TotalClosingDebit.ToString("N2")</td>
                            <td class="amt">@_tb.TotalClosingCredit.ToString("N2")</td>
                        }
                        @if (_showPercentages)
                        {
                            <td class="amt">100.0%</td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
    </MudPaper>
}

@code {
    private static readonly string[] Presets =
    {
        "Today", "This Week", "This Month", "Month To Date", "This Quarter", "Quarter To Date",
        "This Year", "Year To Date", "Previous Day", "Previous Week", "Previous Month",
        "Previous Quarter", "Previous Year", "Custom",
    };

    private string _preset = "This Month";
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private AegisErp.Infrastructure.Services.TrialBalanceMovement? _tb;

    private bool _configOpen;
    private bool _showOpeningBalance = true;
    private bool _showTransactions = true;
    private bool _nettTransactionsOnly;
    private bool _showClosingBalance = true;
    private bool _showPercentages;
    private string _format = "Detailed";
    private string _sortBy = "Default";

    private IEnumerable<TrialBalanceMovementRow> SortedRows =>
        _sortBy == "Name" ? _tb!.Rows.OrderBy(r => r.Name) : _tb!.Rows;

    protected override async Task OnInitializedAsync()
    {
        ApplyPreset(_preset);
        await Load();
    }

    private async Task OnPresetChanged(string preset)
    {
        ApplyPreset(preset);
        if (preset != "Custom") await Load();
    }

    /// <summary>Computes From/To for every preset except Custom, which leaves whatever the user
    /// last set in the date pickers untouched. Mirrors the P&amp;L page's preset logic.</summary>
    private void ApplyPreset(string preset)
    {
        _preset = preset;
        var today = DateTime.Today;
        int isoDow = today.DayOfWeek == DayOfWeek.Sunday ? 7 : (int)today.DayOfWeek; // Monday = 1
        var thisWeekStart = today.AddDays(1 - isoDow);
        int quarterStartMonth = ((today.Month - 1) / 3) * 3 + 1;
        var thisQuarterStart = new DateTime(today.Year, quarterStartMonth, 1);

        switch (preset)
        {
            case "Today":
                _fromDate = _toDate = today;
                break;
            case "This Week":
                _fromDate = thisWeekStart;
                _toDate = thisWeekStart.AddDays(6);
                break;
            case "This Month":
                _fromDate = new DateTime(today.Year, today.Month, 1);
                _toDate = _fromDate.Value.AddMonths(1).AddDays(-1);
                break;
            case "Month To Date":
                _fromDate = new DateTime(today.Year, today.Month, 1);
                _toDate = today;
                break;
            case "This Quarter":
                _fromDate = thisQuarterStart;
                _toDate = thisQuarterStart.AddMonths(3).AddDays(-1);
                break;
            case "Quarter To Date":
                _fromDate = thisQuarterStart;
                _toDate = today;
                break;
            case "This Year":
                _fromDate = new DateTime(today.Year, 1, 1);
                _toDate = new DateTime(today.Year, 12, 31);
                break;
            case "Year To Date":
                _fromDate = new DateTime(today.Year, 1, 1);
                _toDate = today;
                break;
            case "Previous Day":
                _fromDate = _toDate = today.AddDays(-1);
                break;
            case "Previous Week":
                var prevWeekStart = thisWeekStart.AddDays(-7);
                _fromDate = prevWeekStart;
                _toDate = prevWeekStart.AddDays(6);
                break;
            case "Previous Month":
                var prevMonth = today.AddMonths(-1);
                _fromDate = new DateTime(prevMonth.Year, prevMonth.Month, 1);
                _toDate = _fromDate.Value.AddMonths(1).AddDays(-1);
                break;
            case "Previous Quarter":
                var prevQuarterStart = thisQuarterStart.AddMonths(-3);
                _fromDate = prevQuarterStart;
                _toDate = prevQuarterStart.AddMonths(3).AddDays(-1);
                break;
            case "Previous Year":
                _fromDate = new DateTime(today.Year - 1, 1, 1);
                _toDate = new DateTime(today.Year - 1, 12, 31);
                break;
            case "Custom":
                break;
        }
    }

    private async Task Load()
    {
        if (_fromDate is not { } from || _toDate is not { } to) return;
        _tb = await Ledger.GetTrialBalanceAsync(DateOnly.FromDateTime(from), DateOnly.FromDateTime(to));
    }

    private static string Pct(decimal amount, decimal baseAmount) =>
        baseAmount == 0 ? "—" : (amount / baseAmount * 100m).ToString("N1") + "%";

    private static string NetLabel(decimal debit, decimal credit)
    {
        var net = debit - credit;
        if (net == 0) return "";
        return net > 0 ? $"{net:N2} Dr" : $"{-net:N2} Cr";
    }
}

<style>
    .tb-tbl { width:100%; border-collapse:collapse; font-size:13.5px; }
    .tb-tbl th, .tb-tbl td { padding:7px 12px; border-bottom:1px solid var(--mud-palette-lines-default); border-right:1px solid var(--mud-palette-lines-default); }
    .tb-tbl th:last-child, .tb-tbl td:last-child { border-right:0; }
    .tb-tbl thead th { background:var(--mud-palette-background-grey); text-align:left; font-weight:700; }
    .tb-tbl thead th.grp { text-align:center; }
    .tb-tbl th.amt, .tb-tbl td.amt { text-align:right; font-family:monospace; }
    .tb-tbl td.mono { font-family:monospace; color:var(--mud-palette-text-secondary); }
    .tb-tbl tbody tr:nth-child(even) { background:var(--mud-palette-action-default-hover); }
    .tb-tbl tbody tr:hover { background:var(--mud-palette-table-hover); }
    .tb-tbl tfoot td { font-weight:700; border-top:2px solid var(--mud-palette-lines-default); border-bottom:0; background:var(--mud-palette-background-grey); }
    .cfg-row { display:flex; justify-content:space-between; align-items:center; }
</style>
