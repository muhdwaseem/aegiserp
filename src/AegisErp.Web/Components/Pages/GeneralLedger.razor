@page "/general-ledger"
@attribute [Authorize]
@using System.Text
@using AegisErp.Web.Components.Dialogs
@inject LedgerService Ledger
@inject ChartOfAccountsService Coa
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>General Ledger · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h5">General Ledger</MudText>
    @if (_view is not null)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Dr: AED @_view.TotalDebit.ToString("N2") &nbsp; Cr: AED @_view.TotalCredit.ToString("N2") &nbsp; Bal: @BalanceText(_view.Closing)</MudText>
    }
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo("journal-voucher"))">New Voucher</MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.GridOn" OnClick="ExportExcel">Excel</MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="ExportPdf">PDF</MudButton>
</MudStack>

<MudPaper Class="pa-3 mb-4" Elevation="1" id="gl-print-hide">
    <MudGrid>
        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker @bind-Date="_fromDate" Label="From" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker @bind-Date="_toDate" Label="To" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int?" @bind-Value="_accountId" Label="Account" Dense="true" Clearable="true">
                <MudSelectItem T="int?" Value="@((int?)null)">— All Accounts —</MudSelectItem>
                @if (_accounts is not null)
                {
                    @foreach (var a in _accounts)
                    {
                        <MudSelectItem T="int?" Value="@((int?)a.Id)">@a.Code — @a.Name</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int?" @bind-Value="_costCenterId" Label="Cost Center" Dense="true" Clearable="true">
                <MudSelectItem T="int?" Value="@((int?)null)">All Cost Centers</MudSelectItem>
                @if (_costCenters is not null)
                {
                    @foreach (var c in _costCenters)
                    {
                        <MudSelectItem T="int?" Value="@((int?)c.Id)">@c.Name</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="VoucherType?" @bind-Value="_type" Label="Type" Dense="true" Clearable="true">
                <MudSelectItem T="VoucherType?" Value="@((VoucherType?)null)">All Types</MudSelectItem>
                @foreach (var t in Enum.GetValues<VoucherType>())
                {
                    <MudSelectItem T="VoucherType?" Value="@((VoucherType?)t)">@t</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="Load">Run</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<div id="gl-print">
@if (_view is not null)
{
    <MudStack Row="true" Spacing="4" Class="mb-3" Wrap="Wrap.Wrap">
        @SummaryCard("Opening", BalanceText(_view.Opening))
        @SummaryCard("Period Debit", _view.TotalDebit.ToString("N2"))
        @SummaryCard("Period Credit", _view.TotalCredit.ToString("N2"))
        @SummaryCard("Closing", BalanceText(_view.Closing), true)
    </MudStack>

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap" Spacing="2">
        <MudTextField @bind-Value="_search" Placeholder="Search voucher, narration, account…" Immediate="true" DebounceInterval="200"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense"
                      Variant="Variant.Outlined" Style="max-width:340px" />
        <MudChip T="string" Size="Size.Small" Variant="@(_type is null ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => SetTypeFilter(null))">All</MudChip>
        <MudChip T="string" Size="Size.Small" Variant="@(_type == VoucherType.Journal ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => SetTypeFilter(VoucherType.Journal))">Journal</MudChip>
        <MudChip T="string" Size="Size.Small" Variant="@(_type == VoucherType.Receipt ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => SetTypeFilter(VoucherType.Receipt))">Receipt</MudChip>
        <MudChip T="string" Size="Size.Small" Variant="@(_type == VoucherType.Payment ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => SetTypeFilter(VoucherType.Payment))">Payment</MudChip>
        <MudChip T="string" Size="Size.Small" Variant="@(_type == VoucherType.SalesInvoice ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => SetTypeFilter(VoucherType.SalesInvoice))">Sales Invoice</MudChip>
        <MudChip T="string" Size="Size.Small" Variant="@(_type == VoucherType.PurchaseInvoice ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => SetTypeFilter(VoucherType.PurchaseInvoice))">Purchase Invoice</MudChip>
    </MudStack>

    <MudTable Items="FilteredRows()" Dense="true" Hover="true" Bordered="true" Striped="true">
        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>Voucher</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Narration</MudTh>
            <MudTh>Account No.</MudTh>
            <MudTh>Account Name</MudTh>
            <MudTh>Cost Ctr</MudTh>
            <MudTh Style="text-align:right">Debit</MudTh>
            <MudTh Style="text-align:right">Credit</MudTh>
            <MudTh Style="text-align:right">Balance</MudTh>
            <MudTh>Posted By</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@context.Date.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Voucher" Style="font-family:monospace">
                <span class="gl-link" @onclick="() => ViewVoucher(context.VoucherNo)" @onclick:stopPropagation="true">@context.VoucherNo</span>
            </MudTd>
            <MudTd DataLabel="Type"><MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="TypeColor(context.Type)" title="@context.Type">@TypeAbbrev(context.Type)</MudChip></MudTd>
            <MudTd DataLabel="Narration">@context.Narration</MudTd>
            <MudTd DataLabel="Account No." Style="font-family:monospace"><AccountLink AccountId="context.AccountId" OnClick="FilterToAccount">@context.AccountCode</AccountLink></MudTd>
            <MudTd DataLabel="Account Name"><AccountLink AccountId="context.AccountId" OnClick="FilterToAccount">@context.AccountName</AccountLink></MudTd>
            <MudTd DataLabel="Cost Ctr">@context.CostCenter</MudTd>
            <MudTd DataLabel="Debit" Style="text-align:right">@(context.Debit > 0 ? context.Debit.ToString("N2") : "—")</MudTd>
            <MudTd DataLabel="Credit" Style="text-align:right">@(context.Credit > 0 ? context.Credit.ToString("N2") : "—")</MudTd>
            <MudTd DataLabel="Balance" Style="text-align:right;font-weight:600">@BalanceText(context.RunningBalance)</MudTd>
            <MudTd DataLabel="Posted By">@context.PostedBy</MudTd>
            <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">Posted</MudChip></MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4 mud-text-secondary">No posted entries match this filter in @_view.Period.</MudText>
        </NoRecordsContent>
    </MudTable>
}
</div>

@code {
    private List<Account>? _accounts;
    private List<CostCenter>? _costCenters;
    private int? _accountId;
    private int? _costCenterId;
    private VoucherType? _type;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private string _search = "";
    private GeneralLedgerView? _view;

    [SupplyParameterFromQuery(Name = "accountId")]
    [Parameter]
    public int? QueryAccountId { get; set; }

    [SupplyParameterFromQuery(Name = "voucherNo")]
    [Parameter]
    public string? QueryVoucherNo { get; set; }

    private int? _lastQueryAccountId;
    private string? _lastQueryVoucherNo;

    protected override async Task OnInitializedAsync()
    {
        _accounts = await Coa.GetAllAsync(postableOnly: true);
        _costCenters = await Coa.GetCostCentersAsync();

        var periods = await Ledger.GetPeriodsAsync();
        var latest = periods.LastOrDefault();
        _fromDate = latest?.StartDate.ToDateTime(TimeOnly.MinValue) ?? DateTime.Today.AddDays(-30);
        _toDate = latest?.EndDate.ToDateTime(TimeOnly.MinValue) ?? DateTime.Today;

        _accountId = QueryAccountId;
        _lastQueryAccountId = QueryAccountId;
        _lastQueryVoucherNo = QueryVoucherNo;
        if (!string.IsNullOrWhiteSpace(QueryVoucherNo)) await DrillVoucher(QueryVoucherNo);
        else await Load();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Drives the "open in ledger" links from Chart of Accounts (?accountId=) and the Sales
        // Invoice detail page's "View Journal" (?voucherNo=): navigating here again with a
        // different query string while already on this page only re-runs this, not OnInitialized.
        if (QueryAccountId != _lastQueryAccountId)
        {
            _lastQueryAccountId = QueryAccountId;
            _accountId = QueryAccountId;
            await Load();
        }
        if (QueryVoucherNo != _lastQueryVoucherNo)
        {
            _lastQueryVoucherNo = QueryVoucherNo;
            if (!string.IsNullOrWhiteSpace(QueryVoucherNo)) await DrillVoucher(QueryVoucherNo);
        }
    }

    private async Task Load()
    {
        if (_fromDate is null || _toDate is null) return;
        var from = DateOnly.FromDateTime(_fromDate.Value);
        var to = DateOnly.FromDateTime(_toDate.Value);
        _view = await Ledger.GetGeneralLedgerAsync(from, to, _accountId, _costCenterId, _type);
    }

    private async Task SetTypeFilter(VoucherType? type)
    {
        _type = type;
        await Load();
    }

    private static string TypeAbbrev(string type) => type switch
    {
        "Journal" => "JV",
        "Receipt" => "RV",
        "Payment" => "PV",
        "SalesInvoice" => "INV",
        "PurchaseInvoice" => "PINV",
        "CreditNote" => "CN",
        "DebitNote" => "DN",
        "Expense" => "EXP",
        "Opening" => "OB",
        _ => type,
    };

    private static Color TypeColor(string type) => type switch
    {
        "Receipt" => Color.Success,
        "Payment" => Color.Error,
        "SalesInvoice" => Color.Info,
        "PurchaseInvoice" => Color.Warning,
        "CreditNote" => Color.Error,
        "DebitNote" => Color.Warning,
        "Journal" => Color.Default,
        _ => Color.Default,
    };

    // Clears the account filter (so both legs of the entry are visible, whichever accounts they
    // hit) and searches for this voucher — used for deep links into this page (e.g. Sales
    // Invoice's "View Journal" button), which land on a pre-filtered General Ledger.
    private async Task DrillVoucher(string voucherNo)
    {
        _accountId = null;
        _search = voucherNo;
        await Load();
    }

    // Clicking a voucher link within the ledger's own rows pops up that specific voucher's
    // full detail instead of just filtering the table to its legs.
    private async Task ViewVoucher(string voucherNo)
    {
        var parameters = new DialogParameters<ViewVoucherDialog> { { x => x.VoucherNo, voucherNo } };
        await DialogService.ShowAsync<ViewVoucherDialog>("Voucher", parameters);
    }

    // Clicking an account within the ledger's own rows narrows the filter in place — a direct
    // state change rather than a URL round-trip, since we're already on this page.
    private async Task FilterToAccount(int accountId)
    {
        _accountId = accountId;
        _search = "";
        await Load();
    }

    private IEnumerable<GeneralLedgerRow> FilteredRows()
    {
        if (_view is null) return Enumerable.Empty<GeneralLedgerRow>();
        if (string.IsNullOrWhiteSpace(_search)) return _view.Rows;
        var q = _search.Trim();
        return _view.Rows.Where(r =>
            r.VoucherNo.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            r.Narration.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            r.AccountCode.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            r.AccountName.Contains(q, StringComparison.OrdinalIgnoreCase));
    }

    // Debit-positive, not sign-adjusted to any one account's normal side — meaningful here
    // because "All Accounts" mixes accounts that don't share the same normal balance.
    private static string BalanceText(decimal bal) => (bal >= 0 ? "Dr " : "Cr ") + Math.Abs(bal).ToString("N2");

    private async Task ExportExcel()
    {
        var sb = new StringBuilder();
        sb.AppendLine("Date,Voucher,Type,Narration,Account No,Account Name,Cost Center,Debit,Credit,Balance,Posted By");
        foreach (var r in FilteredRows())
            sb.AppendLine(string.Join(",",
                r.Date.ToString("yyyy-MM-dd"), Csv(r.VoucherNo), Csv(r.Type), Csv(r.Narration),
                Csv(r.AccountCode), Csv(r.AccountName), Csv(r.CostCenter),
                r.Debit.ToString("F2"), r.Credit.ToString("F2"), r.RunningBalance.ToString("F2"), Csv(r.PostedBy)));
        await JS.InvokeVoidAsync("aegisDownload", "general-ledger.csv", sb.ToString(), "text/csv");
    }

    private async Task ExportPdf() => await JS.InvokeVoidAsync("print");

    private static string Csv(string? s)
    {
        s ??= "";
        // Neutralize formula triggers (=, +, -, @, tab, CR) so Excel/LibreOffice/Sheets can't
        // execute an attacker-controlled narration/account name as a formula on open.
        if (s.Length > 0 && "=+-@\t\r".Contains(s[0])) s = "'" + s;
        return s.Contains(',') || s.Contains('"') || s.Contains('\n') ? "\"" + s.Replace("\"", "\"\"") + "\"" : s;
    }

    private RenderFragment SummaryCard(string Label, string Value, bool Bold = false) => __builder =>
    {
        <MudPaper Class="pa-3" Elevation="0" Style="min-width:150px;border:1px solid var(--mud-palette-lines-default)">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Label</MudText>
            <MudText Typo="Typo.h6" Style="@(Bold ? "font-weight:700" : "")">@Value</MudText>
        </MudPaper>
    };
}

<style>
    @@media print {
        .mud-appbar, .mud-drawer, #gl-print-hide { display:none !important; }
        .mud-main-content { padding:0 !important; }
    }
</style>
