@page "/general-ledger"
@attribute [Authorize]
@inject LedgerService Ledger
@inject ChartOfAccountsService Coa

<PageTitle>General Ledger · Aegis ERP</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">General Ledger</MudText>

<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="int?" Value="_accountId" ValueChanged="OnAccountChanged" Label="Account" Dense="true" Clearable="true">
                <MudSelectItem T="int?" Value="@((int?)null)">— All Accounts —</MudSelectItem>
                @if (_accounts is not null)
                {
                    @foreach (var a in _accounts)
                    {
                        <MudSelectItem T="int?" Value="@((int?)a.Id)">@a.Code — @a.Name</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int" Value="_periodId" ValueChanged="OnPeriodChanged" Label="Period" Dense="true">
                @if (_periods is not null)
                {
                    @foreach (var p in _periods)
                    {
                        <MudSelectItem Value="p.Id">@p.Name</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int?" Value="_costCenterId" ValueChanged="OnCostCenterChanged" Label="Cost Center" Dense="true" Clearable="true">
                <MudSelectItem T="int?" Value="@((int?)null)">All Cost Centers</MudSelectItem>
                @if (_costCenters is not null)
                {
                    @foreach (var c in _costCenters)
                    {
                        <MudSelectItem T="int?" Value="@((int?)c.Id)">@c.Name</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="VoucherType?" Value="_type" ValueChanged="OnTypeChanged" Label="Type" Dense="true" Clearable="true">
                <MudSelectItem T="VoucherType?" Value="@((VoucherType?)null)">All Types</MudSelectItem>
                @foreach (var t in Enum.GetValues<VoucherType>())
                {
                    <MudSelectItem T="VoucherType?" Value="@((VoucherType?)t)">@t</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_view is not null)
{
    <MudStack Row="true" Spacing="4" Class="mb-3" Wrap="Wrap.Wrap">
        @SummaryCard("Opening", BalanceText(_view.Opening))
        @SummaryCard("Period Debit", _view.TotalDebit.ToString("N2"))
        @SummaryCard("Period Credit", _view.TotalCredit.ToString("N2"))
        @SummaryCard("Closing", BalanceText(_view.Closing), true)
    </MudStack>

    <MudTextField @bind-Value="_search" Placeholder="Search voucher, narration, account…" Immediate="true" DebounceInterval="200"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense"
                  Variant="Variant.Outlined" Class="mb-3" Style="max-width:340px" />

    <MudTable Items="FilteredRows()" Dense="true" Hover="true" Bordered="true" Striped="true">
        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>Voucher</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Narration</MudTh>
            <MudTh>Account</MudTh>
            <MudTh>Cost Ctr</MudTh>
            <MudTh Style="text-align:right">Debit</MudTh>
            <MudTh Style="text-align:right">Credit</MudTh>
            <MudTh Style="text-align:right">Balance</MudTh>
            <MudTh>Posted By</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@context.Date.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Voucher" Style="font-family:monospace">@context.VoucherNo</MudTd>
            <MudTd DataLabel="Type"><MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.Type</MudChip></MudTd>
            <MudTd DataLabel="Narration">@context.Narration</MudTd>
            <MudTd DataLabel="Account">@context.AccountCode — @context.AccountName</MudTd>
            <MudTd DataLabel="Cost Ctr">@context.CostCenter</MudTd>
            <MudTd DataLabel="Debit" Style="text-align:right">@(context.Debit > 0 ? context.Debit.ToString("N2") : "—")</MudTd>
            <MudTd DataLabel="Credit" Style="text-align:right">@(context.Credit > 0 ? context.Credit.ToString("N2") : "—")</MudTd>
            <MudTd DataLabel="Balance" Style="text-align:right;font-weight:600">@BalanceText(context.RunningBalance)</MudTd>
            <MudTd DataLabel="Posted By">@context.PostedBy</MudTd>
            <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">Posted</MudChip></MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4 mud-text-secondary">No posted entries match this filter in @_view.Period.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private List<Account>? _accounts;
    private List<FiscalPeriod>? _periods;
    private List<CostCenter>? _costCenters;
    private int? _accountId;
    private int _periodId;
    private int? _costCenterId;
    private VoucherType? _type;
    private string _search = "";
    private GeneralLedgerView? _view;

    protected override async Task OnInitializedAsync()
    {
        _accounts = await Coa.GetAllAsync(postableOnly: true);
        _periods = await Ledger.GetPeriodsAsync();
        _costCenters = await Coa.GetCostCentersAsync();
        _periodId = _periods.LastOrDefault()?.Id ?? 0;
        await Load();
    }

    private async Task OnAccountChanged(int? id) { _accountId = id; await Load(); }
    private async Task OnPeriodChanged(int id) { _periodId = id; await Load(); }
    private async Task OnCostCenterChanged(int? id) { _costCenterId = id; await Load(); }
    private async Task OnTypeChanged(VoucherType? t) { _type = t; await Load(); }

    private async Task Load()
    {
        if (_periodId > 0)
            _view = await Ledger.GetGeneralLedgerAsync(_periodId, _accountId, _costCenterId, _type);
    }

    private IEnumerable<GeneralLedgerRow> FilteredRows()
    {
        if (_view is null) return Enumerable.Empty<GeneralLedgerRow>();
        if (string.IsNullOrWhiteSpace(_search)) return _view.Rows;
        var q = _search.Trim();
        return _view.Rows.Where(r =>
            r.VoucherNo.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            r.Narration.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            r.AccountCode.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            r.AccountName.Contains(q, StringComparison.OrdinalIgnoreCase));
    }

    // Debit-positive, not sign-adjusted to any one account's normal side — meaningful here
    // because "All Accounts" mixes accounts that don't share the same normal balance.
    private static string BalanceText(decimal bal) => (bal >= 0 ? "Dr " : "Cr ") + Math.Abs(bal).ToString("N2");

    private RenderFragment SummaryCard(string Label, string Value, bool Bold = false) => __builder =>
    {
        <MudPaper Class="pa-3" Elevation="0" Style="min-width:150px;border:1px solid var(--mud-palette-lines-default)">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Label</MudText>
            <MudText Typo="Typo.h6" Style="@(Bold ? "font-weight:700" : "")">@Value</MudText>
        </MudPaper>
    };
}
