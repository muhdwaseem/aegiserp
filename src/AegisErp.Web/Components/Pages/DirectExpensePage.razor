@page "/expenses"
@page "/expenses/{Id:int?}"
@attribute [Authorize(Roles = AppRoles.Posters)]
@using AegisErp.Web.Components.Dialogs
@inject DirectExpenseService ExpenseSvc
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Expenses · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <div>
        <MudText Typo="Typo.h5">Expenses</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            A direct cash/bank expense — no vendor invoice or Accounts Payable involved. Posts Dr expense account(s) / Cr the account paid through.
        </MudText>
    </div>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNew">
        New Expense
    </MudButton>
</MudStack>

<MudText Typo="Typo.subtitle1" Class="mb-2">Expenses</MudText>
<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="exp-list-pane" Elevation="1">
            @if (_recent is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_recent.Count == 0)
            {
                <MudText Class="pa-4 mud-text-secondary">No expenses yet.</MudText>
            }
            else
            {
                @foreach (var e in _recent)
                {
                    <div class="exp-row @(e.Id == _selectedId ? "selected" : "")" @onclick="@(() => SelectRow(e))">
                        <div class="exp-row-top">
                            <span class="exp-row-name">@AccountLabel(e)</span>
                            <span class="exp-row-amount">@e.TotalAmount.ToString("N2")</span>
                        </div>
                        <div class="exp-row-meta">@e.ExpenseNo · @e.Date.ToString("dd MMM yyyy")</div>
                    </div>
                }
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="8">
        @if (_selectedId is int id)
        {
            <DirectExpenseDetailPanel @key="id" ExpenseId="id" />
        }
        else
        {
            <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" Elevation="1" Style="min-height:300px">
                <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Large" Class="mud-text-secondary mb-2" />
                <MudText Class="mud-text-secondary">Select an expense on the left to view its details.</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

<style>
    .exp-list-pane { max-height: calc(100vh - 220px); overflow-y: auto; }
    .exp-row { padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-lines-default); cursor: pointer; }
    .exp-row:hover { background: var(--mud-palette-action-default-hover); }
    .exp-row.selected { background: var(--mud-palette-primary-hover); border-left: 3px solid var(--mud-palette-primary); }
    .exp-row-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .exp-row-name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .exp-row-amount { font-weight: 600; white-space: nowrap; }
    .exp-row-meta { font-size: 12px; color: var(--mud-palette-text-secondary); margin-top: 2px; }
</style>

@code {
    private List<DirectExpense>? _recent;
    private int? _selectedId;

    [Parameter] public int? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _recent = await ExpenseSvc.GetRecentAsync(50);
        if (_selectedId is null && _recent.Count > 0) _selectedId = Id ?? _recent[0].Id;
    }

    protected override void OnParametersSet()
    {
        if (Id is int id) _selectedId = id;
        else if (_selectedId is null && _recent is { Count: > 0 }) _selectedId = _recent[0].Id;
    }

    private void SelectRow(DirectExpense e)
    {
        _selectedId = e.Id;
        Nav.NavigateTo($"/expenses/{e.Id}");
    }

    private async Task RefreshList() => _recent = await ExpenseSvc.GetRecentAsync(50);

    private static string AccountLabel(DirectExpense e)
    {
        var names = e.Lines.Select(l => l.ExpenseAccount.Name).Distinct().ToList();
        return names.Count == 1 ? names[0] : $"{names.Count} accounts";
    }

    private async Task OpenNew()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<NewDirectExpenseDialog>("New Expense", options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await RefreshList();
            if (result.Data is int newId)
            {
                _selectedId = newId;
                Nav.NavigateTo($"/expenses/{newId}");
            }
        }
    }
}
