@page "/purchase-invoice"
@attribute [Authorize(Roles = AppRoles.Posters)]
@using AegisErp.Web.Components.Dialogs
@inject PurchaseInvoiceService InvoiceSvc
@inject IDialogService DialogService
@inject NavigationManager Nav

<PageTitle>Purchase Invoice · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">Purchase Invoices</MudText>
    <MudSpacer />
    <MudMenu>
        <ActivatorContent>
            <MudButton Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.ArrowDropDown">Related Documents</MudButton>
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem Icon="@Icons.Material.Filled.CreditCard" OnClick="@(() => Nav.NavigateTo("payment-voucher"))">Payment Voucher</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Redo" OnClick="@(() => Nav.NavigateTo("debit-note"))">Debit Note</MudMenuItem>
        </ChildContent>
    </MudMenu>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNew">
        New Invoice
    </MudButton>
</MudStack>

<MudTable Items="_invoices" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="_invoices is null"
          T="PurchaseInvoice" OnRowClick="@((TableRowClickEventArgs<PurchaseInvoice> e) => { if (e.Item is not null) Nav.NavigateTo($"/purchase-invoice/{e.Item.Id}"); })" RowStyle="cursor:pointer">
    <HeaderContent>
        <MudTh>Invoice</MudTh>
        <MudTh>Vendor Ref</MudTh>
        <MudTh>Date</MudTh>
        <MudTh>Due</MudTh>
        <MudTh>Vendor</MudTh>
        <MudTh Style="text-align:right">Net</MudTh>
        <MudTh Style="text-align:right">VAT</MudTh>
        <MudTh Style="text-align:right">Total</MudTh>
        <MudTh>GL Voucher</MudTh>
        <MudTh>Status</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd Style="font-family:monospace">@context.InvoiceNo</MudTd>
        <MudTd Style="font-family:monospace;font-size:11.5px">@context.VendorRef</MudTd>
        <MudTd>@context.Date.ToString("yyyy-MM-dd")</MudTd>
        <MudTd>@context.DueDate.ToString("yyyy-MM-dd")</MudTd>
        <MudTd>@context.Vendor.Name</MudTd>
        <MudTd Style="text-align:right">@context.TotalNet.ToString("N2")</MudTd>
        <MudTd Style="text-align:right">@context.TotalVat.ToString("N2")</MudTd>
        <MudTd Style="text-align:right;font-weight:600">@context.TotalGross.ToString("N2")</MudTd>
        <MudTd Style="font-family:monospace;font-size:11.5px">@context.JournalVoucher?.VoucherNo</MudTd>
        <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@context.Status</MudChip></MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4 mud-text-secondary">No invoices yet — click "New Invoice" to create one.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<PurchaseInvoice>? _invoices;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _invoices = await InvoiceSvc.GetAllAsync();

    private async Task OpenNew()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<NewPurchaseInvoiceDialog>("New Purchase Invoice", options);
        if ((await dialog.Result) is { Canceled: false }) await Load();
    }
}
