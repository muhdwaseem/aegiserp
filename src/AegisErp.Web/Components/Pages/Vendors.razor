@page "/vendors"
@attribute [Authorize]
@inject VendorService VendorSvc
@inject ISnackbar Snackbar

<PageTitle>Vendors · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">Vendors</MudText>
    <MudSpacer />
    <AuthorizeView Roles="@AppRoles.Posters">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenForm">New Vendor</MudButton>
    </AuthorizeView>
</MudStack>

@if (_showForm)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.subtitle1" Class="mb-3">New Vendor</MudText>
        <MudGrid>
            <MudItem xs="12" sm="3"><MudTextField Value="_nextCode" Label="Vendor No." ReadOnly="true" HelperText="Auto-generated" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_name" Label="Vendor Name" Required="true" /></MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="string" @bind-Value="_group" Label="Group" Clearable="true">
                    <MudSelectItem Value="@("Supplier")">Supplier</MudSelectItem>
                    <MudSelectItem Value="@("Contractor")">Contractor</MudSelectItem>
                    <MudSelectItem Value="@("Utility")">Utility</MudSelectItem>
                    <MudSelectItem Value="@("Government")">Government</MudSelectItem>
                    <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudSelect T="string" @bind-Value="_currency" Label="Currency">
                    <MudSelectItem Value="@("AED")">AED — UAE Dirham</MudSelectItem>
                    <MudSelectItem Value="@("USD")">USD — US Dollar</MudSelectItem>
                    <MudSelectItem Value="@("EUR")">EUR — Euro</MudSelectItem>
                    <MudSelectItem Value="@("GBP")">GBP — British Pound</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="int" @bind-Value="_terms" Label="Payment Terms">
                    <MudSelectItem Value="0">Immediate</MudSelectItem>
                    <MudSelectItem Value="15">Net 15</MudSelectItem>
                    <MudSelectItem Value="30">Net 30</MudSelectItem>
                    <MudSelectItem Value="45">Net 45</MudSelectItem>
                    <MudSelectItem Value="60">Net 60</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3"><MudTextField @bind-Value="_trn" Label="TRN / VAT No." Placeholder="Optional" /></MudItem>
            <MudItem xs="12" sm="3"><MudTextField @bind-Value="_phone" Label="Phone" Placeholder="Optional" /></MudItem>

            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_email" Label="Email" Placeholder="Optional" /></MudItem>
            <MudItem xs="12" sm="8"><MudTextField @bind-Value="_address" Label="Address" Placeholder="Optional" /></MudItem>
        </MudGrid>
        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check" OnClick="Save">Save Vendor</MudButton>
            <MudButton Variant="Variant.Text" OnClick="@(() => _showForm = false)">Cancel</MudButton>
        </MudStack>
    </MudPaper>
}

<MudTable Items="_summaries" Dense="true" Hover="true" Striped="true" Bordered="true" Loading="_summaries is null"
          T="VendorSummary" OnRowClick="RowClicked" RowClass="cursor-pointer">
    <HeaderContent>
        <MudTh>Code</MudTh>
        <MudTh>Name</MudTh>
        <MudTh>TRN</MudTh>
        <MudTh>Terms</MudTh>
        <MudTh Style="text-align:right">Billed</MudTh>
        <MudTh Style="text-align:right">Paid</MudTh>
        <MudTh Style="text-align:right">Outstanding</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd Style="font-family:monospace">@context.Code</MudTd>
        <MudTd>@context.Name</MudTd>
        <MudTd Style="font-family:monospace;font-size:11.5px">@context.Trn</MudTd>
        <MudTd>@context.PaymentTermsDays d</MudTd>
        <MudTd Style="text-align:right">@context.Billed.ToString("N2")</MudTd>
        <MudTd Style="text-align:right">@context.Paid.ToString("N2")</MudTd>
        <MudTd Style="text-align:right;font-weight:600" Class="@(context.Outstanding > 0 ? "mud-error-text" : "mud-success-text")">
            @context.Outstanding.ToString("N2")
        </MudTd>
    </RowTemplate>
</MudTable>
<MudText Typo="Typo.caption" Class="mud-text-secondary mt-1 d-block">
    Subledger totals reflect posted AP documents; the GL opening balance on Accounts Payable is not attributed to vendors. Click a row for the statement.
</MudText>

@if (_statementFor is not null)
{
    <MudPaper Class="pa-4 mt-4" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.subtitle1">Statement — @_statementFor.Name (@_statementFor.Code)</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _statementFor = null)" />
        </MudStack>
        <MudTable Items="_statement" Dense="true" Bordered="true" Striped="true">
            <HeaderContent>
                <MudTh>Date</MudTh>
                <MudTh>Document</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Narration</MudTh>
                <MudTh Style="text-align:right">Debit</MudTh>
                <MudTh Style="text-align:right">Credit</MudTh>
                <MudTh Style="text-align:right">Balance</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Date.ToString("yyyy-MM-dd")</MudTd>
                <MudTd Style="font-family:monospace">@context.DocNo</MudTd>
                <MudTd>@context.DocType</MudTd>
                <MudTd>@context.Narration</MudTd>
                <MudTd Style="text-align:right">@(context.Debit > 0 ? context.Debit.ToString("N2") : "—")</MudTd>
                <MudTd Style="text-align:right">@(context.Credit > 0 ? context.Credit.ToString("N2") : "—")</MudTd>
                <MudTd Style="text-align:right;font-weight:600">@context.RunningBalance.ToString("N2")</MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Class="pa-4 mud-text-secondary">No posted documents for this vendor.</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    private List<VendorSummary>? _summaries;
    private VendorSummary? _statementFor;
    private List<StatementRow> _statement = new();

    private bool _showForm;
    private string _nextCode = "";
    private string _name = "";
    private string? _group;
    private string _currency = "AED";
    private string? _trn;
    private string? _email;
    private string? _phone;
    private string? _address;
    private int _terms = 30;

    protected override async Task OnInitializedAsync() => _summaries = await VendorSvc.GetSummariesAsync();

    private async Task OpenForm()
    {
        _showForm = true;
        _nextCode = await VendorSvc.PeekNextCodeAsync();
    }

    private async Task Save()
    {
        try
        {
            var input = new NewVendorInput(_name, _group, _currency, _terms, _trn, _email, _phone, _address);
            var v = await VendorSvc.CreateAsync(input);
            Snackbar.Add($"Vendor {v.Code} created.", Severity.Success);
            _name = ""; _group = null; _currency = "AED";
            _trn = _email = _phone = _address = null; _terms = 30; _showForm = false;
            _summaries = await VendorSvc.GetSummariesAsync();
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RowClicked(TableRowClickEventArgs<VendorSummary> args)
    {
        if (args.Item is null) return;
        _statementFor = args.Item;
        _statement = await VendorSvc.GetStatementAsync(args.Item.Id);
    }
}
