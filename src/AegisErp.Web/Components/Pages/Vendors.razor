@page "/vendors"
@page "/vendors/{Id:int?}"
@attribute [Authorize]
@inject VendorService VendorSvc
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Vendors · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">Vendors</MudText>
    <MudSpacer />
    <AuthorizeView Roles="@AppRoles.Posters">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenForm">New Vendor</MudButton>
    </AuthorizeView>
</MudStack>

@if (_showForm)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.subtitle1" Class="mb-3">New Vendor</MudText>
        <MudGrid>
            <MudItem xs="12" sm="3"><MudTextField Value="_nextCode" Label="Vendor No." ReadOnly="true" HelperText="Auto-generated" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_name" Label="Vendor Name" Required="true" /></MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="string" @bind-Value="_group" Label="Group" Clearable="true">
                    <MudSelectItem Value="@("Supplier")">Supplier</MudSelectItem>
                    <MudSelectItem Value="@("Contractor")">Contractor</MudSelectItem>
                    <MudSelectItem Value="@("Utility")">Utility</MudSelectItem>
                    <MudSelectItem Value="@("Government")">Government</MudSelectItem>
                    <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudSelect T="string" @bind-Value="_currency" Label="Currency">
                    <MudSelectItem Value="@("AED")">AED — UAE Dirham</MudSelectItem>
                    <MudSelectItem Value="@("USD")">USD — US Dollar</MudSelectItem>
                    <MudSelectItem Value="@("EUR")">EUR — Euro</MudSelectItem>
                    <MudSelectItem Value="@("GBP")">GBP — British Pound</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="int" @bind-Value="_terms" Label="Payment Terms">
                    <MudSelectItem Value="0">Immediate</MudSelectItem>
                    <MudSelectItem Value="15">Net 15</MudSelectItem>
                    <MudSelectItem Value="30">Net 30</MudSelectItem>
                    <MudSelectItem Value="45">Net 45</MudSelectItem>
                    <MudSelectItem Value="60">Net 60</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3"><MudTextField @bind-Value="_trn" Label="TRN / VAT No." Placeholder="Optional" /></MudItem>
            <MudItem xs="12" sm="3"><MudTextField @bind-Value="_phone" Label="Phone" Placeholder="Optional" /></MudItem>

            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_email" Label="Email" Placeholder="Optional" /></MudItem>
            <MudItem xs="12" sm="8"><MudTextField @bind-Value="_address" Label="Address" Placeholder="Optional" /></MudItem>
        </MudGrid>
        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check" OnClick="Save">Save Vendor</MudButton>
            <MudButton Variant="Variant.Text" OnClick="@(() => _showForm = false)">Cancel</MudButton>
        </MudStack>
    </MudPaper>
}

<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="vendor-list-pane" Elevation="1">
            @if (_summaries is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_summaries.Count == 0)
            {
                <MudText Class="pa-4 mud-text-secondary">No vendors yet.</MudText>
            }
            else
            {
                @foreach (var v in _summaries)
                {
                    <div class="vendor-row @(v.Id == _selectedId ? "selected" : "")" @onclick="@(() => SelectRow(v))">
                        <div class="vendor-row-top">
                            <span class="vendor-row-name">@v.Name</span>
                            <span class="vendor-row-amount">@v.Outstanding.ToString("N2")</span>
                        </div>
                        <div class="vendor-row-meta">@v.Code</div>
                    </div>
                }
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="8">
        @if (_selectedId is int id)
        {
            <VendorDetailPanel @key="id" VendorId="id" OnChanged="Load" />
        }
        else
        {
            <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" Elevation="1" Style="min-height:300px">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Large" Class="mud-text-secondary mb-2" />
                <MudText Class="mud-text-secondary">Select a vendor on the left to view their details.</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

<style>
    .vendor-list-pane { max-height: calc(100vh - 220px); overflow-y: auto; }
    .vendor-row { padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-lines-default); cursor: pointer; }
    .vendor-row:hover { background: var(--mud-palette-action-default-hover); }
    .vendor-row.selected { background: var(--mud-palette-primary-hover); border-left: 3px solid var(--mud-palette-primary); }
    .vendor-row-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .vendor-row-name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .vendor-row-amount { font-weight: 600; white-space: nowrap; }
    .vendor-row-meta { font-size: 12px; color: var(--mud-palette-text-secondary); margin-top: 2px; }
</style>

@code {
    [Parameter] public int? Id { get; set; }

    private List<VendorSummary>? _summaries;
    private int? _selectedId;

    private bool _showForm;
    private string _nextCode = "";
    private string _name = "";
    private string? _group;
    private string _currency = "AED";
    private string? _trn;
    private string? _email;
    private string? _phone;
    private string? _address;
    private int _terms = 30;

    protected override async Task OnInitializedAsync() => await Load();

    protected override void OnParametersSet()
    {
        if (Id is int id) _selectedId = id;
        else if (_selectedId is null && _summaries is { Count: > 0 }) _selectedId = _summaries[0].Id;
    }

    private async Task Load()
    {
        _summaries = await VendorSvc.GetSummariesAsync();
        if (_selectedId is null && _summaries.Count > 0) _selectedId = Id ?? _summaries[0].Id;
    }

    private void SelectRow(VendorSummary v)
    {
        _selectedId = v.Id;
        Nav.NavigateTo($"/vendors/{v.Id}");
    }

    private async Task OpenForm()
    {
        _showForm = true;
        _nextCode = await VendorSvc.PeekNextCodeAsync();
    }

    private async Task Save()
    {
        try
        {
            var input = new NewVendorInput(_name, _group, _currency, _terms, _trn, _email, _phone, _address);
            var v = await VendorSvc.CreateAsync(input);
            Snackbar.Add($"Vendor {v.Code} created.", Severity.Success);
            _name = ""; _group = null; _currency = "AED";
            _trn = _email = _phone = _address = null; _terms = 30; _showForm = false;
            await Load();
            _selectedId = v.Id;
            Nav.NavigateTo($"/vendors/{v.Id}");
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
