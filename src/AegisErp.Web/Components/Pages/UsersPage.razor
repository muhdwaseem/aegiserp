@page "/users"
@attribute [Authorize]
@using AegisErp.Web.Components.Dialogs
@inject CompanyAccessService AccessSvc
@inject CompanySession Session
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Manage Team · Aegis ERP</PageTitle>

@if (_ready)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <div>
            <MudText Typo="Typo.h5">Manage Team</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Session.Active?.Name</MudText>
        </div>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AddUser">
            Add User
        </MudButton>
    </MudStack>

    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Everyone below can sign in and work in <b>@Session.Active?.Name</b> only — not any other company you may
        also have access to. <b>Admin</b> can manage settings and this list; <b>Accountant</b> can create and post
        documents; <b>Viewer</b> can see everything but not change it.
    </MudText>

    <MudTable Items="_members" Dense="true" Bordered="true" Striped="true" Loading="_members is null">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Email</MudTh>
            <MudTh Style="width:200px">Role</MudTh>
            <MudTh Style="width:130px">Payroll Access</MudTh>
            <MudTh Style="width:100px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.DisplayName</MudTd>
            <MudTd Style="font-family:monospace">@context.Email</MudTd>
            <MudTd>
                <MudSelect T="string" Value="context.Role" ValueChanged="@(r => ChangeRole(context, r))" Dense="true" Margin="Margin.Dense">
                    @foreach (var r in AppRoles.CompanyRoles)
                    {
                        <MudSelectItem T="string" Value="@r">@r</MudSelectItem>
                    }
                </MudSelect>
            </MudTd>
            <MudTd>
                @if (context.Role == AppRoles.Accountant)
                {
                    <MudCheckBox T="bool" Value="context.CanAccessPayroll" ValueChanged="@(v => TogglePayrollAccess(context, v))" Dense="true" />
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@(context.Role == AppRoles.Admin ? "Always" : "—")</MudText>
                }
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => Revoke(context))">Remove</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4 mud-text-secondary">
                No one else has been added yet — use <b>Add User</b> above to bring in your team.
            </MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private bool _ready;
    private List<CompanyMemberRow>? _members;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureInitialisedAsync();
        if (!Session.CanAdminister)
        {
            Snackbar.Add("Only an Admin can manage this company's team.", Severity.Error);
            Navigation.NavigateTo("");
            return;
        }

        _ready = true;
        await Load();
    }

    private async Task Load()
    {
        if (Session.Active is null) return;
        _members = await AccessSvc.GetMembersAsync(Session.Active.CompanyId);
    }

    private async Task AddUser()
    {
        if (Session.Active is null) return;
        var parameters = new DialogParameters<NewCompanyUserDialog>
        {
            { x => x.CompanyId, Session.Active.CompanyId },
            { x => x.CompanyName, Session.Active.Name },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<NewCompanyUserDialog>("Add User", parameters, options);
        if ((await dialog.Result) is { Canceled: false }) await Load();
    }

    private async Task ChangeRole(CompanyMemberRow member, string role)
    {
        if (Session.Active is null || role == member.Role) return;
        try
        {
            await AccessSvc.GrantAsync(member.UserId, Session.Active.CompanyId, role);
            Snackbar.Add($"{member.DisplayName} is now {role}.", Severity.Success);
            await Load();
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task TogglePayrollAccess(CompanyMemberRow member, bool canAccess)
    {
        if (Session.Active is null) return;
        try
        {
            await AccessSvc.SetPayrollAccessAsync(member.UserId, Session.Active.CompanyId, canAccess);
            Snackbar.Add(canAccess ? $"{member.DisplayName} can now access HR & Payroll." : $"{member.DisplayName}'s payroll access was removed.", Severity.Success);
            await Load();
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task Revoke(CompanyMemberRow member)
    {
        if (Session.Active is null) return;
        try
        {
            await AccessSvc.RevokeAsync(member.UserId, Session.Active.CompanyId);
            Snackbar.Add($"{member.DisplayName} no longer has access.", Severity.Info);
            await Load();
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
