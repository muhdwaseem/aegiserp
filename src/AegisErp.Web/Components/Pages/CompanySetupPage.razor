@page "/company-setup"
@page "/company-setup/new"
@attribute [Authorize]
@inject CompanyService Company
@inject CompanySession Session
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>@(_isNew ? "New Company" : "Company Setup") · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <div>
        <MudText Typo="Typo.h5">@(_isNew ? "New Company" : "Company Setup")</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @(_isNew
                ? "Complete the setup below to create the company."
                : $"Configure company · {_c?.CompanyCode}")
        </MudText>
    </div>
    <MudSpacer />
    @if (_isNew)
    {
        <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("companies"))">Cancel</MudButton>
    }
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@(_isNew ? Icons.Material.Filled.Add : Icons.Material.Filled.Save)"
               OnClick="Save" Disabled="@(_c is null || _saving)">
        @(_isNew ? "Create Company" : "Save")
    </MudButton>
</MudStack>

@if (_isNew)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
        Work through the tabs — <b>General</b> and <b>Financial</b> are the minimum needed. The company
        starts with empty books, so add its chart of accounts and fiscal periods before posting.
    </MudAlert>
}

@if (_c is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Elevation="1">
        <MudTabs Elevation="0" ApplyEffectsToContainer="true" PanelClass="pa-5" Border="true">

            @* ── 1. General ── *@
            <MudTabPanel Text="General">
                <MudGrid>
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="_c.LegalName" Label="Company Name (Legal)" Required="true" /></MudItem>
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="_c.TradeName" Label="Trade Name" /></MudItem>
                    <MudItem xs="12" sm="4">
                        @if (_isNew)
                        {
                            <MudTextField @bind-Value="_c.CompanyCode" Label="Company Code" Required="true"
                                          HelperText="Short unique code, e.g. MERID" />
                        }
                        else
                        {
                            <MudTextField Value="_c.CompanyCode" Label="Company Code" ReadOnly="true" HelperText="Fixed once created" />
                        }
                    </MudItem>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_c.LicenseNumber" Label="License Number" Required="true" /></MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="_c.LicenseType" Label="License Type">
                            <MudSelectItem Value="@("LLC")">LLC</MudSelectItem>
                            <MudSelectItem Value="@("FZE")">FZE</MudSelectItem>
                            <MudSelectItem Value="@("Sole Establishment")">Sole Establishment</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">@DateField("Registration Date", () => _c.RegistrationDate, v => _c.RegistrationDate = v)</MudItem>
                    <MudItem xs="12" sm="4">@DateField("License Expiry Date", () => _c.LicenseExpiryDate, v => _c.LicenseExpiryDate = v)</MudItem>
                    <MudItem xs="12" sm="4">@CountrySelect("Country", () => _c.Country, SetCountry)</MudItem>
                    @if (IsUae(_c.Country))
                    {
                        <MudItem xs="12" sm="4">@EmirateSelect("Emirate", () => _c.Emirate, v => _c.Emirate = v)</MudItem>
                    }
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_c.PlaceOfIncorporation" Label="Place of Incorporation" /></MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_c.IsFreeZone" Label="Free Zone Entity" Color="Color.Primary" /></MudItem>
                    @if (_c.IsFreeZone)
                    {
                        <MudItem xs="12" sm="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_c.IsDesignatedZone" Label="Designated Zone" Color="Color.Primary" /></MudItem>
                    }
                </MudGrid>
            </MudTabPanel>

            @* ── 2. Financial ── *@
            <MudTabPanel Text="Financial">
                <MudGrid>
                    <MudItem xs="12" sm="4">@DateField("Financial Year Start", () => _c.FinancialYearStart, SetFyStart)</MudItem>
                    <MudItem xs="12" sm="4">@DateField("Financial Year End (auto)", () => _c.FinancialYearEnd, v => _c.FinancialYearEnd = v)</MudItem>
                    <MudItem xs="12" sm="4">@DateField("Books Start Date", () => _c.BooksStartDate, v => _c.BooksStartDate = v)</MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="_c.AccountingMethod" Label="Accounting Method">
                            <MudSelectItem Value="@("Accrual")">Accrual</MudSelectItem>
                            <MudSelectItem Value="@("Cash")">Cash</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="_c.FiscalYear" Label="Fiscal Year">
                            <MudSelectItem Value="@("Jan–Dec")">Jan–Dec</MudSelectItem>
                            <MudSelectItem Value="@("Apr–Mar")">Apr–Mar</MudSelectItem>
                            <MudSelectItem Value="@("Jul–Jun")">Jul–Jun</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">@CurrencySelect("Base Currency", () => _c.BaseCurrency, v => _c.BaseCurrency = v ?? "AED")</MudItem>
                    <MudItem xs="12" sm="4">@CurrencySelect("Reporting Currency", () => _c.ReportingCurrency, v => _c.ReportingCurrency = v)</MudItem>
                </MudGrid>
            </MudTabPanel>

            @* ── 3. Localization ── *@
            <MudTabPanel Text="Localization">
                <MudGrid>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_c.OrganizationLanguage" Label="Organization Language" /></MudItem>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_c.CommunicationLanguage" Label="Communication Language" HelperText="Comma-separated" /></MudItem>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_c.InvoiceLanguage" Label="Invoice Language" /></MudItem>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_c.TimeZone" Label="Time Zone" /></MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="_c.DateFormat" Label="Date Format">
                            <MudSelectItem Value="@("dd/MM/yyyy")">dd/MM/yyyy</MudSelectItem>
                            <MudSelectItem Value="@("MM/dd/yyyy")">MM/dd/yyyy</MudSelectItem>
                            <MudSelectItem Value="@("yyyy-MM-dd")">yyyy-MM-dd</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            @* ── 4. Address ── *@
            <MudTabPanel Text="Address">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Registered Address</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="_c.AddressLine1" Label="Address Line 1" /></MudItem>
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="_c.AddressLine2" Label="Address Line 2" /></MudItem>
                    <MudItem xs="12" sm="3"><MudTextField @bind-Value="_c.City" Label="City" /></MudItem>
                    @if (IsUae(_c.AddressCountry))
                    {
                        <MudItem xs="12" sm="3">@EmirateSelect("Emirate", () => _c.AddressEmirate, v => _c.AddressEmirate = v)</MudItem>
                    }
                    <MudItem xs="12" sm="2"><MudTextField @bind-Value="_c.POBox" Label="PO Box" /></MudItem>
                    <MudItem xs="12" sm="4">@CountrySelect("Country", () => _c.AddressCountry, SetAddressCountry)</MudItem>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_c.Phone" Label="Phone Number" /></MudItem>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_c.Fax" Label="Fax Number" /></MudItem>
                </MudGrid>
                <MudDivider Class="my-4" />
                <MudSwitch T="bool" @bind-Value="_c.BillingSameAsRegistered" Label="Billing address same as registered" Color="Color.Primary" />
                @if (!_c.BillingSameAsRegistered)
                {
                    <MudGrid Class="mt-1">
                        <MudItem xs="12" sm="6"><MudTextField @bind-Value="_c.BillingAddressLine1" Label="Billing Address Line 1" /></MudItem>
                        <MudItem xs="12" sm="6"><MudTextField @bind-Value="_c.BillingAddressLine2" Label="Billing Address Line 2" /></MudItem>
                        <MudItem xs="12" sm="3"><MudTextField @bind-Value="_c.BillingCity" Label="City" /></MudItem>
                        @if (IsUae(_c.BillingCountry))
                        {
                            <MudItem xs="12" sm="3">@EmirateSelect("Emirate", () => _c.BillingEmirate, v => _c.BillingEmirate = v)</MudItem>
                        }
                        <MudItem xs="12" sm="2"><MudTextField @bind-Value="_c.BillingPOBox" Label="PO Box" /></MudItem>
                        <MudItem xs="12" sm="4">@CountrySelect("Country", () => _c.BillingCountry, SetBillingCountry)</MudItem>
                    </MudGrid>
                }
            </MudTabPanel>

            @* ── 5. VAT ── *@
            <MudTabPanel Text="VAT">
                <MudGrid>
                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_c.VatRegistered" Label="VAT Registered" Color="Color.Primary" /></MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="_c.TrnLabel" Label="TRN Label">
                            <MudSelectItem Value="@("TRN")">TRN</MudSelectItem>
                            <MudSelectItem Value="@("GST")">GST</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_c.TrnNumber" Label="@($"{_c.TrnLabel} Number")" HelperText="15 digits" Validation="@(new Func<string, string?>(ValidateTrn))" /></MudItem>
                    <MudItem xs="12" sm="4">@DateField("VAT Registration Date", () => _c.VatRegistrationDate, v => _c.VatRegistrationDate = v)</MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="_c.VatScheme" Label="VAT Scheme">
                            <MudSelectItem Value="@("Standard")">Standard</MudSelectItem>
                            <MudSelectItem Value="@("Cash")">Cash</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="_c.VatFilingFrequency" Label="VAT Filing Frequency">
                            <MudSelectItem Value="@("Monthly")">Monthly</MudSelectItem>
                            <MudSelectItem Value="@("Quarterly")">Quarterly</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">@DateField("VAT Deregistration Date", () => _c.VatDeregistrationDate, v => _c.VatDeregistrationDate = v)</MudItem>
                </MudGrid>
            </MudTabPanel>

            @* ── 6. Corporate Tax ── *@
            <MudTabPanel Text="Corporate Tax">
                <MudGrid>
                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_c.CtRegistered" Label="CT Registered" Color="Color.Primary" /></MudItem>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_c.CtTrn" Label="Corporate Tax TRN" /></MudItem>
                    <MudItem xs="12" sm="4">@DateField("First Tax Period Start", () => _c.FirstTaxPeriodStart, v => _c.FirstTaxPeriodStart = v)</MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_c.FreeZonePerson" Label="Free Zone Person" Color="Color.Primary" /></MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_c.QfzpStatus" Label="QFZP Status" Color="Color.Primary" /></MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_c.SmallBusinessRelief" Label="Small Business Relief" Color="Color.Primary" /></MudItem>
                </MudGrid>
            </MudTabPanel>

            @* ── 7. Tax Configuration ── *@
            <MudTabPanel Text="Tax Config">
                <MudGrid>
                    <MudItem xs="12" sm="4"><MudNumericField T="decimal" @bind-Value="_c.DefaultVatRate" Label="Default VAT Rate" Adornment="Adornment.End" AdornmentText="%" HideSpinButtons="true" /></MudItem>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_c.InputVatAccountCode" Label="Input VAT GL Account" HelperText="Account code, e.g. 13010" /></MudItem>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_c.OutputVatAccountCode" Label="Output VAT GL Account" HelperText="Account code, e.g. 22010" /></MudItem>
                </MudGrid>
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4">Tax rate table and tax groups map to the Chart of Accounts — managed there for now.</MudAlert>
            </MudTabPanel>

            @* ── 7b. Invoice Preferences ── *@
            <MudTabPanel Text="Invoice Preferences">
                <MudGrid>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_c.InvoiceNumberPrefix" Label="Invoice Number Prefix" HelperText="e.g. INV — new invoices are numbered INV-2026-0001" /></MudItem>
                    <MudItem xs="12" sm="4"><MudNumericField T="int" @bind-Value="_c.InvoiceDefaultPaymentTermsDays" Label="Default Payment Terms (Days)" Min="0" HideSpinButtons="true" /></MudItem>
                    <MudItem xs="12"><MudTextField @bind-Value="_c.InvoiceDefaultNotes" Label="Default Notes" Lines="3" HelperText="Pre-filled on every new invoice — still editable per invoice" /></MudItem>
                    <MudItem xs="12"><MudTextField @bind-Value="_c.InvoiceDefaultTermsAndConditions" Label="Default Terms &amp; Conditions" Lines="3" HelperText="Pre-filled into the Terms &amp; Conditions box on every new invoice — still editable per invoice" /></MudItem>
                </MudGrid>
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">Automated Payment Reminders</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                    The background service sends a reminder email automatically on these days, in addition to "Send Reminder Now" on any invoice.
                </MudText>
                <MudGrid>
                    <MudItem xs="12" sm="4"><MudNumericField T="int" @bind-Value="_c.ReminderDaysBeforeDue" Label="Days Before Due" Min="0" HideSpinButtons="true" HelperText="0 = don't remind before due" /></MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_c.ReminderOnDueDate" Label="Remind on Due Date" Color="Color.Primary" /></MudItem>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_c.ReminderDaysAfterDue" Label="Days After Due" Placeholder="e.g. 7,15,30" HelperText="Comma-separated" /></MudItem>
                </MudGrid>
            </MudTabPanel>

            @* ── 8. System Controls ── *@
            <MudTabPanel Text="System">
                <MudGrid>
                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_c.MultiCompanyEnabled" Label="Multi-Company" Color="Color.Primary" /></MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_c.AuditTrailEnabled" Label="Audit Trail" Color="Color.Primary" /></MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_c.ApprovalWorkflowEnabled" Label="Approval Workflow" Color="Color.Primary" /></MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_c.SalespersonEnabled" Label="Salesperson on Customers" Color="Color.Primary" /></MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_c.RevenueRecognitionEnabled" Label="Revenue Recognition on Invoices" Color="Color.Primary" /></MudItem>
                </MudGrid>
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4">Document number series and posting groups are configured per the Chart of Accounts and voucher prefixes.</MudAlert>

                @if (_c.SalespersonEnabled)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Salespersons</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                        Names offered on the New Customer form's Salesperson dropdown.
                    </MudText>
                    <MudStack Spacing="2">
                        @foreach (var sp in _c.Salespersons)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudTextField @bind-Value="sp.Name" Placeholder="Salesperson name" Margin="Margin.Dense" Class="flex-grow-1" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => _c.Salespersons.Remove(sp))" />
                            </MudStack>
                        }
                    </MudStack>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="mt-2" StartIcon="@Icons.Material.Filled.Add" OnClick="AddSalesperson">Add Salesperson</MudButton>
                }
            </MudTabPanel>

            @* ── 9. Bank Accounts ── *@
            <MudTabPanel Text="Bank Accounts">
                <div class="d-flex justify-end mb-2">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddBank">Add Bank</MudButton>
                </div>
                <MudSimpleTable Dense="true" Bordered="true" Striped="true" Style="overflow-x:auto">
                    <thead>
                        <tr><th>Bank Name</th><th>Account Name</th><th>Account Number</th><th>IBAN</th><th>SWIFT</th><th>Cur.</th><th>Primary</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var bank in _c.BankAccounts)
                        {
                            <tr>
                                <td><MudTextField @bind-Value="bank.BankName" Margin="Margin.Dense" /></td>
                                <td><MudTextField @bind-Value="bank.AccountName" Margin="Margin.Dense" /></td>
                                <td><MudTextField @bind-Value="bank.AccountNumber" Margin="Margin.Dense" /></td>
                                <td><MudTextField @bind-Value="bank.Iban" Margin="Margin.Dense" /></td>
                                <td><MudTextField @bind-Value="bank.Swift" Margin="Margin.Dense" Style="width:90px" /></td>
                                <td><MudTextField @bind-Value="bank.Currency" Margin="Margin.Dense" Style="width:64px" /></td>
                                <td><MudSwitch T="bool" @bind-Value="bank.IsPrimary" Color="Color.Primary" /></td>
                                <td><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => _c.BankAccounts.Remove(bank))" /></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudTabPanel>

            @* ── 10. Documents (UAE) ── *@
            <MudTabPanel Text="Documents">
                @if (_isNew)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">Save the company first — then come back here to upload its documents.</MudAlert>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                        Required UAE documents. Up to @(CompanyService.MaxDocumentBytes / (1024 * 1024)) MB per file.
                    </MudText>
                    <MudList T="string" Dense="true">
                        @foreach (var docType in RequiredDocs)
                        {
                            var uploaded = _documents.FirstOrDefault(d => d.DocType == docType);
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Description">
                                <div class="d-flex align-center" style="width:100%">
                                    <div>
                                        <span>@docType</span>
                                        @if (uploaded is not null)
                                        {
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                                @uploaded.FileName (@((uploaded.SizeBytes / 1024.0).ToString("N0")) KB) · uploaded @uploaded.UploadedAtUtc.ToLocalTime().ToString("dd MMM yyyy")
                                            </MudText>
                                        }
                                    </div>
                                    <MudSpacer />
                                    @if (uploaded is not null)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" OnClick="@(() => DownloadDocument(uploaded))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveDocument(uploaded))" />
                                    }
                                    <MudFileUpload T="IBrowserFile" FilesChanged="@(f => OnDocumentSelected(docType, f))" Accept=".pdf,.jpg,.jpeg,.png,.doc,.docx">
                                        <ActivatorContent>
                                            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Upload">
                                                @(uploaded is null ? "Upload" : "Replace")
                                            </MudButton>
                                        </ActivatorContent>
                                    </MudFileUpload>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
}

@code {
    private CompanySetup? _c;

    private static readonly string[] Emirates =
        { "Abu Dhabi", "Dubai", "Sharjah", "Ajman", "Umm Al Quwain", "Ras Al Khaimah", "Fujairah" };
    private static readonly string[] RequiredDocs =
        { "Trade License Copy", "Memorandum of Association (MOA)", "VAT Certificate", "Emirates ID", "Passport Copy", "Other Supporting Documents" };

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private bool _isNew;
    private bool _saving;
    private string _userName = "System Admin";
    private List<CompanySetupDocumentInfo> _documents = new();

    protected override async Task OnInitializedAsync()
    {
        _isNew = Navigation.Uri.EndsWith("/new", StringComparison.OrdinalIgnoreCase);
        await Session.EnsureInitialisedAsync();
        if (AuthState is not null) _userName = (await AuthState).User.Identity?.Name ?? "System Admin";

        if (_isNew && !Session.IsFirmAdmin)
        {
            Snackbar.Add("Only a firm administrator can create companies.", Severity.Error);
            Navigation.NavigateTo("");
            return;
        }
        if (!_isNew && !Session.CanAdminister)
        {
            Snackbar.Add("Only an Admin can edit this company's setup.", Severity.Error);
            Navigation.NavigateTo("");
            return;
        }

        _c = _isNew ? BlankCompany() : await Company.GetAsync();
        if (!_isNew) _documents = await Company.GetDocumentsAsync(_c.Id);
    }

    private async Task OnDocumentSelected(string docType, IBrowserFile file)
    {
        if (file.Size > CompanyService.MaxDocumentBytes)
        {
            Snackbar.Add($"That file is too large — the limit is {CompanyService.MaxDocumentBytes / (1024 * 1024)} MB.", Severity.Error);
            return;
        }

        using var stream = file.OpenReadStream(CompanyService.MaxDocumentBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        try
        {
            await Company.UploadDocumentAsync(_c!.Id, docType, file.Name, file.ContentType, ms.ToArray(), DateTime.UtcNow);
            _documents = await Company.GetDocumentsAsync(_c.Id);
        }
        catch (PostingException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DownloadDocument(CompanySetupDocumentInfo doc)
    {
        var full = await Company.GetDocumentAsync(_c!.Id, doc.Id);
        if (full is null) return;
        var base64 = Convert.ToBase64String(full.Value.Data);
        await JS.InvokeVoidAsync("downloadFileFromBytes", full.Value.FileName, full.Value.ContentType, base64);
    }

    private async Task RemoveDocument(CompanySetupDocumentInfo doc)
    {
        await Company.RemoveDocumentAsync(_c!.Id, doc.Id);
        _documents = await Company.GetDocumentsAsync(_c.Id);
    }

    /// <summary>Sensible starting point for a brand-new company; the user completes it in the tabs.</summary>
    private static CompanySetup BlankCompany()
    {
        var yearStart = new DateOnly(DateTime.Today.Year, 1, 1);
        return new CompanySetup
        {
            Country = "United Arab Emirates",
            AddressCountry = "United Arab Emirates",
            AccountingMethod = "Accrual",
            FiscalYear = "Jan–Dec",
            BaseCurrency = "AED",
            ReportingCurrency = "AED",
            OrganizationLanguage = "English",
            InvoiceLanguage = "English",
            TimeZone = "Asia/Dubai",
            DateFormat = "dd/MM/yyyy",
            TrnLabel = "TRN",
            FinancialYearStart = yearStart,
            FinancialYearEnd = yearStart.AddYears(1).AddDays(-1),
            BooksStartDate = yearStart,
            DefaultVatRate = 5m,
            InputVatAccountCode = "13010",
            OutputVatAccountCode = "22010",
            BillingSameAsRegistered = true,
            MultiCompanyEnabled = true,
            AuditTrailEnabled = true,
        };
    }

    private void SetFyStart(DateOnly? v)
    {
        _c!.FinancialYearStart = v;
        if (v is DateOnly d) _c.FinancialYearEnd = d.AddYears(1).AddDays(-1); // auto
    }

    private void AddBank() => _c!.BankAccounts.Add(new CompanyBankAccount { Currency = "AED" });

    private void AddSalesperson() => _c!.Salespersons.Add(new Salesperson());

    private string? ValidateTrn(string trn) =>
        string.IsNullOrWhiteSpace(trn) || (trn.Length == 15 && trn.All(char.IsDigit)) ? null : "TRN must be 15 digits";

    private async Task Save()
    {
        _saving = true;
        try
        {
            if (_isNew)
            {
                var created = await Company.CreateAsync(_c!);
                await Session.RefreshAsync();
                Session.SwitchTo(created.Id);   // drop the user straight into the new company
                Snackbar.Add($"Company {created.CompanyCode} created. New users have no access to it until " +
                    "you grant them a role below.", Severity.Success);
                // Carries straight into Companies with this one pre-selected and its access panel
                // open, since granting access is the very next thing a FirmAdmin needs to do after
                // creating a company — nobody else can see or work in it until they do.
                Navigation.NavigateTo($"companies?newCompanyId={created.Id}");
                return;
            }

            await Company.SaveAsync(_c!, _userName);
            Snackbar.Add("Company setup saved.", Severity.Success);
        }
        catch (PostingException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Could not save: " + ex.Message, Severity.Error);
        }
        finally { _saving = false; }
    }

    // ── field helpers ──
    private RenderFragment DateField(string label, Func<DateOnly?> get, Action<DateOnly?> set) => __builder =>
    {
        <MudDatePicker Label="@label"
                       Date="@(get()?.ToDateTime(TimeOnly.MinValue))"
                       DateChanged="@(d => set(d.HasValue ? DateOnly.FromDateTime(d.Value) : null))" />
    };

    private RenderFragment EmirateSelect(string label, Func<string?> get, Action<string?> set) => __builder =>
    {
        <MudSelect T="string" Label="@label" Value="get()" ValueChanged="set" Clearable="true">
            @foreach (var em in Emirates)
            {
                <MudSelectItem Value="em">@em</MudSelectItem>
            }
        </MudSelect>
    };

    // Autocomplete rather than a plain dropdown — 190+ countries is too long a list to scroll.
    private RenderFragment CountrySelect(string label, Func<string?> get, Action<string?> set) => __builder =>
    {
        <MudAutocomplete T="string" Label="@label" Value="get()" ValueChanged="set"
                         SearchFunc="SearchCountries" ToStringFunc="@(c => c ?? "")"
                         Clearable="true" ResetValueOnEmptyText="true" CoerceText="false" />
    };

    private static Task<IEnumerable<string>> SearchCountries(string? value, CancellationToken ct)
    {
        var q = value?.Trim() ?? "";
        var matches = string.IsNullOrEmpty(q)
            ? Countries.All
            : Countries.All.Where(c => c.Contains(q, StringComparison.OrdinalIgnoreCase)).ToArray();
        return Task.FromResult<IEnumerable<string>>(matches);
    }

    // Emirates only make sense for a UAE address, so the Emirate field is hidden — and cleared —
    // for any other country. "UAE" also matches records saved before the country list existed.
    private static bool IsUae(string? country) => country is "United Arab Emirates" or "UAE";

    private void SetCountry(string? v) { _c!.Country = v; if (!IsUae(v)) _c.Emirate = null; }
    private void SetAddressCountry(string? v) { _c!.AddressCountry = v; if (!IsUae(v)) _c.AddressEmirate = null; }
    private void SetBillingCountry(string? v) { _c!.BillingCountry = v; if (!IsUae(v)) _c.BillingEmirate = null; }

    private RenderFragment CurrencySelect(string label, Func<string?> get, Action<string?> set) => __builder =>
    {
        <MudSelect T="string" Label="@label" Value="get()" ValueChanged="set">
            <MudSelectItem Value="@("AED")">AED — UAE Dirham</MudSelectItem>
            <MudSelectItem Value="@("USD")">USD — US Dollar</MudSelectItem>
            <MudSelectItem Value="@("EUR")">EUR — Euro</MudSelectItem>
            <MudSelectItem Value="@("GBP")">GBP — British Pound</MudSelectItem>
        </MudSelect>
    };
}
