@page "/receipt-voucher"
@page "/receipt-voucher/{Id:int?}"
@attribute [Authorize(Roles = AppRoles.Posters)]
@using AegisErp.Web.Components.Dialogs
@inject ReceiptService ReceiptSvc
@inject CustomerService CustomerSvc
@inject SalesInvoiceService InvoiceSvc
@inject ChartOfAccountsService Coa
@inject LedgerService Ledger
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Receipt Voucher · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">Receipt Voucher</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenNew(null, null))">
        New Receipt
    </MudButton>
</MudStack>

<MudText Typo="Typo.subtitle1" Class="mb-2">Receipts</MudText>
<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="receipt-list-pane" Elevation="1">
            @if (_recent is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_recent.Count == 0)
            {
                <MudText Class="pa-4 mud-text-secondary">No receipts yet.</MudText>
            }
            else
            {
                @foreach (var r in _recent)
                {
                    <div class="receipt-row @(r.Id == _selectedId ? "selected" : "")" @onclick="@(() => SelectRow(r))">
                        <div class="receipt-row-top">
                            <span class="receipt-row-name">@r.Customer.Name</span>
                            <span class="receipt-row-amount">@r.Amount.ToString("N2")</span>
                        </div>
                        <div class="receipt-row-meta">@r.ReceiptNo · @r.Date.ToString("dd MMM yyyy")</div>
                        <div class="receipt-row-status">
                            <MudChip T="string" Size="Size.Small" Color="StatusColor(r.Status)" Variant="Variant.Text">@r.Status</MudChip>
                        </div>
                    </div>
                }
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="8">
        @if (_selectedId is int id)
        {
            <ReceiptDetailPanel @key="id" ReceiptId="id" OnChanged="RefreshList" />
        }
        else
        {
            <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" Elevation="1" Style="min-height:300px">
                <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Large" Class="mud-text-secondary mb-2" />
                <MudText Class="mud-text-secondary">Select a receipt on the left to view its details.</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

<style>
    .receipt-list-pane { max-height: calc(100vh - 220px); overflow-y: auto; }
    .receipt-row { padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-lines-default); cursor: pointer; }
    .receipt-row:hover { background: var(--mud-palette-action-default-hover); }
    .receipt-row.selected { background: var(--mud-palette-primary-hover); border-left: 3px solid var(--mud-palette-primary); }
    .receipt-row-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .receipt-row-name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .receipt-row-amount { font-weight: 600; white-space: nowrap; }
    .receipt-row-meta { font-size: 12px; color: var(--mud-palette-text-secondary); margin-top: 2px; }
    .receipt-row-status { margin-top: 4px; }
</style>

@code {
    private List<CustomerReceipt>? _recent;
    private int? _selectedId;

    [Parameter] public int? Id { get; set; }

    [SupplyParameterFromQuery(Name = "customerId")]
    [Parameter]
    public int? QueryCustomerId { get; set; }

    [SupplyParameterFromQuery(Name = "invoiceId")]
    [Parameter]
    public int? QueryInvoiceId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _recent = await ReceiptSvc.GetRecentAsync(50);
        if (_selectedId is null && _recent.Count > 0) _selectedId = Id ?? _recent[0].Id;

        // Arriving via a Sales Invoice detail page's "Record Payment" action
        // (?customerId=...&invoiceId=...) opens the dialog pre-filled instead of waiting for the
        // "New Receipt" button.
        if (QueryCustomerId is int custId) await OpenNew(custId, QueryInvoiceId);
    }

    protected override void OnParametersSet()
    {
        if (Id is int id) _selectedId = id;
        else if (_selectedId is null && _recent is { Count: > 0 }) _selectedId = _recent[0].Id;
    }

    private void SelectRow(CustomerReceipt r)
    {
        _selectedId = r.Id;
        Nav.NavigateTo($"/receipt-voucher/{r.Id}");
    }

    private async Task RefreshList() => _recent = await ReceiptSvc.GetRecentAsync(50);

    private static Color StatusColor(VoucherStatus status) => status switch
    {
        VoucherStatus.Draft => Color.Default,
        VoucherStatus.Posted => Color.Success,
        VoucherStatus.Void => Color.Dark,
        _ => Color.Default,
    };

    private async Task OpenNew(int? customerId, int? invoiceId)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var parameters = new DialogParameters<NewReceiptDialog> { { x => x.CustomerId, customerId }, { x => x.InvoiceId, invoiceId } };
        var dialog = await DialogService.ShowAsync<NewReceiptDialog>("New Receipt Voucher", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await RefreshList();
            if (result.Data is int newId)
            {
                _selectedId = newId;
                Nav.NavigateTo($"/receipt-voucher/{newId}");
            }
        }
    }
}
