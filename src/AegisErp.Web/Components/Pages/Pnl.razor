@page "/pnl"
@attribute [Authorize]
@inject LedgerService Ledger

<PageTitle>P&amp;L Statement · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h5">Profit &amp; Loss Statement</MudText>
    <MudSpacer />
    @if (_periods is not null)
    {
        <MudSelect T="int" Value="_periodId" ValueChanged="OnPeriodChanged" Label="Period" Dense="true" Style="max-width:220px">
            @foreach (var p in _periods)
            {
                <MudSelectItem Value="p.Id">@p.Name</MudSelectItem>
            }
        </MudSelect>
    }
    <div style="max-width:160px">
        <MudDatePicker @bind-Date="_fromDate" Label="From" Margin="Margin.Dense" PickerVariant="PickerVariant.Dialog" />
    </div>
    <div style="max-width:160px">
        <MudDatePicker @bind-Date="_toDate" Label="To" Margin="Margin.Dense" PickerVariant="PickerVariant.Dialog" />
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="Load">Run</MudButton>
</MudStack>

@if (_pnl is not null)
{
    <MudPaper Elevation="1">
        <MudTable Items="_pnl.Income" Dense="true" Bordered="false" Elevation="0">
            <HeaderContent>
                <MudTh>Income</MudTh>
                <MudTh Style="text-align:right">This Period</MudTh>
                <MudTh Style="text-align:right">YTD</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><AccountLink AccountId="context.AccountId"><span style="font-family:monospace;color:var(--mud-palette-text-secondary)">@context.Code</span> @context.Name</AccountLink></MudTd>
                <MudTd Style="text-align:right" Class="mud-success-text">@context.Period.ToString("N2")</MudTd>
                <MudTd Style="text-align:right" Class="mud-success-text">@context.Ytd.ToString("N2")</MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTh><b>Total Income</b></MudTh>
                <MudTh Style="text-align:right"><b>@_pnl.IncomePeriod.ToString("N2")</b></MudTh>
                <MudTh Style="text-align:right"><b>@_pnl.IncomeYtd.ToString("N2")</b></MudTh>
            </FooterContent>
        </MudTable>

        <MudDivider />

        <MudTable Items="_pnl.Expenses" Dense="true" Bordered="false" Elevation="0" Class="mt-2">
            <HeaderContent>
                <MudTh>Expenses</MudTh>
                <MudTh Style="text-align:right">This Period</MudTh>
                <MudTh Style="text-align:right">YTD</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><AccountLink AccountId="context.AccountId"><span style="font-family:monospace;color:var(--mud-palette-text-secondary)">@context.Code</span> @context.Name</AccountLink></MudTd>
                <MudTd Style="text-align:right" Class="mud-error-text">@context.Period.ToString("N2")</MudTd>
                <MudTd Style="text-align:right" Class="mud-error-text">@context.Ytd.ToString("N2")</MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTh><b>Total Expenses</b></MudTh>
                <MudTh Style="text-align:right"><b>@_pnl.ExpensePeriod.ToString("N2")</b></MudTh>
                <MudTh Style="text-align:right"><b>@_pnl.ExpenseYtd.ToString("N2")</b></MudTh>
            </FooterContent>
        </MudTable>

        <div class="pnl-net">
            <div>
                <div class="lbl">Net Profit (Period)</div>
                <div class="val @(_pnl.NetPeriod >= 0 ? "pos" : "neg")">AED @_pnl.NetPeriod.ToString("N2")</div>
            </div>
            <div>
                <div class="lbl">Net Profit (YTD)</div>
                <div class="val @(_pnl.NetYtd >= 0 ? "pos" : "neg")">AED @_pnl.NetYtd.ToString("N2")</div>
            </div>
        </div>
    </MudPaper>
}

@code {
    private List<FiscalPeriod>? _periods;
    private int _periodId;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private ProfitAndLoss? _pnl;

    protected override async Task OnInitializedAsync()
    {
        _periods = await Ledger.GetPeriodsAsync();
        var defaultPeriod = await Ledger.GetDefaultPeriodAsync(DateOnly.FromDateTime(DateTime.Today))
                             ?? _periods.LastOrDefault();
        _periodId = defaultPeriod?.Id ?? 0;
        _fromDate = defaultPeriod?.StartDate.ToDateTime(TimeOnly.MinValue);
        _toDate = defaultPeriod?.EndDate.ToDateTime(TimeOnly.MinValue);
        await Load();
    }

    /// <summary>Picking a period is a quick-select convenience: it just sets the From/To range,
    /// which is what actually drives the report — so it can still be overridden freely afterwards.</summary>
    private async Task OnPeriodChanged(int id)
    {
        _periodId = id;
        var period = _periods?.FirstOrDefault(p => p.Id == id);
        if (period is not null)
        {
            _fromDate = period.StartDate.ToDateTime(TimeOnly.MinValue);
            _toDate = period.EndDate.ToDateTime(TimeOnly.MinValue);
        }
        await Load();
    }

    private async Task Load()
    {
        if (_fromDate is not { } from || _toDate is not { } to) return;
        _pnl = await Ledger.GetProfitAndLossAsync(DateOnly.FromDateTime(from), DateOnly.FromDateTime(to));
    }
}

<style>
    .pnl-net { display:flex; gap:32px; flex-wrap:wrap; padding:16px; background:var(--mud-palette-background-grey); border-top:1px solid var(--mud-palette-lines-default); }
    .pnl-net .lbl { font-size:12px; color:var(--mud-palette-text-secondary); text-transform:uppercase; letter-spacing:.04em; }
    .pnl-net .val { font-size:20px; font-weight:700; }
    .pnl-net .val.pos { color:var(--mud-palette-success); }
    .pnl-net .val.neg { color:var(--mud-palette-error); }
</style>
