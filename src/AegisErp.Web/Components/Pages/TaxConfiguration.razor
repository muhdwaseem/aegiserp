@page "/tax-configuration"
@attribute [Authorize(Roles = AppRoles.Admins)]
@inject TaxCodeService TaxCodeSvc
@inject ChartOfAccountsService Coa
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Tax Configuration · Aegis ERP</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Tax Configuration</MudText>

<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudText Typo="Typo.subtitle2" Class="mb-2">New Tax Code</MudText>
    <MudGrid>
        <MudItem xs="12" sm="6" md="2">
            <MudTextField @bind-Value="_code" Label="Tax Code" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_description" Label="Description" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudNumericField @bind-Value="_rate" Label="Rate %" Format="N2" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="TaxCodeKind" @bind-Value="_kind" Label="Type" Dense="true">
                @foreach (var k in Enum.GetValues<TaxCodeKind>())
                {
                    <MudSelectItem Value="k">@KindLabel(k)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="int?" @bind-Value="_glAccountId" Label="GL Account" Dense="true" Clearable="true">
                <MudSelectItem T="int?" Value="@((int?)null)">— None —</MudSelectItem>
                @if (_accounts is not null)
                {
                    @foreach (var a in _accounts)
                    {
                        <MudSelectItem T="int?" Value="@((int?)a.Id)">@a.Code — @a.Name</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="1" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="Add">Add</MudButton>
        </MudItem>
    </MudGrid>
    <div class="mt-3" style="max-width:200px">
        <MudDatePicker @bind-Date="_effectiveFrom" Label="Effective From" Margin="Margin.Dense" PickerVariant="PickerVariant.Dialog" />
    </div>
</MudPaper>

<MudTable Items="_taxCodes" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="_taxCodes is null">
    <HeaderContent>
        <MudTh>Tax Code</MudTh>
        <MudTh>Description</MudTh>
        <MudTh Style="text-align:right">Rate</MudTh>
        <MudTh>GL Account</MudTh>
        <MudTh>Type</MudTh>
        <MudTh>Effective From</MudTh>
        <MudTh>Status</MudTh>
        <MudTh Style="width:60px"></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd Style="font-family:monospace"><b>@context.Code</b></MudTd>
        <MudTd>@context.Description</MudTd>
        <MudTd Style="text-align:right">@context.Rate.ToString("N2")%</MudTd>
        <MudTd>
            @if (context.GlAccount is not null)
            {
                <AccountLink AccountId="context.GlAccount.Id">@context.GlAccount.Code — @context.GlAccount.Name</AccountLink>
            }
            else
            {
                <text>—</text>
            }
        </MudTd>
        <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Text">@KindLabel(context.Kind)</MudChip></MudTd>
        <MudTd>@context.EffectiveFrom.ToString("dd MMM yyyy")</MudTd>
        <MudTd>
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)" Variant="Variant.Text">
                @(context.IsActive ? "Active" : "Inactive")
            </MudChip>
        </MudTd>
        <MudTd>
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small">
                <MudMenuItem OnClick="@(() => Toggle(context))">@(context.IsActive ? "Deactivate" : "Activate")</MudMenuItem>
                <MudMenuItem OnClick="@(() => Delete(context))">Delete</MudMenuItem>
            </MudMenu>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4 mud-text-secondary">No tax codes yet.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<TaxCode>? _taxCodes;
    private List<Account>? _accounts;

    private string _code = "";
    private string _description = "";
    private decimal _rate;
    private TaxCodeKind _kind = TaxCodeKind.Output;
    private int? _glAccountId;
    private DateTime? _effectiveFrom = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        _accounts = await Coa.GetAllAsync(postableOnly: true);
        await Load();
    }

    private async Task Load() => _taxCodes = await TaxCodeSvc.GetAllAsync();

    private async Task Add()
    {
        try
        {
            var input = new NewTaxCodeInput(_code, _description, _rate, _kind, _glAccountId,
                DateOnly.FromDateTime(_effectiveFrom ?? DateTime.Today));
            await TaxCodeSvc.AddAsync(input);
            Snackbar.Add($"Tax code {_code.Trim().ToUpperInvariant()} added.", Severity.Success);
            _code = ""; _description = ""; _rate = 0; _kind = TaxCodeKind.Output; _glAccountId = null;
            await Load();
        }
        catch (PostingException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Toggle(TaxCode t)
    {
        await TaxCodeSvc.SetActiveAsync(t.Id, !t.IsActive);
        await Load();
    }

    private async Task Delete(TaxCode t)
    {
        var ok = await DialogService.ShowMessageBox("Delete tax code", $"Delete {t.Code} — {t.Description}?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        try
        {
            await TaxCodeSvc.DeleteAsync(t.Id);
            await Load();
        }
        catch (PostingException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private static string KindLabel(TaxCodeKind k) => k switch
    {
        TaxCodeKind.Output => "Output",
        TaxCodeKind.Input => "Input",
        TaxCodeKind.Exempt => "Exempt",
        TaxCodeKind.ReverseCharge => "Reverse Charge",
        _ => k.ToString(),
    };
}
