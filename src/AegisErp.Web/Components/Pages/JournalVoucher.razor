@page "/journal-voucher"
@page "/journal-voucher/{Id:int?}"
@attribute [Authorize]
@using AegisErp.Web.Components.Dialogs
@inject JournalService Journal
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject CompanySession Session

<PageTitle>Journal Voucher · Aegis ERP</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">Journal Voucher</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNew">
        New Voucher
    </MudButton>
</MudStack>

<MudGrid>
    <MudItem xs="12" md="4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.subtitle1">@(_showAllPostings ? "All postings" : "Journal vouchers")</MudText>
            <MudSpacer />
            <MudTooltip Text="@(_showAllPostings ? "Journal vouchers only" : "Show all postings")">
                <MudIconButton Icon="@(_showAllPostings ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                               Size="Size.Small" OnClick="ToggleShowAll" />
            </MudTooltip>
        </MudStack>
        <MudPaper Class="jv-list-pane" Elevation="1">
            @if (_recent is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_recent.Count == 0)
            {
                <MudText Class="pa-4 mud-text-secondary">
                    @(_showAllPostings ? "No postings yet." : "No journal vouchers yet. Invoices, receipts and payments post here too — the eye icon above shows them.")
                </MudText>
            }
            else
            {
                @foreach (var v in _recent)
                {
                    <div class="jv-row @(v.Id == _selectedId ? "selected" : "")" @onclick="@(() => SelectRow(v))">
                        <div class="jv-row-top">
                            <span class="jv-row-name">@v.VoucherNo</span>
                            <span class="jv-row-amount">@v.TotalDebit.ToString("N2")</span>
                        </div>
                        <div class="jv-row-meta">@v.Type · @v.Date.ToString("dd MMM yyyy")@(string.IsNullOrWhiteSpace(v.Narration) ? "" : $" · {v.Narration}")</div>
                    </div>
                }
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="8">
        @if (_selectedId is int id)
        {
            <JournalVoucherDetailPanel @key="id" JournalVoucherId="id" />
        }
        else
        {
            <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" Elevation="1" Style="min-height:300px">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Large" Class="mud-text-secondary mb-2" />
                <MudText Class="mud-text-secondary">Select a voucher on the left to view its details.</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

<style>
    .jv-list-pane { max-height: calc(100vh - 220px); overflow-y: auto; }
    .jv-row { padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-lines-default); cursor: pointer; }
    .jv-row:hover { background: var(--mud-palette-action-default-hover); }
    .jv-row.selected { background: var(--mud-palette-primary-hover); border-left: 3px solid var(--mud-palette-primary); }
    .jv-row-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .jv-row-name { font-weight: 600; font-family: monospace; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .jv-row-amount { font-weight: 600; white-space: nowrap; font-family: monospace; }
    .jv-row-meta { font-size: 12px; color: var(--mud-palette-text-secondary); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>

@code {
    private List<AegisErp.Domain.Entities.JournalVoucher>? _recent;
    private int? _selectedId;
    private bool _showAllPostings;

    [Parameter] public int? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureInitialisedAsync();
        if (!Session.CanPost) { Nav.NavigateTo(""); return; }

        _recent = await Journal.GetRecentAsync(50, VoucherType.Journal);
        if (_selectedId is null && _recent.Count > 0) _selectedId = Id ?? _recent[0].Id;
    }

    protected override void OnParametersSet()
    {
        if (Id is int id) _selectedId = id;
        else if (_selectedId is null && _recent is { Count: > 0 }) _selectedId = _recent[0].Id;
    }

    private void SelectRow(AegisErp.Domain.Entities.JournalVoucher v)
    {
        _selectedId = v.Id;
        Nav.NavigateTo($"/journal-voucher/{v.Id}");
    }

    private async Task ToggleShowAll()
    {
        _showAllPostings = !_showAllPostings;
        _recent = await Journal.GetRecentAsync(50, _showAllPostings ? null : VoucherType.Journal);
    }

    private async Task RefreshList() => _recent = await Journal.GetRecentAsync(50, _showAllPostings ? null : VoucherType.Journal);

    private async Task OpenNew()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<NewJournalVoucherDialog>("New Voucher", options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await RefreshList();
            if (result.Data is int newId)
            {
                _selectedId = newId;
                Nav.NavigateTo($"/journal-voucher/{newId}");
            }
        }
    }
}
